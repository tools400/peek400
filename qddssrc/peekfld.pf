     A          R FPEEKFLD                  TEXT('PEEK - FFD')
      *
     A            FORMAT        10A
     A                                      TEXT('Formatname            -
     A                                                                  ')
     A                                      COLHDG('Formatname          ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A            FIELD         10A
     A                                      TEXT('Feldname              -
     A                                                                  ')
     A                                      COLHDG('Feldname            ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A            FLDSEQ         5S 0
     A                                      TEXT('Feldfolge             -
     A                                                                  ')
     A                                      COLHDG('Feldfolge           ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A            SEQ            5S 0
     A                                      TEXT('Sortierfolge          -
     A                                                                  ')
     A                                      COLHDG('Sortierfolge        ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A            KSEQ           5S 0
     A                                      TEXT('Sortierfolge der Schlü-
     A                                      sselfelder                  ')
     A                                      COLHDG('Sortierfolge        ' -
     A                                             'Schlüsselfelder     ' -
     A                                             '                    ')
      *
     A            DESC           1A
     A                                      TEXT('absteigende Sortierfol-
     A                                      ge                          ')
     A                                      COLHDG('DESCEND             ' -
     A                                             'Schlüsselfolge      ' -
     A                                             '                    ')
      *
     A            HIDDEN         1A
     A                                      TEXT('Feld nicht anzeigen   -
     A                                                                  ')
     A                                      COLHDG('Feld nicht          ' -
     A                                             'anzeigen            ' -
     A                                             '                    ')
      *
     A            COLOR          1A
     A                                      TEXT('Farbattribut          -
     A                                                                  ')
     A                                      COLHDG('Farbattribut        ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A            MARKCOL        1A
     A                                      TEXT('Spaltenmarkierung     -
     A                                                                  ')
     A                                      COLHDG('Spaltenmarkierung   ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A            MAXSIZE        5P 0
     A                                      TEXT('Max. Feldgröße in der -
     A                                      Datensatzliste              ')
     A                                      COLHDG('Max. Feldgröße in   ' -
     A                                             'Datensatzliste      ' -
     A                                             '                    ')
      *
     A            EDTCDE         1A
     A                                      TEXT('abw. EDIT-Code        -
     A                                                                  ')
     A                                      COLHDG('abw.                ' -
     A                                             'EDTIT-Code          ' -
     A                                             '                    ')
      *
     A            UNKNOWN        1A
     A                                      TEXT('Unbekannter Feldtyp   -
     A                                                                  ')
     A                                      COLHDG('Unbekannter         ' -
     A                                             'Feldtyp             ' -
     A                                             '                    ')
      *
     A            ISTRANSC       1A
     A                                      TEXT('Hat einen Transcoder  -
     A                                                                  ')
     A                                      COLHDG('Hat einen           ' -
     A                                             'Transcoder          ' -
     A                                             '                    ')
      *
     A            FFD          640A
     A                                      TEXT('Feldbeschreibung      -
     A                                                                  ')
     A                                      COLHDG('Feldbeschreibung    ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A          K FIELD
      *
