      *                                                               *
      *  Bereich  : PEEK                                              *
      *  Datei    : PEEKFMT      Available record formats             *
      *  Typ      : PF                                                *
      *  Erstellt : 02.10.1997   Raddatz                              *
      *                                                               *
      *===============================================================*
      * >>PRE-COMPILER<<                                              *
      *   >>CRTCMD<< &LI/CRTPEEKOBJ SRCFILE(&SL/&SF) SRCMBR(&SM) +    *
      *                           OBJLIB(&LI) DEVLIB(&LI) +           *
      *                           SBMJOB(*NO) BNDDIR(PEEK) +          *
      *                           INSTALL(*NO);                       *
      *   >>CMD<<     DLTF FILE(&LI/&OB);                             *
      *   >>MONMSG<<                                                  *
      *     >>MSGID<<   CPF2105; // Object not found                  *
      *   >>END-MONMSG<<                                              *
      *   >>EXECUTE<<                                                 *
      * >>END-PRE-COMPILER<<                                          *
      *===============================================================*
      *
     A          R FPEEKFMT                  TEXT('PEEK - Formats')
      *
     A            FORMAT        10A
     A                                      TEXT('Formatname            -
     A                                                                  ')
     A                                      COLHDG('Formatname          ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A            SORTSEQ        5S 0
     A                                      TEXT('Sortierfolge          -
     A                                                                  ')
     A                                      COLHDG('Sortierfolge        ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A            FMTNBR         5S 0
     A                                      TEXT('Formatnummer          -
     A                                                                  ')
     A                                      COLHDG('Formatnummer        ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A            FMT          512A
     A                                      TEXT('Beschreibung Satzforma-
     A                                      t                           ')
     A                                      COLHDG('Beschreibung        ' -
     A                                             'Satzformat          ' -
     A                                             '                    ')
      *
     A          K SORTSEQ
      *
