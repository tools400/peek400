     A          R FPEEKFMT                  TEXT('PEEK - Formats')
      *
     A            FORMAT        10A
     A                                      TEXT('Formatname            -
     A                                                                  ')
     A                                      COLHDG('Formatname          ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A            SORTSEQ        5S 0
     A                                      TEXT('Sortierfolge          -
     A                                                                  ')
     A                                      COLHDG('Sortierfolge        ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A            FMTNBR         5S 0
     A                                      TEXT('Formatnummer          -
     A                                                                  ')
     A                                      COLHDG('Formatnummer        ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A            FMT          512A
     A                                      TEXT('Beschreibung Satzforma-
     A                                      t                           ')
     A                                      COLHDG('Beschreibung        ' -
     A                                             'Satzformat          ' -
     A                                             '                    ')
      *
     A          K SORTSEQ
      *
