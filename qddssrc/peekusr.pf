     A                                      UNIQUE
      *
     A          R FPEEKUSR                  TEXT('PEEK - User Settings')
      *
     A            USER          10A
     A                                      TEXT('Benutzer              -
     A                                                                  ')
     A                                      COLHDG('Benutzer            ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A            SECTION       10A
     A                                      TEXT('Bereich               -
     A                                                                  ')
     A                                      COLHDG('Bereich             ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A            KEY           10A
     A                                      TEXT('Schlüssel             -
     A                                                                  ')
     A                                      COLHDG('Schlüssel           ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A            DATA         256A
     A                                      TEXT('Datenbereich          -
     A                                                                  ')
     A                                      COLHDG('Datenbereich        ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A          K USER
     A          K SECTION
     A          K KEY
      *
