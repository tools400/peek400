      *                                                               *
      *===============================================================*
      *                                                               *
      *  Kurzdokumentation :                                          *
      *                                                               *
      *  Peek/400 - Auswahl Satzformat                                *
      *                                                               *
      *===============================================================*
      *  BEZUGSZAHLEN:                                                *
      *                                                               *
      *  80 - SFLDSP, EXSR SFLC, SÄTZE GEF./NICHT GEFUNDEN            *
      *  81 - SFLDSPCTL                                               *
      *  82 - SFLCLR                                                  *
      *  83 - SFLEND                                                  *
      *  84 - SFLNXTCHG                                               *
      *  85 - DSPATR(RI) FÜR SFPAU                                    *
      *  86 - SFLDROP/SFLFOLD                                         *
      *  87 - DSPATR(PC) FÜR AUFSETZKEY                               *
      *  88 - 80/132-ZEICHEN ANZEIGE                                  *
      *  89 - SFLEND, MSGCTL                                          *
      *                                                               *
      *  96 - Feld für Eingabe sperren  VDSP;VDEL                     *
      *  98 - Feld für Eingabe sperren  VCHG                          *
      *                                                               *
      *  91 - Vorwärts blättern                                       *
      *  92 - Rückwärts blättern                                      *
      *                                                               *
      *===============================================================*
      * >>PRE-COMPILER<<                                              *
      *   >>CRTCMD<< &LI/CRTPEEKOBJ SRCFILE(&SL/&SF) SRCMBR(&SM) +    *
      *                           OBJLIB(&LI) DEVLIB(&LI) +           *
      *                           SBMJOB(*NO) BNDDIR(PEEK) +          *
      *                           INSTALL(*NO);                       *
      *   >>EXECUTE<<                                                 *
      * >>END-PRE-COMPILER<<                                          *
      *===============================================================*
      *
      ***                                   DSPSIZ(27 132 *DS4                 -
      ***                                          24 80 *DS3)
      *%%EC
     A                                      DSPSIZ(24 80 *DS3                  -
     A                                             27 132 *DS4)
     A                                      PRINT
     A                                      ALTHELP(CA01)
     A                                      HELP(01)
      *
      *----------------------------------------------------*
     A          R PBSFL                     SFL
      *%%TS  SD  20010225  173150  RADDATZ     REL-V4R4M0  5769-PW1
     A  84                                  SFLNXTCHG
     A            RECORDNBR     10Y 0H
     A            $$RCDL0200   512A  H
     A            FMTNBR         5Y 0H
     A            SFPAU          2A  B  3  2
     A  76                                  DSPATR(PR)
     A N76                                  DSPATR(UL)
     A  85                                  DSPATR(RI)
     A            $$FORMAT      10A  O  3  5COLOR(WHT)
     A                                  4  2' '
     A            $$TEXT        50   O  3 16
      *----------------------------------------------------*
     A          R PBCTL                     SFLCTL(PBSFL)
      *%%TS  SD  20010225  173150  RADDATZ     REL-V4R4M0  5769-PW1
     A  *DS3                                SFLSIZ(0005)
     A  *DS4                                SFLSIZ(0005)
     A  *DS3                                SFLPAG(0004)
     A  *DS4                                SFLPAG(0004)
     A  *DS3                                WINDOW(MSGCTL)
     A  *DS4                                WINDOW(MSGCTL)
     A                                      ROLLUP(91)
     A                                      ROLLDOWN(92)
     A                                      CF01
     A                                      CF02
     A                                      CF03
     A                                      CF04
     A                                      CF05
     A                                      CF06
     A                                      CF07
     A                                      CF08
     A                                      CF09
     A                                      CF10
     A                                      CF12
     A                                      CF13
     A                                      CF14
     A                                      CF15
     A                                      CF16
     A                                      CF17
     A                                      CF18
     A                                      CF19
     A                                      CF20
     A                                      CF21
     A                                      CF22
     A                                      CF23
     A                                      CF24
     A N88                                  DSPMOD(*DS4)
     A                                      OVERLAY
     A                                      SFLCSRRRN(&SFLCSR)
     A                                      SFLMODE(&SFLMDE)
     A  80                                  SFLDSP
     A  81                                  SFLDSPCTL
     A  82                                  SFLCLR
     A  83                                  SFLEND(*MORE)
     A  86                                  SFLDROP(CF11)
     A N86                                  SFLFOLD(CF11)
     A            SFLMDE         1A  H
     A            SFLCSR         5S 0H
     A            SFSANR         4S 0H      SFLRCDNBR(CURSOR)
     A            TXT0126       24A  O  1 23MSGID(TXT 0126 PEEKGER )
     A                                      COLOR(WHT)
     A                                  2  1'                                  -
     A                                                                      '
     A                                      DSPATR(UL)
     A                                      COLOR(BLU)
      *----------------------------------------------------*
     A          R PBBOT#0
      *%%TS  SD  20010225  180538  RADDATZ     REL-V4R4M0  5769-PW1
     A  *DS3                                WINDOW(MSGCTL)
     A  *DS4                                WINDOW(MSGCTL)
     A N88                                  DSPMOD(*DS4)
     A                                      OVERLAY
     A                                 12  1'                                  -
     A                                                                      '
     A                                      DSPATR(UL)
     A                                      COLOR(BLU)
      *
      *----------------------------------------------------*
