 RAD A                                      SFLCSRRRN(&SFLCSR)
 RAD A                                      SFLMODE(&SFLMDE)
 RAD A  80                                  SFLDSP
 RAD A  81                                  SFLDSPCTL
 RAD A  82                                  SFLCLR
 RAD A  83                                  SFLEND(*MORE)
 RAD A  86                                  SFLDROP(CF11)
 RAD A N86                                  SFLFOLD(CF11)
 RAD A            SCNREC        10A  H
 RAD A            SCNFLD        10A  H
 RAD A            SFLMDE         1A  H
 RAD A            SFLCSR         5S 0H
 RAD A            SFSANR         4S 0H      SFLRCDNBR(CURSOR)
 RAD A            TXT0024        8A  O  1  1COLOR(BLU)
 RAD A                                      MSGID(TXT 0024 PEEKGER)
 RAD A            $$CHOICE      29A  O  1 10COLOR(BLU)
 RAD A            TXT0140       38A  O  2  1MSGID(TXT 0140 PEEKGER)
 RAD A                                      COLOR(BLU)
 RAD A                                      DSPATR(UL)
