 ADD A  *DS3                                WINDOW(MSGCTL)
 ADD A  *DS4                                WINDOW(MSGCTL)
 ADD A N88                                  DSPMOD(*DS4)
 ADD A                                      OVERLAY
 ADD A            $$FKEY16      18A  O 19  1COLOR(BLU)
 ADD A            $$FKEY17      18A  O 19 21COLOR(BLU)
