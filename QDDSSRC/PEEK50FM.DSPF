      *  Peek/400 - Erweiterte PIN-Funktion                           *
      *                                                               *
      *===============================================================*
      *  BEZUGSZAHLEN:                                                *
      *                                                               *
      *  80 - SFLDSP, EXSR SFLC, SÄTZE GEF./NICHT GEFUNDEN            *
      *  81 - SFLDSPCTL                                               *
      *  82 - SFLCLR                                                  *
      *  83 - SFLEND                                                  *
      *  84 - SFLNXTCHG                                               *
      *  85 - DSPATR(RI) FÜR SFPAU                                    *
      *  86 - SFLDROP/SFLFOLD                                         *
      *  87 - DSPATR(PC) FÜR AUFSETZKEY                               *
      *  88 - 80/132-ZEICHEN ANZEIGE                                  *
      *  89 - SFLEND, MSGCTL                                          *
      *                                                               *   RADDAT
      *  96 - Feld für Eingabe sperren  VDSP;VDEL                     *
      *  98 - Feld für Eingabe sperren  VCHG                          *
      *                                                               *   RADDAT
      *  91 - Vorwärts blättern                                       *   RADDAT
      *  92 - Rückwärts blättern                                      *   RADDAT
      *                                                               *
      *===============================================================*
      ***                                   DSPSIZ(27 132 *DS4                 -
      ***                                          24 80 *DS3)
      *
      *%%EC
     A                                      DSPSIZ(24 80 *DS3                  -
     A                                             27 132 *DS4)
     A                                      PRINT
     A                                      ALTHELP(CA01)
     A                                      HELP(01)
      *
      *----------------------------------------------------*
     A          R PBSFL                     SFL
      *%%TS  SD  19990212  100855  FENTRAD     REL-V4R2M0  5769-PW1
     A  84                                  SFLNXTCHG
     A            RECORDNBR     10Y 0H
     A            SFPAU          1A  B  5 52
     A  85                                  DSPATR(RI)
     A                                      DSPATR(PR)
     A                                      DSPATR(ND)
     A            ##SEQ          5Y 0B  5  2EDTCDE(Z)
     A  20                                  DSPATR(PC)
     A  30                                  DSPATR(RI)
     A            $$FNME        10A  O  5  9COLOR(WHT)
     A            $$FTXT        30A  O  5 21
     A            $$KSEQ         4A  O  5 54COLOR(BLU)
      *----------------------------------------------------*
     A          R PBCTL                     SFLCTL(PBSFL)
      *%%TS  SD  19990212  101845  FENTRAD     REL-V4R2M0  5769-PW1
     A  *DS3                                SFLSIZ(0013)
     A  *DS4                                SFLSIZ(0013)
     A  *DS3                                SFLPAG(0012)
     A  *DS4                                SFLPAG(0012)
     A  *DS3                                WINDOW(MSGCTL)
     A  *DS4                                WINDOW(MSGCTL)
     A                                      ROLLUP(91)
     A                                      ROLLDOWN(92)
     A                                      CF01
     A                                      CF02
     A                                      CF03
     A                                      CF04
     A                                      CF05
     A                                      CF06
     A                                      CF07
     A                                      CF08
     A                                      CF09
     A                                      CF10
     A                                      CF11
     A                                      CF12
     A                                      CF13
     A                                      CF14
     A                                      CF15
     A                                      CF16
     A                                      CF17
     A                                      CF18
     A                                      CF19
     A                                      CF20
     A                                      CF21
     A                                      CF22
     A                                      CF23
     A                                      CF24
     A N88                                  DSPMOD(*DS4)
     A                                      OVERLAY
     A                                      SFLCSRRRN(&SFLCSR)
     A                                      SFLMODE(&SFLMDE)
     A  80                                  SFLDSP
     A  81                                  SFLDSPCTL
     A  82                                  SFLCLR
     A  83                                  SFLEND(*MORE)
     A                                      RTNCSRLOC(&SCNREC &SCNFLD)
     A            SCNREC        10A  H
     A            SCNFLD        10A  H
     A            SFLMDE         1A  H
     A            SFLCSR         5S 0H
     A            SFSANR         4S 0H      SFLRCDNBR(CURSOR)
     A            TXT0078        7A  O  2 46MSGID(TXT 0078 PEEKGER)
     A            ##FIELD       10A  B  2 54
     A  70                                  DSPATR(PC)
     A            TXT0107       63A  O  3  1MSGID(TXT 0107 PEEKGER)
     A                                      COLOR(BLU)
     A                                      DSPATR(UL)
     A            TXT0106       14A  O  1 26MSGID(TXT 0106 PEEKGER)
     A                                      COLOR(WHT)
      *
      *----------------------------------------------------*
 ADD A          R PBBOT#0
      *%%TS  SD  19971223  134148  RADDATZ     REL-V3R6M0  5716-PW1
 ADD A  *DS3                                WINDOW(MSGCTL)
 ADD A  *DS4                                WINDOW(MSGCTL)
 ADD A N88                                  DSPMOD(*DS4)
 ADD A                                      OVERLAY
 ADD A                                 18  1'                                  -
 ADD A                                                                    '
 ADD A                                      DSPATR(UL)
 ADD A                                      COLOR(BLU)
      *----------------------------------------------------*
 ADD A          R PBBOT#1
      *%%TS  SD  19971223  134148  RADDATZ     REL-V3R6M0  5716-PW1
