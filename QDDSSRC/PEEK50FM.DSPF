      *%%TS  SD  19971223  134148  RADDATZ     REL-V3R6M0  5716-PW1
 ADD A  *DS3                                WINDOW(MSGCTL)
 ADD A  *DS4                                WINDOW(MSGCTL)
 ADD A N88                                  DSPMOD(*DS4)
 ADD A                                      OVERLAY
 ADD A            $$FKEY13      18A  O 19  1COLOR(BLU)
