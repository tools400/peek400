 ADD A                                             '                    ' -
 ADD A                                             '                    ')
      *
 ADD A            KEY           10A
 ADD A                                      TEXT('Schlüssel             -
 ADD A                                                                  ')
 ADD A                                      COLHDG('Schlüssel           ' -
 ADD A                                             '                    ' -
 ADD A                                             '                    ')
      *
