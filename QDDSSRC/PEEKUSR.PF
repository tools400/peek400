     A                                      TEXT('Bereich               -
     A                                                                  ')
     A                                      COLHDG('Bereich             ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
     A            KEY           10A
     A                                      TEXT('Schlüssel             -
     A                                                                  ')
     A                                      COLHDG('Schlüssel           ' -
     A                                             '                    ' -
     A                                             '                    ')
      *
