      *%%TS  SD  19980212  152449  RADDATZ     REL-V3R7M0  5716-PW1
 ADD A  *DS3                                WINDOW(MSGCTL)
 ADD A  *DS4                                WINDOW(MSGCTL)
 ADD A N88                                  DSPMOD(*DS4)
 ADD A                                      OVERLAY
 ADD A            $$FKEY03      18A  O 17  1COLOR(BLU)
 ADD A            $$FKEY04      18A  O 17 21COLOR(BLU)
      *
      *----------------------------------------------------*
 ADD A          R PBBOT#3
      *%%TS  SD  19980212  152449  RADDATZ     REL-V3R7M0  5716-PW1
 ADD A  *DS3                                WINDOW(MSGCTL)
 ADD A  *DS4                                WINDOW(MSGCTL)
 ADD A N88                                  DSPMOD(*DS4)
 ADD A                                      OVERLAY
 ADD A            $$FKEY05      18A  O 17  1COLOR(BLU)
 ADD A            $$FKEY06      18A  O 17 21COLOR(BLU)
      *
      *----------------------------------------------------*
 ADD A          R PBBOT#4
      *%%TS  SD  19980212  152449  RADDATZ     REL-V3R7M0  5716-PW1
 ADD A  *DS3                                WINDOW(MSGCTL)
 ADD A  *DS4                                WINDOW(MSGCTL)
 ADD A N88                                  DSPMOD(*DS4)
 ADD A                                      OVERLAY
 ADD A            $$FKEY07      18A  O 17  1COLOR(BLU)
 ADD A            $$FKEY08      18A  O 17 21COLOR(BLU)
      *
      *----------------------------------------------------*
 ADD A          R PBBOT#5
      *%%TS  SD  19980212  152449  RADDATZ     REL-V3R7M0  5716-PW1
 ADD A  *DS3                                WINDOW(MSGCTL)
 ADD A  *DS4                                WINDOW(MSGCTL)
 ADD A N88                                  DSPMOD(*DS4)
 ADD A                                      OVERLAY
 ADD A            $$FKEY09      18A  O 17  1COLOR(BLU)
 ADD A            $$FKEY10      18A  O 17 21COLOR(BLU)
      *
      *----------------------------------------------------*
 ADD A          R PBBOT#6
      *%%TS  SD  19980216  152449  RADDATZ     REL-V3R7M0  5716-PW1
 ADD A  *DS3                                WINDOW(MSGCTL)
 ADD A  *DS4                                WINDOW(MSGCTL)
 ADD A N88                                  DSPMOD(*DS4)
 ADD A                                      OVERLAY
 ADD A            $$FKEY11      18A  O 17  1COLOR(BLU)
 ADD A            $$FKEY12      18A  O 17 21COLOR(BLU)
      *
      *----------------------------------------------------*
      *
 ADD A          R PBLEER
      *%%TS  SD  19971002  215603  RADDATZ     REL-V3R6M0  5716-PW1
 ADD A  *DS4                                WINDOW(MSGCTL)
 ADD A  *DS3                                WINDOW(MSGCTL)
 ADD A N88                                  DSPMOD(*DS4)
 ADD A                                      OVERLAY
 ADD A            TXT0032       30A  O  7  4MSGID(TXT 0032 PEEKGER )
 ADD A                                      COLOR(WHT)
      *
      *----------------------------------------------------*
 ADD A          R MSGSFL                    SFL
      *%%TS  SD  19971008  090717  RADDATZ     REL-V3R6M0  5716-PW1
 ADD A  *DS3                                SFLMSGRCD(18)
 ADD A  *DS4                                SFLMSGRCD(18)
 ADD A            §MSGKY                    SFLMSGKEY
 ADD A            §PGMQ                     SFLPGMQ(10)
      *
      *----------------------------------------------------*
 ADD A          R MSGCTL                    SFLCTL(MSGSFL)
      *%%TS  SD  19980212  152449  RADDATZ     REL-V3R7M0  5716-PW1
 ADD A                                      KEEP
 ADD A                                      LOCK
 ADD A N88                                  DSPMOD(*DS4)
 ADD A                                      SFLDSP
 ADD A                                      SFLDSPCTL
 ADD A                                      SFLINZ
 ADD A N89                                  SFLEND
 ADD A  *DS3                                SFLSIZ(0002)
 ADD A  *DS4                                SFLSIZ(0002)
 ADD A  *DS3                                SFLPAG(0001)
 ADD A  *DS4                                SFLPAG(0001)
 ADD A  *DS3                                WINDOW(&ZEI &POS 18 48 *NOMSGLIN)
 ADD A  *DS4                                WINDOW(&ZEI &POS 18 48 *NOMSGLIN)
 ADD A            §PGMQ                     SFLPGMQ(10)
 ADD A            ZEI            3S 0P
 ADD A            POS            3S 0P
      *
      *----------------------------------------------------*
      *  RMVWDW ZUM LÖSCHEN DES WINDOWS
      *
 ADD A          R RMVWDW                    CLRL(*NO) OVERLAY FRCDTA
 ADD A N88                                  DSPMOD(*DS4)
      *
      *  DER DUMMY SATZ MUSS VORHANDEN SEIN,
      *  AUCH WENN KEIN ZUGRIFF AUF IHN ERFOLGT !!
      *
      *----------------------------------------------------*
 ADD A          R DUMMY                     ASSUME
      *%%TS  SD  19931014  095141  LASCHE      REL-V2R2M0  5738-PW1
 ADD A N88                                  DSPMOD(*DS4)
 ADD A                                 11  1' '
