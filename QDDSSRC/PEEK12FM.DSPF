 ADD A          R PBLEER
      *%%TS  SD  19971002  215603  RADDATZ     REL-V3R6M0  5716-PW1
 ADD A  *DS4                                WINDOW(MSGCTL)
 ADD A  *DS3                                WINDOW(MSGCTL)
 ADD A N88                                  DSPMOD(*DS4)
 ADD A                                      OVERLAY
 RAD A            TXT0032       30A  B  7  4MSGID(TXT 0032 PEEKGER )
 RAD A                                      COLOR(WHT)
      *
      *----------------------------------------------------*
 ADD A          R MSGSFL                    SFL
      *%%TS  SD  19970929  143815  RADDATZ     REL-V3R6M0  5716-PW1
 RAD A  *DS3                                SFLMSGRCD(14)
 RAD A  *DS4                                SFLMSGRCD(14)
 ADD A            §MSGKY                    SFLMSGKEY
 ADD A            §PGMQ                     SFLPGMQ(10)
      *
      *----------------------------------------------------*
 RAD A          R MSGCTL                    SFLCTL(MSGSFL)
 RAD  *%%TS  SD  20010225  173150  RADDATZ     REL-V4R4M0  5769-PW1
 RAD A                                      KEEP
 RAD A                                      LOCK
 RAD A                                      SFLDSP
 RAD A                                      SFLDSPCTL
 RAD A                                      SFLINZ
 RAD A N89                                  SFLEND
 RAD A  *DS3                                SFLSIZ(0050)
 RAD A  *DS4                                SFLSIZ(0050)
 RAD A  *DS3                                SFLPAG(0001)
 RAD A  *DS4                                SFLPAG(0001)
 RAD A  *DS3                                WINDOW(&ZEI &POS 14 66 *NOMSGLIN)
 RAD A  *DS4                                WINDOW(&ZEI &POS 14 66 *NOMSGLIN)
 RAD A N88                                  DSPMOD(*DS4)
 RAD A            §PGMQ                     SFLPGMQ(10)
 RAD A            ZEI            3S 0P
 RAD A            POS            3S 0P
      *
      *----------------------------------------------------*
      *  RMVWDW ZUM LÖSCHEN DES WINDOWS
      *
 ADD A          R RMVWDW                    CLRL(*NO) OVERLAY FRCDTA
 ADD A N88                                  DSPMOD(*DS4)
      *
      *  DER DUMMY SATZ MUSS VORHANDEN SEIN,
      *  AUCH WENN KEIN ZUGRIFF AUF IHN ERFOLGT !!
      *
      *----------------------------------------------------*
 ADD A          R DUMMY                     ASSUME
      *%%TS  SD  19931014  095141  LASCHE      REL-V2R2M0  5738-PW1
 ADD A N88                                  DSPMOD(*DS4)
 ADD A                                 11  1' '
