      *                                                               *
      *===============================================================*
      *                                                               *
      *  Kurzdokumentation :                                          *
      *                                                               *
      *  Peek/400 - Auswahl Satzformat                                *
      *                                                               *
      *===============================================================*
      *  BEZUGSZAHLEN:                                                *
      *                                                               *
      *  80 - SFLDSP, EXSR SFLC, SÄTZE GEF./NICHT GEFUNDEN            *
      *  81 - SFLDSPCTL                                               *
      *  82 - SFLCLR                                                  *
      *  83 - SFLEND                                                  *
      *  84 - SFLNXTCHG                                               *
      *  85 - DSPATR(RI) FÜR SFPAU                                    *
      *  86 - SFLDROP/SFLFOLD                                         *
      *  87 - DSPATR(PC) FÜR AUFSETZKEY                               *
      *  88 - 80/132-ZEICHEN ANZEIGE                                  *
      *  89 - SFLEND, MSGCTL                                          *
      *                                                               *   RADDAT
      *  96 - Feld für Eingabe sperren  VDSP;VDEL                     *
      *  98 - Feld für Eingabe sperren  VCHG                          *
      *                                                               *   RADDAT
      *  91 - Vorwärts blättern                                       *   RADDAT
      *  92 - Rückwärts blättern                                      *   RADDAT
      *                                                               *
      *===============================================================*
      *
      ***                                   DSPSIZ(27 132 *DS4                 -
      ***                                          24 80 *DS3)
 RAD  *%%EC
 RAD A                                      DSPSIZ(24 80 *DS3                  -
 RAD A                                             27 132 *DS4)
 RAD A                                      PRINT
 RAD A                                      ALTHELP(CA01)
 RAD A                                      HELP(01)
      *
      *----------------------------------------------------*
 RAD A          R PBSFL                     SFL
 RAD  *%%TS  SD  20010225  173150  RADDATZ     REL-V4R4M0  5769-PW1
 RAD A  84                                  SFLNXTCHG
 RAD A            RECORDNBR     10Y 0H
 RAD A            $$RCDL0200   512A  H
 RAD A            FMTNBR         5Y 0H
 RAD A            SFPAU          2A  B  3  2
 RAD A  76                                  DSPATR(PR)
 RAD A N76                                  DSPATR(UL)
 RAD A  85                                  DSPATR(RI)
 RAD A            $$FORMAT      10A  O  3  5COLOR(WHT)
 RAD A                                  4  2' '
 RAD A            $$TEXT        50   O  3 16
      *----------------------------------------------------*
 RAD A          R PBCTL                     SFLCTL(PBSFL)
 RAD  *%%TS  SD  20010225  173150  RADDATZ     REL-V4R4M0  5769-PW1
 RAD A  *DS3                                SFLSIZ(0005)
 RAD A  *DS4                                SFLSIZ(0005)
 RAD A  *DS3                                SFLPAG(0004)
 RAD A  *DS4                                SFLPAG(0004)
 RAD A  *DS3                                WINDOW(MSGCTL)
 RAD A  *DS4                                WINDOW(MSGCTL)
 RAD A                                      ROLLUP(91)
 RAD A                                      ROLLDOWN(92)
 RAD A                                      CF01
 RAD A                                      CF02
 RAD A                                      CF03
 RAD A                                      CF04
 RAD A                                      CF05
 RAD A                                      CF06
 RAD A                                      CF07
 RAD A                                      CF08
 RAD A                                      CF09
 RAD A                                      CF10
 RAD A                                      CF12
 RAD A                                      CF13
 RAD A                                      CF14
 RAD A                                      CF15
 RAD A                                      CF16
 RAD A                                      CF17
 RAD A                                      CF18
 RAD A                                      CF19
 RAD A                                      CF20
 RAD A                                      CF21
 RAD A                                      CF22
 RAD A                                      CF23
 RAD A                                      CF24
 RAD A N88                                  DSPMOD(*DS4)
 RAD A                                      OVERLAY
 RAD A                                      SFLCSRRRN(&SFLCSR)
 RAD A                                      SFLMODE(&SFLMDE)
 RAD A  80                                  SFLDSP
 RAD A  81                                  SFLDSPCTL
 RAD A  82                                  SFLCLR
 RAD A  83                                  SFLEND(*MORE)
 RAD A  86                                  SFLDROP(CF11)
 RAD A N86                                  SFLFOLD(CF11)
 RAD A            SFLMDE         1A  H
 RAD A            SFLCSR         5S 0H
 RAD A            SFSANR         4S 0H      SFLRCDNBR(CURSOR)
 RAD A            TXT0126       24A  O  1 23MSGID(TXT 0126 PEEKGER )
 RAD A                                      COLOR(WHT)
 RAD A                                  2  1'                                  -
 RAD A                                                                      '
 RAD A                                      DSPATR(UL)
 RAD A                                      COLOR(BLU)
 RAD  *----------------------------------------------------*
 RAD A          R PBBOT#0
 RAD  *%%TS  SD  20010225  180538  RADDATZ     REL-V4R4M0  5769-PW1
 RAD A  *DS3                                WINDOW(MSGCTL)
 RAD A  *DS4                                WINDOW(MSGCTL)
 RAD A N88                                  DSPMOD(*DS4)
 RAD A                                      OVERLAY
 RAD A                                 12  1'                                  -
 RAD A                                                                      '
 RAD A                                      DSPATR(UL)
 RAD A                                      COLOR(BLU)
 RAD  *
 RAD  *----------------------------------------------------*
 RAD A          R PBBOT#1
 RAD  *%%TS  SD  20010225  180538  RADDATZ     REL-V4R4M0  5769-PW1
 RAD A  *DS3                                WINDOW(MSGCTL)
 RAD A  *DS4                                WINDOW(MSGCTL)
 RAD A N88                                  DSPMOD(*DS4)
 RAD A                                      OVERLAY
 RAD A            $$FKEY01      18A  O 13  1COLOR(BLU)
 RAD A            $$FKEY02      18A  O 13 21COLOR(BLU)
 RAD A            $$FKEY03      18A  O 13 41COLOR(BLU)
 RAD  *
