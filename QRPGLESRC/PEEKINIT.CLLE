     /* ============================================================ */
     /*                                                              */
     /*  (c) Thomas Raddatz                                          */
     /*                                                              */
     /*  Bereich  : PEEK, Version 3.3.0                              */
     /*  Programm : PEEKINIT                                         */
     /*  Typ      : CLLE                                             */
     /*                                                              */
     /*  erstellt : 13.04.2011                                       */
     /*                                                              */
     /* ============================================================ */
     /*                                                              */
     /*  Dokumentation:                                              */
     /*                                                              */
     /*  Befehlsausführungsprogramm für PEEKINIT                     */
     /*                                                              */
     /* ============================================================ */

          PGM        PARM(&LANG4 &CCSID)

          DCL        VAR(&LANG4   )   TYPE(*CHAR)  LEN(  4)
          DCL        VAR(&CCSID   )   TYPE(*DEC )  LEN(5 0)

          DCL        VAR(&LANGUAGE)   TYPE(*CHAR)  LEN( 10)
          DCL        VAR(&PREFIX  )   TYPE(*CHAR)  LEN( 10) VALUE('PEEK')
          DCL        VAR(&MSGID     ) TYPE(*CHAR)  LEN(  7)
          DCL        VAR(&MSGDTA    ) TYPE(*CHAR)  LEN(512)

          DCL        VAR(&OBJECT    ) TYPE(*CHAR)  LEN(10)

          DCL        VAR(&OBJLIB    ) TYPE(*CHAR)  LEN(10)

          DCL        VAR(&CMD       ) TYPE(*CHAR)  LEN(1024)
          DCL        VAR(&CMDLEN    ) TYPE(*DEC )  LEN(15 5) +
                          VALUE(1024)

/* Fehlerbehandlung     */
             DCL        VAR(&ERROR)      TYPE(*LGL) +
                          VALUE('0')
             DCL        VAR(&ERRMSGKEY)  TYPE(*CHAR) LEN(4)

             DCL        VAR(&ERRMSGTYP)  TYPE(*CHAR) LEN(10) +
                          VALUE('*DIAG')
             DCL        VAR(&ERRNBRTYP)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRPGMMSGQ) TYPE(*CHAR) LEN(10) +
                          VALUE('*')
             DCL        VAR(&ERRSTKCTR)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRCODE  )  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000000')

/* Sende alle Fehler zur Error Handling Routine */
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CHGVAR     VAR(&ERROR    ) VALUE('0')

 /* -------------------------------------------------------------- */
 /*  Los geht's                                                    */
 /* -------------------------------------------------------------- */

             RTVOBJD    OBJ(PEEK05) OBJTYPE(*PGM) RTNLIB(&OBJLIB)

             IF         COND(&LANG4 *NE '*') THEN(DO)
                CHGVAR     VAR(&LANGUAGE) VALUE('PEEK' *CAT &LANG4)
                CHKOBJ     OBJ(*LIBL/&LANGUAGE) OBJTYPE(*MSGF)
                CHGVAR     VAR(&OBJECT) VALUE('PEEK')
                CALL       PGM(PEEKINIT1) PARM(&OBJECT &LANG4 &OBJLIB)
                CHGVAR     VAR(&OBJECT) VALUE('TREE')
                CALL       PGM(PEEKINIT1) PARM(&OBJECT &LANG4 &OBJLIB)
             ENDDO

             CALL       PGM(PEEKINIT2) PARM(&CCSID &OBJLIB)

             CALL       PGM(PEEKINIT3) PARM(&OBJLIB &LANG4)

/* Verschiebe alle *INFO Nachrichten zur             */
/* vorangegangenen Programmwarteschlange             */
             CHGVAR     VAR(&ERRMSGTYP) VALUE('*INFO')
             CHGVAR     VAR(&ERRSTKCTR) VALUE(X'00000002')
             CALL       PGM(QMHMOVPM) PARM(&ERRMSGKEY &ERRMSGTYP +
                          &ERRNBRTYP &ERRPGMMSGQ &ERRSTKCTR &ERRCODE)

 ENDE:
             RCLRSC     LVL(*)
             MONMSG     MSGID(CPF0000)

             IF         COND(&ERROR) THEN(DO)
                /* Sende letzte *ESCAPE nochmals   */
                CALL       PGM(QMHRSNEM) PARM(&ERRMSGKEY &ERRCODE)
             ENDDO

             RETURN

/* ---------------- */
/* Error            */
/* Handling         */
/* ---------------- */
 ERROR:
             IF         COND(&ERROR) THEN(GOTO CMDLBL(ENDE))
             ELSE       CHGVAR     VAR(&ERROR) VALUE('1')

/* Verschiebe alle *DIAG Nachrichten zur             */
/* vorangegangenen Programmwarteschlange             */
             CHGVAR     VAR(&ERRMSGTYP) VALUE('*DIAG')
             CALL       PGM(QMHMOVPM) PARM(&ERRMSGKEY &ERRMSGTYP +
                          &ERRNBRTYP &ERRPGMMSGQ &ERRSTKCTR &ERRCODE)

             GOTO       CMDLBL(ENDE)

             ENDPGM

