     /* ============================================================ */
     /*                                                              */
     /*  (c) Thomas Raddatz                                          */
     /*                                                              */
     /*  Bereich  : PEEK, Version 2.2.0                              */
     /*  Programm : PEEK99                                           */
     /*  Typ      : CLP                                              */
     /*                                                              */
     /*  erstellt : 11.11.1997  Raddatz                              */
     /*  geändert : 27.04.1999  2.1.0                                */
     /*                                                              */
     /* ============================================================ */
     /*                                                              */
     /*  Dokumentation:                                              */
     /*                                                              */
     /*  Generieren PEEK-Programm/Displayfile-Objekte                */
     /*                                                              */
     /* ============================================================ */
     /* >>PRE-COMPILER<<                                             */
     /*   >>CRTCMD<< &LI/CRTPEEKOBJ SRCFILE(&SL/&SF) SRCMBR(&SM) +   */
     /*                           OBJLIB(&LI) DEVLIB(&LI) +          */
     /*                           SBMJOB(*NO) BNDDIR(PEEK) +         */
     /*                           INSTALL(*NO);                      */
     /*   >>EXECUTE<<                                                */
     /* >>END-PRE-COMPILER<<                                         */
     /* ============================================================ */

          PGM        PARM(&QSRCFILE   +
                          &MBR        +
                          &OBJLIB     +
                          &SBMJOB     +
                          &BNDDIRE    +
                          &DEVLIB     +
                          &IS_INSTALL +
                          )

          DCL        VAR(&QSRCFILE  ) TYPE(*CHAR)  LEN( 20)
          DCL        VAR(&FILE      ) TYPE(*CHAR)  LEN( 10) STG(*DEFINED) DEFVAR(&QSRCFILE  1)
          DCL        VAR(&LIB       ) TYPE(*CHAR)  LEN( 10) STG(*DEFINED) DEFVAR(&QSRCFILE 11)
          DCL        VAR(&MBR       ) TYPE(*CHAR)  LEN( 10)
          DCL        VAR(&OBJLIB    ) TYPE(*CHAR)  LEN( 10)
          DCL        VAR(&SBMJOB    ) TYPE(*CHAR)  LEN( 10)
          DCL        VAR(&BNDDIRE   ) TYPE(*CHAR)  LEN( 10)
          DCL        VAR(&DEVLIB    ) TYPE(*CHAR)  LEN( 10)
          DCL        VAR(&IS_INSTALL) TYPE(*LGL )
          DCL        VAR(&OBJTYPE   ) TYPE(*CHAR)  LEN(10)

          DCL        VAR(&TRUE      ) TYPE(*LGL )  VALUE('1')
          DCL        VAR(&FALSE     ) TYPE(*LGL )  VALUE('0')

          DCL        VAR(&MBRLIST   ) TYPE(*CHAR)  LEN( 10)
          DCL        VAR(&SRCTYPE   ) TYPE(*CHAR)  LEN( 10)
          DCL        VAR(&DBGVIEW   ) TYPE(*CHAR)  LEN( 10)
          DCL        VAR(&TGTRLS    ) TYPE(*CHAR)  LEN( 10)
          DCL        VAR(&RTNLIB    ) TYPE(*CHAR)  LEN( 10)
          DCL        VAR(&TEXT      ) TYPE(*CHAR)  LEN( 50)
          DCL        VAR(&IS_NOMAIN ) TYPE(*LGL )
          DCL        VAR(&RMV_DEVLIB) TYPE(*LGL )  VALUE('0')
          DCL        VAR(&IS_REMOVED) TYPE(*LGL )  VALUE('0')
          DCL        VAR(&PRDLIB    ) TYPE(*CHAR)  LEN( 10)

          DCL        VAR(&LANGUAGE  ) TYPE(*CHAR)  VALUE('PEEKGER')
          DCL        VAR(&YEAR      ) TYPE(*CHAR)  LEN(  4) VALUE('2000')
          DCL        VAR(&QYEAR     ) TYPE(*CHAR)  LEN(  2)

          DCL        VAR(&CMD       ) TYPE(*CHAR)  LEN(1024)
          DCL        VAR(&CMDLEN    ) TYPE(*DEC )  LEN(15 5) +
                          VALUE(1024)

/* Fehlerbehandlung     */
             DCL        VAR(&ERROR)      TYPE(*LGL) +
                          VALUE('0')
             DCL        VAR(&ERRMSGKEY)  TYPE(*CHAR) LEN(4)

             DCL        VAR(&ERRMSGTYP)  TYPE(*CHAR) LEN(10) +
                          VALUE('*DIAG')
             DCL        VAR(&ERRNBRTYP)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRPGMMSGQ) TYPE(*CHAR) LEN(10) +
                          VALUE('*')
             DCL        VAR(&ERRSTKCTR)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRCODE  )  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000000')

/* Sende alle Fehler zur Error Handling Routine */
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CHGVAR     VAR(&ERROR    ) VALUE('0')

 /* -------------------------------------------------------------- */
 /* submit oder nicht                                              */
 /* -------------------------------------------------------------- */
             IF         COND(&SBMJOB  *EQ '*YES') THEN(DO)
                CHGVAR     VAR(&SBMJOB) VALUE('*NO')
                SBMJOB     CMD(CALL PGM(&DEVLIB/PEEK99) +
                                                PARM(&QSRCFILE   +
                                                     &MBR        +
                                                     &OBJLIB     +
                                                     &SBMJOB     +
                                                     &BNDDIRE    +
                                                     &DEVLIB     +
                                                     &IS_INSTALL +
                                                     ))          +
                           JOB(&MBR)                             +
                           JOBPTY(6)                             +
                           JOBQ(RADDATZ)
                GOTO       CMDLBL(ENDE)
             ENDDO

 /* -------------------------------------------------------------- */
 /*  Los geht's                                                    */
 /* -------------------------------------------------------------- */

             CHGVAR     VAR(&CMD) VALUE(' ')

             SELECT
             WHEN       COND(%SST(&MBR 1 7) *EQ 'PEEKUPD') THEN( +
                CHGVAR     VAR(&MBRLIST) VALUE('PEEKUPD*'))
             WHEN       COND(%SST(&MBR 1 9) *EQ 'PEEKCLONE') THEN( +
                CHGVAR     VAR(&MBRLIST) VALUE('PEEKCLONE*'))
             OTHERWISE CMD( +
                CHGVAR     VAR(&MBRLIST) VALUE(&MBR *TCAT '*'))
             ENDSELECT

             CHKOBJ     OBJ(&DEVLIB/PEEK) OBJTYPE(*BNDDIR)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTBNDDIR  BNDDIR(&DEVLIB/PEEK)
               GOTO       CMDLBL(ADDBNDDIRE)
             ENDDO

             RMVBNDDIRE BNDDIR(&DEVLIB/PEEK) OBJ((*ALL *SRVPGM))

ADDBNDDIRE:
             ADDBNDDIRE BNDDIR(&DEVLIB/PEEK) +
                        OBJ((&DEVLIB/PEEK51 *SRVPGM) +
                            (&DEVLIB/PEEK53 *SRVPGM) +
                            (&DEVLIB/PEEK58 *SRVPGM) +
                            (&DEVLIB/PEEK61 *SRVPGM) +
                            (&DEVLIB/PEEK63 *SRVPGM) +
                            (&DEVLIB/PEEK71 *SRVPGM))

             RTVSYSVAL  SYSVAL(QYEAR) RTNVAR(&QYEAR)
             CHGVAR     VAR(%SST(&YEAR 3 2)) VALUE(&QYEAR)
             CHGDTAARA  DTAARA(&LIB/PEEKPGM (321 4)) VALUE(&YEAR)

             RTVMBRD    FILE(&LIB/&FILE) MBR(&MBR) SRCTYPE(&SRCTYPE) +
                          TEXT(&TEXT)
             RTVDTAARA  DTAARA(&OBJLIB/PEEKPGM (  1  10)) +
                          RTNVAR(&DBGVIEW)
             RTVDTAARA  DTAARA(&OBJLIB/PEEKPGM ( 11  10)) +
                          RTNVAR(&TGTRLS)

             IF         COND(&MBR *EQ 'PEEK95') THEN(DO)
                CHGVAR     VAR(&TGTRLS) VALUE('*CURRENT')
             ENDDO

             RTVOBJD    OBJ(*LIBL/RPGLEHSPEC) OBJTYPE(*DTAARA) +
                          RTNLIB(&RTNLIB)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                CHGVAR     VAR(&RTNLIB) VALUE('*N')
             ENDDO
             IF         COND(&RTNLIB *NE '*N') THEN(DO)
                SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                           MSGDTA('RPGLEHSPEC in Bibliothek ''' *TCAT &RTNLIB +
                           *TCAT ''' nicht zulässig') TOPGMQ(*PRV +
                           (*)) MSGTYPE(*ESCAPE)
             ENDDO

             IF         COND(&DBGVIEW *NE '*ALL'  +
                        *AND &DBGVIEW *NE '*LIST' +
                        *AND &DBGVIEW *NE '*NONE') THEN(DO)
                SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                           MSGDTA('DBGVIEW ''' *TCAT &DBGVIEW *TCAT +
                           ''' nicht zulässig') TOPGMQ(*PRV (*)) +
                           MSGTYPE(*ESCAPE)
             ENDDO

             IF         COND(%SST(&TEXT 45 6) *EQ 'SrvPgm') THEN(DO)
                CHGVAR     VAR(&IS_NOMAIN) VALUE(&TRUE)
             ENDDO
             ELSE       CMD(DO)
                CHGVAR     VAR(&IS_NOMAIN) VALUE(&FALSE)
             ENDDO

             IF         COND(&SRCTYPE *NE 'CMD'      +
                        *AND &SRCTYPE *NE 'PNLGRP'   +
                        *AND &SRCTYPE *NE 'DSPF'     +
                        *AND &SRCTYPE *NE 'PRTF'     +
                        *AND &SRCTYPE *NE 'RPGLE'    +
                        *AND &SRCTYPE *NE 'SQLRPGLE' +
                        *AND &SRCTYPE *NE 'C'        +
                        *AND &SRCTYPE *NE 'CLLE' )   THEN(DO)
                SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                           MSGDTA('SRCTYPE ''' *TCAT &SRCTYPE *TCAT +
                           ''' nicht zulässig') TOPGMQ(*PRV (*)) +
                           MSGTYPE(*ESCAPE)
             ENDDO

/* ----------------- */
/* commands          */
/* ----------------- */
             IF         COND(&SRCTYPE *EQ 'CMD') THEN(DO)
                CHGVAR     VAR(&OBJTYPE) VALUE('*CMD')
                CHGVAR     VAR(&PRDLIB ) VALUE(&OBJLIB)
                IF         COND(&MBR = 'PEEKINIT') THEN(DO)
                   CHGVAR     VAR(&PRDLIB ) VALUE('*NONE')
                ENDDO
                CHGVAR     VAR(&CMD) VALUE('CRTCMD'     +
                                     *BCAT  'CMD('      +
                                     *TCAT  &OBJLIB     +
                                     *TCAT  '/'         +
                                     *TCAT  &MBR        +
                                     *TCAT  ')'         +
                                     *BCAT  'PGM('      +
                                     *TCAT  '*LIBL'     +
                                     *TCAT  '/'         +
                                     *TCAT  &MBR        +
                                     *TCAT  ')'         +
                                     *BCAT  'SRCFILE('  +
                                     *TCAT  &LIB        +
                                     *TCAT  '/'         +
                                     *TCAT  &FILE       +
                                     *TCAT  ')'         +
                                     *BCAT  'SRCMBR('   +
                                     *TCAT  &MBR        +
                                     *TCAT  ')'         +
                                     *BCAT  'PRDLIB('   +
                                     *TCAT  &PRDLIB     +
                                     *TCAT  ')'         +
                                     *BCAT  'PMTFILE('  +
                                     *TCAT  &LANGUAGE   +
                                     *TCAT  ')'         +
                                     *BCAT  'OPTION('   +
                                     *TCAT  '*EVENTF'   +
                                     *TCAT  ')'         +
                                     )
/* ----------------- */
/* Erstellen         */
/* PEEK/TREE ...     */
/* ----------------- */
                IF         COND(&MBR *EQ 'PEEK'             +
                           *OR  &MBR *EQ 'TREE'             +
                           ) THEN(DO)
                   CHGVAR     VAR(&CMD) VALUE(&CMD          +
                                        *BCAT  'MODE('      +
                                        *TCAT  '*ALL'       +
                                        *TCAT  ')'          +
                                        *BCAT  'ALLOW('     +
                                        *TCAT  '*INTERACT'  +
                                        *BCAT  '*IPGM'      +
                                        *BCAT  '*IREXX'     +
                                        *BCAT  '*EXEC'      +
                                        *BCAT  '*IMOD'      +
                                        *TCAT  ')'          +
                                        *BCAT  'ALWLMTUSR(' +
                                        *TCAT  '*NO'        +
                                        *TCAT  ')'          +
                                        *BCAT  'HLPPNLGRP(' +
                                        *TCAT  '*LIBL'      +
                                        *TCAT  '/'          +
                                        *TCAT  &MBR *TCAT 'GER' +
                                        *TCAT  ')'          +
                                        *BCAT  'HLPID('     +
                                        *TCAT  &MBR         +
                                        *TCAT  ')'          +
                                        )
                ENDDO
/* ----------------- */
/* Erstellen         */
/* PEEKINIT ...      */
/* ----------------- */
                IF         COND(&MBR *EQ 'PEEKINIT'         +
                           *OR  &MBR *EQ 'PEEKCLONE'        +
                           ) THEN(DO)
                   CHGVAR     VAR(&CMD) VALUE(&CMD          +
                                        *BCAT  'MODE('      +
                                        *TCAT  '*ALL'       +
                                        *TCAT  ')'          +
                                        *BCAT  'ALLOW('     +
                                        *TCAT  '*ALL'       +
                                        *TCAT  ')'          +
                                        *BCAT  'ALWLMTUSR(' +
                                        *TCAT  '*NO'        +
                                        *TCAT  ')'          )
                ENDDO
/* ----------------- */
/* Erstellen         */
/* BUILD ...         */
/* ----------------- */
                IF         COND(&MBR *EQ 'BUILD'            +
                           ) THEN(DO)
                   CHGVAR     VAR(&CMD) VALUE('CRTCMD'      +
                                        *BCAT  'CMD('       +
                                        *TCAT  &OBJLIB      +
                                        *TCAT  '/'          +
                                        *TCAT  &MBR         +
                                        *TCAT  ')'          +
                                        *BCAT  'PGM('       +
                                        *TCAT  &OBJLIB      +
                                        *TCAT  '/'          +
                                        *TCAT  'PEEK96'     +
                                        *TCAT  ')'          +
                                        *BCAT  'MODE('      +
                                        *TCAT  '*ALL'       +
                                        *TCAT  ')'          +
                                        *BCAT  'ALLOW('     +
                                        *TCAT  '*ALL'       +
                                        *TCAT  ')'          +
                                        *BCAT  'ALWLMTUSR(' +
                                        *TCAT  '*NO'        +
                                        *TCAT  ')'          )
                ENDDO
                GOTO       CMDLBL(CRT_OBJ)
             ENDDO

/* ----------------- */
/* panel groups      */
/* ----------------- */
             IF         COND(&SRCTYPE *EQ 'PNLGRP') THEN(DO)
                CHGVAR     VAR(&OBJTYPE) VALUE('*PNLGRP')
                CHGVAR     VAR(&CMD) VALUE('CRTPNLGRP'  +
                                     *BCAT  'PNLGRP('   +
                                     *TCAT  &OBJLIB     +
                                     *TCAT  '/'         +
                                     *TCAT  &MBR        +
                                     *TCAT  ')'         +
                                     *BCAT  'SRCFILE('  +
                                     *TCAT  &LIB        +
                                     *TCAT  '/'         +
                                     *TCAT  &FILE       +
                                     *TCAT  ')'         +
                                     *BCAT  'SRCMBR('   +
                                     *TCAT  &MBR        +
                                     *TCAT  ')'         +
                                     *BCAT  'OPTION('   +
                                     *TCAT  '*EVENTF'   +
                                     *TCAT  ')'         +
                                     )
                GOTO       CMDLBL(CRT_OBJ)
             ENDDO

/* ----------------- */
/* printer files     */
/* ----------------- */
             IF         COND(&SRCTYPE *EQ 'PRTF') THEN(DO)
                CHGVAR     VAR(&OBJTYPE) VALUE('*FILE')
                CHGVAR     VAR(&CMD) VALUE('CRTPRTF'    +
                                     *BCAT  'FILE('     +
                                     *TCAT  &OBJLIB     +
                                     *TCAT  '/'         +
                                     *TCAT  &MBR        +
                                     *TCAT  ')'         +
                                     *BCAT  'SRCFILE('  +
                                     *TCAT  &LIB        +
                                     *TCAT  '/'         +
                                     *TCAT  &FILE       +
                                     *TCAT  ')'         +
                                     *BCAT  'SRCMBR('   +
                                     *TCAT  &MBR        +
                                     *TCAT  ')'         +
                                     *BCAT  'OPTION('   +
                                     *TCAT  '*EVENTF'   +
                                     *TCAT  ')'         +
                                     )
          /*    IF         COND(&MBR *EQ 'PEEK65P') THEN(DO)      */
          /*       CHGVAR   VAR(&CMD) VALUE(&CMD +                */
          /*                         *BCAT 'PAGESIZE(93 100)' +   */
          /*                         *BCAT 'LPI(8)'           +   */
          /*                         *BCAT 'CPI(12)'          +   */
          /*                         *BCAT 'OVRFLW(88)')          */
          /*    ENDDO                                             */
                GOTO       CMDLBL(CRT_OBJ)
             ENDDO

/* ----------------- */
/* display files     */
/* ----------------- */
             IF         COND(&SRCTYPE *EQ 'DSPF') THEN(DO)
                CHGVAR     VAR(&OBJTYPE) VALUE('*FILE')
                CHGVAR     VAR(&CMD) VALUE('CRTDSPF'    +
                                     *BCAT  'FILE('     +
                                     *TCAT  &OBJLIB     +
                                     *TCAT  '/'         +
                                     *TCAT  &MBR        +
                                     *TCAT  ')'         +
                                     *BCAT  'SRCFILE('  +
                                     *TCAT  &LIB        +
                                     *TCAT  '/'         +
                                     *TCAT  &FILE       +
                                     *TCAT  ')'         +
                                     *BCAT  'SRCMBR('   +
                                     *TCAT  &MBR        +
                                     *TCAT  ')'         +
                                     *BCAT  'LANGID('   +
                                     *TCAT  '*JOB'      +
                                     *TCAT  ')'         +
                                     *BCAT  'OPTION('   +
                                     *TCAT  '*EVENTF'   +
                                     *TCAT  ')'         +
                                     )
       /*       IF         COND(&MBR *NE 'PEEK05FM') THEN(DO)     */
                   CHGVAR     VAR(&CMD) VALUE(&CMD         +
                                        *BCAT  'RSTDSP('   +
                                        *TCAT  '*YES'      +
                                        *TCAT  ')'         +
                                        )
       /*       ENDDO                                             */
                GOTO       CMDLBL(CRT_OBJ)
             ENDDO

/* ----------------- */
/* printer files     */
/* ----------------- */
             IF         COND(&SRCTYPE *EQ 'PRTF') THEN(DO)
                CHGVAR     VAR(&OBJTYPE) VALUE('*FILE')
                CHGVAR     VAR(&CMD) VALUE('STRPREPRC '   +
                                     *BCAT  'USESRCFILE(' +
                                     *TCAT  &LIB          +
                                     *TCAT  '/'           +
                                     *TCAT  &FILE         +
                                     *TCAT  ')'           +
                                     *BCAT  'USESRCMBR('  +
                                     *TCAT  &MBR          +
                                     *TCAT  ')'           +
                                     *BCAT  'LIB('        +
                                     *TCAT  &OBJLIB       +
                                     *TCAT  ')'           +
                                     *BCAT  'OBJ('        +
                                     *TCAT  &MBR          +
                                     *TCAT  ')'           +
                                     *BCAT  'SRCLIB('     +
                                     *TCAT  &LIB          +
                                     *TCAT  ')'           +
                                     *BCAT  'SRCFILE('    +
                                     *TCAT  &FILE         +
                                     *TCAT  ')'           +
                                     *BCAT  'SRCMBR('     +
                                     *TCAT  &MBR          +
                                     *TCAT  ')'           +
                                     )
                GOTO       CMDLBL(CRT_OBJ)
             ENDDO

/* ----------------- */
/* SQL Module        */
/* ----------------- */
             IF         COND(&SRCTYPE *EQ 'SQLRPGLE') THEN(DO)
                CHGVAR     VAR(&OBJTYPE) VALUE('*MODULE')
                CHGVAR     VAR(&CMD) VALUE('CRTSQLRPGI'     +
                                     *BCAT  'OBJTYPE('      +
                                     *TCAT  '*MODULE'       +
                                     *TCAT  ')'             +
                                     *BCAT  'OBJ('          +
                                     *TCAT  &OBJLIB         +
                                     *TCAT  '/'             +
                                     *TCAT  &MBR            +
                                     *TCAT  ')'             +
                                     *BCAT  'DBGVIEW('      +
                                     *TCAT  '*NONE'         +
                                     *TCAT  ')'             +
                                     *BCAT  'COMMIT('       +
                                     *TCAT  '*NONE'         +
                                     *TCAT  ')'             +
                                     *BCAT  'ALWBLK('       +
                                     *TCAT  '*NONE'         +
                                     *TCAT  ')'             +
                                     *BCAT  'RPGPPOPT('     +
                                     *TCAT  '*NONE'         +
                                     *TCAT  ')'             +
                                     *BCAT  'OPTION('       +
                                     *TCAT  '*EVENTF'       +
                                     *TCAT  ')'             +
                                     *BCAT  'COMPILEOPT(''' +
                                     *BCAT  'DBGVIEW('      +
                                     *TCAT  &DBGVIEW        +
                                     *TCAT  ')'             +
                                     *TCAT  ''')'           +
                                     )
             ENDDO

/* ----------------- */
/* RPG Module        */
/* ----------------- */
             IF         COND(&SRCTYPE *EQ 'RPGLE') THEN(DO)
               CHGVAR     VAR(&OBJTYPE) VALUE('*MODULE')
               CHGVAR     VAR(&CMD) VALUE('CRTRPGMOD'    +
                                    *BCAT  'MODULE('     +
                                    *TCAT  &OBJLIB       +
                                    *TCAT  '/'           +
                                    *TCAT  &MBR          +
                                    *TCAT  ')'           +
                                    *BCAT  'DBGVIEW('    +
                                    *TCAT  &DBGVIEW      +
                                    *TCAT  ')'           +
                                    *BCAT  'TRUNCNBR('   +
                                    *TCAT  '*NO'         +
                                    *TCAT  ')'           +
                                    *BCAT  'CVTOPT('     +
                                    *TCAT  '*VARCHAR'    +
                                    *BCAT  '*VARGRAPHIC' +
                                    *TCAT  ')'           +
                                    *BCAT  'OPTION('     +
                                    *TCAT  '*EVENTF'     +
                                    *TCAT  ')'           +
                                    )
             ENDDO

/* ----------------- */
/* C Module          */
/* ----------------- */
             IF         COND(&SRCTYPE *EQ 'C') THEN(DO)
               CHGVAR     VAR(&OBJTYPE) VALUE('*MODULE')
               CHGVAR     VAR(&CMD) VALUE('CRTCMOD'      +
                                    *BCAT  'MODULE('     +
                                    *TCAT  &OBJLIB       +
                                    *TCAT  '/'           +
                                    *TCAT  &MBR          +
                                    *TCAT  ')'           +
                                    *BCAT  'DBGVIEW('    +
                                    *TCAT  &DBGVIEW      +
                                    *TCAT  ')'           +
                                    *BCAT  'OUTPUT('     +
                                    *TCAT  '*PRINT'      +
                                    *TCAT  ')'           +
                                    *BCAT  'SYSIFCOPT('  +
                                    *TCAT  '*NOIFSIO'    +
                                    *TCAT  ')'           +
                                    *BCAT  'OPTION('     +
                                    *TCAT  '*EVENTF'     +
                                    *TCAT  ')'           +
                                    )
             ENDDO

/* ----------------- */
/* CL  Module        */
/* ----------------- */
             IF         COND(&SRCTYPE *EQ 'CLLE') THEN(DO)
                CHGVAR     VAR(&OBJTYPE) VALUE('*MODULE')
                CHGVAR     VAR(&CMD) VALUE('CRTCLMOD'    +
                                     *BCAT  'MODULE('    +
                                     *TCAT  &OBJLIB      +
                                     *TCAT  '/'          +
                                     *TCAT  &MBR         +
                                     *TCAT  ')'          +
                                     *BCAT  'DBGVIEW('   +
                                     *TCAT  &DBGVIEW     +
                                     *TCAT  ')'          +
                                     *BCAT  'OPTION('    +
                                     *TCAT  '*EVENTF'    +
                                     *TCAT  ')'          +
                                     )
             ENDDO

/* ----------------- */
/* Sonstige          */
/* Parameter für     */
/* Modulerstellung   */
/* ----------------- */
             CHGVAR     VAR(&CMD) VALUE(&CMD          +
                                 *BCAT  'SRCFILE('   +
                                 *TCAT  &LIB         +
                                 *TCAT  '/'          +
                                 *TCAT  &FILE        +
                                 *TCAT  ')'          +
                                 *BCAT  'SRCMBR('    +
                                 *TCAT  &MBR         +
                                 *TCAT  ')'          +
                                 *BCAT  'REPLACE('   +
                                 *TCAT  '*YES'       +
                                 *TCAT  ')'          +
                                 *BCAT  'TGTRLS('    +
                                 *TCAT  &TGTRLS      +
                                 *TCAT  ')'          +
                                 )

             IF         COND(&SRCTYPE *NE 'C') THEN(DO)
                CHGVAR     VAR(&CMD) VALUE(&CMD         +
                                     *BCAT  'LANGID('    +
                                     *TCAT  '*JOBRUN'    +
                                     *TCAT  ')'          +
                                     )
             ENDDO

/* ----------------- */
/* Modul erstellen   */
/* ----------------- */
CRT_MOD:
             CALL       PGM(QCMDEXC) PARM(&CMD &CMDLEN)

             DLTSPLF    FILE(&MBR) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

             IF         COND(&MBR *EQ 'PEEK63C'     *OR +
                             &MBR *EQ 'PEEKCLONE1'  *OR +
                             &MBR *EQ 'PEEKCLONE2'  *OR +
                             &MBR *EQ 'PEEKUPD1'    *OR +
                             &MBR *EQ 'PEEKUPD2'  ) THEN(DO)
                GOTO       CMDLBL(ENDE)
             ENDDO

             IF         COND(&MBR *EQ 'PEEK63') THEN(DO)
                CALL       PGM(&DEVLIB/PEEK99) PARM( +
                                            &QSRCFILE  +
                                            'PEEK63C'  +
                                            &OBJLIB    +
                                            &SBMJOB    +
                                            &BNDDIRE   +
                                            &DEVLIB    +
                                            &IS_INSTALL)
             ENDDO

             IF         COND(&MBR *EQ 'PEEKCLONE') THEN(DO)
                CALL       PGM(&DEVLIB/PEEK99) PARM( +
                                            &QSRCFILE    +
                                            'PEEKCLONE1' +
                                            &OBJLIB      +
                                            &SBMJOB      +
                                            &BNDDIRE     +
                                            &DEVLIB      +
                                            &IS_INSTALL  )
                CALL       PGM(&DEVLIB/PEEK99) PARM( +
                                            &QSRCFILE    +
                                            'PEEKCLONE2' +
                                            &OBJLIB      +
                                            &SBMJOB      +
                                            &BNDDIRE     +
                                            &DEVLIB      +
                                            &IS_INSTALL  )
             ENDDO

             IF         COND(&MBR *EQ 'PEEKUPDATE') THEN(DO)
                CALL       PGM(&DEVLIB/PEEK99) PARM( +
                                            &QSRCFILE    +
                                            'PEEKUPD1'   +
                                            &OBJLIB      +
                                            &SBMJOB      +
                                            &BNDDIRE     +
                                            &DEVLIB      +
                                            &IS_INSTALL  )
                CALL       PGM(&DEVLIB/PEEK99) PARM( +
                                            &QSRCFILE    +
                                            'PEEKUPD2'   +
                                            &OBJLIB      +
                                            &SBMJOB      +
                                            &BNDDIRE     +
                                            &DEVLIB      +
                                            &IS_INSTALL  )
             ENDDO

/* ----------------- */
/* Erstellen         */
/* Pgme/SrvPgme ...  */
/* ----------------- */
             IF         COND(&MBR *EQ 'PEEK51'           +
                        *OR  &MBR *EQ 'PEEK53'           +
                        *OR  &MBR *EQ 'PEEK58'           +
                        *OR  &MBR *EQ 'PEEK61'           +
                        *OR  &MBR *EQ 'PEEK63'           +
                        *OR  &MBR *EQ 'PEEK71'           +
                        ) THEN(DO)
   /* ----------------- */
   /* ... Service-Pgme  */
   /* ----------------- */
                CHGVAR     VAR(&RMV_DEVLIB) VALUE(&TRUE)
                DLTSRVPGM  SRVPGM(&OBJLIB/&MBR)
                MONMSG     MSGID(CPF2105)
                CHGVAR     VAR(&OBJTYPE) VALUE('*SRVPGM')
                CHGVAR     VAR(&CMD) VALUE('CRTSRVPGM'   +
                                     *BCAT  'SRVPGM('    +
                                     *TCAT  &OBJLIB      +
                                     *TCAT  '/'          +
                                     *TCAT  &MBR         +
                                     *TCAT  ')'          +
                                     *BCAT  'EXPORT('    +
                                     *TCAT  '*SRCFILE'   +
                                     *TCAT  ')'          +
                                     *BCAT  'SRCFILE('   +
                                     *TCAT  &LIB         +
                                     *TCAT  '/'          +
                                     *TCAT  'QSRVSRC'    +
                                     *TCAT  ')'          +
                                     *BCAT  'SRCMBR('    +
                                     *TCAT  '*SRVPGM'    +
                                     *TCAT  ')'          +
                                     *BCAT  'ALWLIBUPD(' +
                                     *TCAT  '*YES'       +
                                     *TCAT  ')'          +
                                     )
             ENDDO
             ELSE       CMD(DO)
   /* ----------------- */
   /* ... Programme     */
   /* ----------------- */
                CHGVAR     VAR(&RMV_DEVLIB) VALUE(&TRUE)
                CHGVAR     VAR(&OBJTYPE) VALUE('*PGM')
                CHGVAR     VAR(&CMD) VALUE('CRTPGM'      +
                                     *BCAT  'PGM('       +
                                     *TCAT  &OBJLIB      +
                                     *TCAT  '/'          +
                                     *TCAT  &MBR         +
                                     *TCAT  ')'          +
                                     *BCAT  'ALWLIBUPD(' +
                                     *TCAT  '*YES'       +
                                     *TCAT  ')'          +
                                     )
             ENDDO

/* ----------------- */
/* Sonstige          */
/* Parameter für     */
/* Programmerstell.  */
/* ----------------- */
                CHGVAR     VAR(&CMD) VALUE(&CMD          +
                                     *BCAT  'MODULE('    +
                                     *TCAT  &OBJLIB      +
                                     *TCAT  '/'          +
                                     *TCAT  &MBRLIST     +
                                     *TCAT  ')'          +
                                     *BCAT  'BNDDIR('    +
                                     *TCAT  ' QC2LE'     +
                                     *BCAT  &BNDDIRE     +
                                     *TCAT  ')'          +
                                     *BCAT  'REPLACE('   +
                                     *TCAT  '*YES'       +
                                     *TCAT  ')'          +
                                     *BCAT  'TEXT('''    +
                                     *TCAT  &TEXT        +
                                     *TCAT  ''')'        +
                                     *BCAT  'TGTRLS('    +
                                     *TCAT  &TGTRLS      +
                                     *TCAT  ')'          +
                                     *BCAT  'DETAIL('    +
                                     *TCAT  '*BASIC'     +
                                     *TCAT  ')'          +
                                     )

/* ----------------- */
/* Besondere         */
/* Berechtigungen    */
/* ----------------- */
             IF         COND(&MBR *EQ 'PEEK53') THEN(DO)
               CHGVAR     VAR(&CMD) VALUE(&CMD          +
                                    *BCAT  'USRPRF('    +
                           /*       *TCAT  *OWNER       +     */ +
                                    *TCAT  *USER        +
                                    *TCAT  ')'          +
                                    )
             ENDDO

/* ----------------- */
/* Aktiv.-Gruppe     */
/* ----------------- */
             IF         COND(&MBR *EQ 'PEEK'          +
                        *OR  &MBR *EQ 'TREE'          +
                        *OR  &MBR *EQ 'PEEK95'        +
                        *OR  &MBR *EQ 'PEEK96'        +
                        *OR  &MBR *EQ 'PEEK97'        +
                        *OR  &MBR *EQ 'PEEK98'        +
                        *OR  &MBR *EQ 'PEEK99'        +
                        *OR  &MBR *EQ 'PEEKUPDATE'    +
                        *OR  &MBR *EQ 'PEEKCLONE'     +
                        *OR  &MBR *EQ 'PEEKINIT'      +
                        *OR  &MBR *EQ 'PEEKINIT1'     +
                        *OR  &MBR *EQ 'PEEKINIT2'     +
                        *OR  &MBR *EQ 'PEEKINIT3'     +
                        ) THEN(DO)
                CHGVAR     VAR(&CMD) VALUE(&CMD          +
                                     *BCAT  'ACTGRP('    +
                                     *TCAT  '*CALLER'    +
                                     *TCAT  ')'          +
                                     )
             ENDDO
             ELSE       CMD(DO)
                CHGVAR     VAR(&CMD) VALUE(&CMD         +
                                     *BCAT  'ACTGRP('    +
                                     *TCAT  'PEEK'       +
                                     *TCAT  ')'          +
                                     )
             ENDDO

/* ----------------- */
/* Pgm/SrvPgm        */
/* Erstellen         */
/* ----------------- */
CRT_OBJ:
             IF         COND(&RMV_DEVLIB *AND &IS_INSTALL) THEN(DO)
                RMVLIBLE   LIB(&DEVLIB)
                CHGVAR     VAR(&IS_REMOVED) VALUE(&TRUE)
             ENDDO

             CALL       PGM(QCMDEXC) PARM(&CMD &CMDLEN)

             DLTSPLF    FILE(&MBR) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

             CALL       PGM(&DevLib/PEEK96B) PARM(&MBR &OBJLIB &OBJTYPE)

             IF         COND(&IS_REMOVED) THEN(DO)
                ADDLIBLE   LIB(&DEVLIB) POSITION(*AFTER &OBJLIB)
                CHGVAR     VAR(&IS_REMOVED) VALUE(&FALSE)
             ENDDO

   /* ----------------- */
   /* Module            */
   /* löschen           */
   /* ----------------- */
             CHGVAR     VAR(&CMD) VALUE('DLTMOD'      +
                                  *BCAT  'MODULE('    +
                                  *TCAT  &OBJLIB      +
                                  *TCAT  '/'          +
                                  *TCAT  &MBRLIST     +
                                  *TCAT  ')'          +
                                  )
             CALL       PGM(QCMDEXC) PARM(&CMD &CMDLEN)
             MONMSG     MSGID(CPF0000)

ENDE:
             IF         COND(&IS_REMOVED) THEN(DO)
                ADDLIBLE   LIB(&DEVLIB) POSITION(*AFTER &OBJLIB)
                CHGVAR     VAR(&IS_REMOVED) VALUE(&FALSE)
             ENDDO

             DLTOVR     FILE(*ALL) LVL(*JOB)
             MONMSG     MSGID(CPF0000)

             RCLRSC     LVL(*)
             MONMSG     MSGID(CPF0000)

/* Verschiebe alle *DIAG Nachrichten zur             */
/* vorangegangenen Programmwarteschlange             */
             CHGVAR     VAR(&ERRMSGTYP) VALUE('*DIAG')
             CALL       PGM(QMHMOVPM) PARM(&ERRMSGKEY &ERRMSGTYP +
                          &ERRNBRTYP &ERRPGMMSGQ &ERRSTKCTR &ERRCODE)

             IF         COND(&ERROR) THEN(DO)
                /* Sende letzte *ESCAPE nochmals   */
                CALL       PGM(QMHRSNEM) PARM(&ERRMSGKEY &ERRCODE)
             ENDDO

             RETURN

/* ---------------- */
/* Error            */
/* Handling         */
/* ---------------- */
 ERROR:
             IF         COND(&ERROR) THEN(GOTO CMDLBL(ENDE))
             ELSE       CHGVAR     VAR(&ERROR) VALUE('1')

/* Verschiebe alle *DIAG Nachrichten zur             */
/* vorangegangenen Programmwarteschlange             */
             CHGVAR     VAR(&ERRMSGTYP) VALUE('*DIAG')
             CALL       PGM(QMHMOVPM) PARM(&ERRMSGKEY &ERRMSGTYP +
                          &ERRNBRTYP &ERRPGMMSGQ &ERRSTKCTR &ERRCODE)

             GOTO       CMDLBL(ENDE)

             ENDPGM

