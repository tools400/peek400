             PGM        PARM(&DEVLIB)

             DCL        VAR(&DEVLIB)  TYPE(*CHAR) LEN(10)
             DCL        VAR(&SRCFILE) TYPE(*CHAR) LEN(10)
             DCL        VAR(&SRCMBR)  TYPE(*CHAR) LEN(10)

             DCL        VAR(&TGTRLS)  TYPE(*CHAR) LEN(10) VALUE('V7R1M0')

             /* GOTO       CMDLBL(CRTOBJ) */

             /* ---------------------------------------------------- */
             /*  Create utility CRTMSGDS                             */
             /* ---------------------------------------------------- */

             CRTMSGF    MSGF(&DEVLIB/CRTMSGDS) +
                          TEXT('Create Message Data Structure Utility')

             CRTCLPGM   PGM(QTEMP/#MSG_GER) +
                          SRCFILE(&DEVLIB/QCRTMSGDS) SRCMBR(*PGM)

             CALL       PGM(QTEMP/#MSG_GER) PARM(&DEVLIB)

             DLTPGM     PGM(QTEMP/#MSG_GER)

             CRTCMD     CMD(&DEVLIB/CRTMSGDS) PGM(&DEVLIB/CRTMSGDSC) +
                          SRCFILE(&DEVLIB/QCRTMSGDS) SRCMBR(*CMD) +
                          HLPPNLGRP(&DEVLIB/CRTMSGDSP) +
                          HLPID(CRTMSGDS)

             CRTPNLGRP  PNLGRP(&DEVLIB/CRTMSGDSP) +
                          SRCFILE(&DEVLIB/QCRTMSGDS) SRCMBR(*PNLGRP)

             CRTCLMOD   MODULE(&DEVLIB/CRTMSGDSC) +
                          SRCFILE(&DEVLIB/QCRTMSGDS) SRCMBR(*MODULE) +
                          DBGVIEW(*LIST) TGTRLS(&TGTRLS)

             CRTRPGMOD  MODULE(&DEVLIB/CRTMSGDSR1) +
                          SRCFILE(&DEVLIB/QCRTMSGDS) SRCMBR(*MODULE) +
                          TRUNCNBR(*NO) DBGVIEW(*LIST) TGTRLS(&TGTRLS)

             CRTRPGMOD  MODULE(&DEVLIB/CRTMSGDSR2) +
                          SRCFILE(&DEVLIB/QCRTMSGDS) SRCMBR(*MODULE) +
                          TRUNCNBR(*NO) DBGVIEW(*LIST) TGTRLS(&TGTRLS)

             CRTPGM     PGM(&DEVLIB/CRTMSGDSC) +
                          MODULE(&DEVLIB/CRTMSGDSC +
                                 &DEVLIB/CRTMSGDSR1 &DEVLIB/CRTMSGDSR2) +
                          ACTGRP(*NEW) TGTRLS(&TGTRLS)

             DLTMOD     MODULE(&DEVLIB/CRTMSGDS*)

             /* ---------------------------------------------------- */
             /*  Create compile data area                            */
             /* ---------------------------------------------------- */

             CRTDTAARA  DTAARA(&DEVLIB/PEEKPGM) TYPE(*CHAR) LEN(400) +
                          TEXT('Peek/400 - Generierungsangaben')

             CHGDTAARA  DTAARA(&DEVLIB/PEEKPGM *ALL) VALUE( +
                          '*LIST     VnRnMn                                  '   *CAT +
                          '                                                  '   *CAT +
                          'DEBUG(*YES) DECEDIT(''0,'') DATEDIT(*DMY.)          ' *CAT +
                          'DATFMT(*ISO) TIMFMT(*ISO)                         '   *CAT +
                          'EXTBININT(*YES) OPTION(*SRCSTMT : *NODEBUGIO)     '   *CAT +
                          'ALWNULL(*USRCTL)                                  '   *CAT +
                          'COPYRIGHT(''(c) 1997-2021 by Thomas Raddatz'')      ')

             CHGDTAARA  DTAARA(&DEVLIB/PEEKPGM (11 10)) VALUE(&TGTRLS)

             /* ---------------------------------------------------- */
             /*  Create file and add initial data                    */
             /* ---------------------------------------------------- */

             CRTPF      FILE(&DEVLIB/EXIT01PF) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          TEXT('Peek/400 - Sicherheitsattribute für EXIT01')

