     /* ============================================================ */
     /*                                                              */
     /*  (c) Thomas Raddatz                                          */
     /*                                                              */
     /*  Bereich  : PEEK                                             */
     /*  Programm : #INITDEV                                         */
     /*  Typ      : CLLE                                             */
     /*                                                              */
     /* ============================================================ */
     /*                                                              */
     /*  Dokumentation:                                              */
     /*                                                              */
     /*  Initialize Development Library                              */
     /*                                                              */
     /* ============================================================ */
     /* >>PRE-COMPILER<<                                             */
     /*   >>CRTCMD<< CRTBNDCL PGM(&LI/&OB) +                         */
     /*                       SRCFILE(&SL/&SF) SRCMBR(&SM) +         */
     /*                       DFTACTGRP(*NO) ACTGRP(*NEW) +          */
     /*                       TGTRLS(V7R3M0);                        */
     /*   >>CMD<<    CRTCMD   CMD(&LI/CRTPEEKOBJ) +                  */
     /*                       SRCFILE(&SL/QCMDSRC) SRCMBR(*CMD) +    */
     /*                       PGM(&LI/PEEK99);                       */
     /*   >>EXECUTE<<                                                */
     /* >>END-PRE-COMPILER<<                                         */
     /* ============================================================ */
             PGM        PARM(&DEVLIB)

             DCL        VAR(&DEVLIB)  TYPE(*CHAR) LEN(10)
             DCL        VAR(&SRCFILE) TYPE(*CHAR) LEN(10)
             DCL        VAR(&SRCMBR)  TYPE(*CHAR) LEN(10)

             DCL        VAR(&TGTRLS)  TYPE(*CHAR) LEN(10) VALUE('V7R3M0')

             /* GOTO       CMDLBL(CRTOBJ) */

             /* ---------------------------------------------------- */
             /*  Create XML installation utility.                    */
             /* ---------------------------------------------------- */

             CRTBNDRPG  PGM(QTEMP/A_XMLINST) SRCFILE(&DEVLIB/QXML) +
                          SRCMBR(*PGM) DBGVIEW(*LIST) TGTRLS(&TGTRLS)

             /* ---------------------------------------------------- */
             /*  Create utility CRTMSGDS                             */
             /* ---------------------------------------------------- */

             CALL       PGM(QTEMP/A_XMLINST) +
                          PARM('CRTMSGDS' 'QXML' &DEVLIB '' 'GER' &TGTRLS)

             /* ---------------------------------------------------- */
             /*  Create service program BASICS1                      */
             /* ---------------------------------------------------- */

             CALL       PGM(QTEMP/A_XMLINST) +
                          PARM('BASICS1' 'QXML' &DEVLIB '' 'NO C_YES' &TGTRLS)

             /* ---------------------------------------------------- */
             /*  Create service program PRTLOG                       */
             /* ---------------------------------------------------- */

             CALL       PGM(QTEMP/A_XMLINST) +
                          PARM('PRTLOG' 'QXML' &DEVLIB '' 'NO' &TGTRLS)

             /* ---------------------------------------------------- */
             /*  Delete XML installation utility.                    */
             /* ---------------------------------------------------- */

             DLTPGM     PGM(QTEMP/A_XMLINST)

             /* ---------------------------------------------------- */
             /*  Create compile data area                            */
             /* ---------------------------------------------------- */

             CHKOBJ     OBJ(&DEVLIB/PEEKPGM) OBJTYPE(*DTAARA)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTDTAARA  DTAARA(&DEVLIB/PEEKPGM) TYPE(*CHAR) LEN(400) +
                            TEXT('Peek/400 - Generierungsangaben')
             ENDDO

             CHGDTAARA  DTAARA(&DEVLIB/PEEKPGM *ALL) VALUE( +
                          '*LIST     VnRnMn                                  '   *CAT +
                          '                                                  '   *CAT +
                          'DEBUG(*YES) DECEDIT(''0,'') DATEDIT(*DMY.)          ' *CAT +
                          'DATFMT(*ISO) TIMFMT(*ISO)                         '   *CAT +
                          'EXTBININT(*YES) OPTION(*SRCSTMT : *NODEBUGIO)     '   *CAT +
                          'ALWNULL(*USRCTL)                                  '   *CAT +
                          'COPYRIGHT(''(c) 1997-2021 by Thomas Raddatz'')      ')

             CHGDTAARA  DTAARA(&DEVLIB/PEEKPGM (11 10)) VALUE(&TGTRLS)

             /* ---------------------------------------------------- */
             /*  Create PEEK compile program                         */
             /* ---------------------------------------------------- */

             CRTBNDCL   PGM(&DEVLIB/PEEK99) +
                          SRCFILE(&DEVLIB/QRPGLESRC) SRCMBR(*PGM) DFTACTGRP(*YES) +
                          TGTRLS(&TGTRLS)
             CRTBNDCL   PGM(&DEVLIB/PEEK96B) +
                          SRCFILE(&DEVLIB/QRPGLESRC) SRCMBR(*PGM) DFTACTGRP(*YES) +
                          TGTRLS(&TGTRLS)
             CRTCMD     CMD(&DEVLIB/CRTPEEKOBJ) +
                          SRCFILE(&DEVLIB/QCMDSRC) SRCMBR(*CMD) +
                          PGM(&DEVLIB/PEEK99)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK99')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK96B')
             CALLSUBR   SUBR(CMPOBJ)

             /* ---------------------------------------------------- */
             /*  Create working source file                          */
             /* ---------------------------------------------------- */
             CHKOBJ     OBJ(&DEVLIB/QPEEKGEN) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTSRCPF   FILE(&DEVLIB/QPEEKGEN) RCDLEN(112) +
                          TEXT('Peek/400 - Generated Sources(dummy)')
             ENDDO

             /* ---------------------------------------------------- */
             /*  Create files of exit programs                       */
             /* ---------------------------------------------------- */

             DLTF       FILE(&DEVLIB/EXIT01PF)
             MONMSG     MSGID(CPF2105)

             CRTPF      FILE(&DEVLIB/EXIT01PF) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          TEXT('Peek/400 - Sicherheitsattribute für EXIT01')

             DLTF       FILE(&DEVLIB/EXIT04LOG)
             MONMSG     MSGID(CPF2105)

             RUNSQLSTM  SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(EXIT04LOG) +
                          COMMIT(*NONE) NAMING(*SQL) DATFMT(*ISO) TIMFMT(*ISO) +
                          DFTRDBCOL(&DEVLIB)

             /* ---------------------------------------------------- */
             /*  Create Peek/400 files and add initial data          */
             /* ---------------------------------------------------- */

             DLTF       FILE(&DEVLIB/PEEKFLDL0)
             MONMSG     MSGID(CPF2105)

             DLTF       FILE(&DEVLIB/PEEKFLDL1)
             MONMSG     MSGID(CPF2105)

             DLTF       FILE(&DEVLIB/PEEKFLDL2)
             MONMSG     MSGID(CPF2105)

             DLTF       FILE(&DEVLIB/PEEKFLD)
             MONMSG     MSGID(CPF2105)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKFLD')
             CALLSUBR   SUBR(CMPOBJ)

             CRTLF      FILE(&DEVLIB/PEEKFLDL0) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          TEXT('Peek/400 - Satzaufbau')

             CRTLF      FILE(&DEVLIB/PEEKFLDL1) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          TEXT('Peek/400 - Satzaufbau')

             CRTLF      FILE(&DEVLIB/PEEKFLDL2) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          TEXT('Peek/400 - Satzaufbau')

             DLTF       FILE(&DEVLIB/PEEKFMT)
             MONMSG     MSGID(CPF2105)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKFMT')
             CALLSUBR   SUBR(CMPOBJ)

             DLTF       FILE(&DEVLIB/PEEKWRK)
             MONMSG     MSGID(CPF2105)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKWRK')
             CALLSUBR   SUBR(CMPOBJ)

             CHKOBJ     OBJ(&DEVLIB/PEEKENV) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
               CHGVAR     VAR(&SRCMBR) VALUE('PEEKENV')
               CALLSUBR   SUBR(CMPOBJ)
             ENDDO

             CLRPFM     FILE(&DEVLIB/EXIT01PF)
             CLRPFM     FILE(&DEVLIB/EXIT04LOG)

             CLRPFM     FILE(&DEVLIB/PEEKENV)
             CLRPFM     FILE(&DEVLIB/PEEKFLD)
             CLRPFM     FILE(&DEVLIB/PEEKFMT)
             CLRPFM     FILE(&DEVLIB/PEEKWRK)

             CHKOBJ     OBJ(&DEVLIB/PEEKUSR) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
               CHGVAR     VAR(&SRCMBR) VALUE('PEEKUSR')
               CALLSUBR   SUBR(CMPOBJ)
               RUNSQLSTM  SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(PEEKUSRDTA) +
                            COMMIT(*NONE) NAMING(*SQL) DATFMT(*ISO) TIMFMT(*ISO) +
                            DFTRDBCOL(&DEVLIB)
             ENDDO

             /* ---------------------------------------------------- */
             /*  Remove old binding directory entries                */
             /* ---------------------------------------------------- */

             DLTBNDDIR  BNDDIR(&DEVLIB/PEEK)
             MONMSG     MSGID(CPF2110 CPF2105) /* Library/Object not found */
             CRTBNDDIR  BNDDIR(&DEVLIB/PEEK) TEXT('Peek/400 Binding Directory')

             /* ---------------------------------------------------- */
             /*  Create PEEK commands required for next step         */
             /* ---------------------------------------------------- */

             CHGVAR     VAR(&SRCFILE) VALUE('QCMDSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKINIT')
             CALLSUBR   SUBR(CMPOBJ)

             /* ---------------------------------------------------- */
             /*  Create other PEEK helper programs                   */
             /* ---------------------------------------------------- */

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK94')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK95')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK96')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK96A')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK96B')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK97')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK99')
             CALLSUBR   SUBR(CMPOBJ)

             /* ---------------------------------------------------- */
             /*  Create message file                                 */
             /* ---------------------------------------------------- */

             CHKOBJ     OBJ(&DEVLIB/PEEKENG) OBJTYPE(*MSGF)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTMSGF    MSGF(&DEVLIB/PEEKENG) +
                            TEXT('Peek/400 - Englische übersetzung') CCSID(*HEX)
             ENDDO
             CRTCLPGM   PGM(&DEVLIB/PEEKENG) +
                          SRCFILE(&DEVLIB/QMSG_ENG) SRCMBR(*PGM) TGTRLS(&TGTRLS)
             CALL       PGM(&DEVLIB/PEEKENG) PARM(&DEVLIB 'PEEKENG')

             CHKOBJ     OBJ(&DEVLIB/PEEKFRA) OBJTYPE(*MSGF)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTMSGF    MSGF(&DEVLIB/PEEKFRA) +
                            TEXT('Peek/400 - Französische übersetzung') CCSID(*HEX)
             ENDDO
             CRTCLPGM   PGM(&DEVLIB/PEEKFRA) +
                          SRCFILE(&DEVLIB/QMSG_FRA) SRCMBR(*PGM) TGTRLS(&TGTRLS)
             CALL       PGM(&DEVLIB/PEEKFRA) PARM(&DEVLIB 'PEEKFRA')

             CHKOBJ     OBJ(&DEVLIB/PEEKGER) OBJTYPE(*MSGF)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTMSGF    MSGF(&DEVLIB/PEEKGER) +
                            TEXT('Peek/400 - Deutsche übersetzung') CCSID(*HEX)
             ENDDO
             CRTCLPGM   PGM(&DEVLIB/PEEKGER) +
                          SRCFILE(&DEVLIB/QMSG_GER) SRCMBR(*PGM) TGTRLS(&TGTRLS)
             CALL       PGM(&DEVLIB/PEEKGER) PARM(&DEVLIB 'PEEKGER')

             CHKOBJ     OBJ(&DEVLIB/PEEKITA) OBJTYPE(*MSGF)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTMSGF    MSGF(&DEVLIB/PEEKITA) +
                            TEXT('Peek/400 - Italienische übersetzung') CCSID(*HEX)
             ENDDO
             CRTCLPGM   PGM(&DEVLIB/PEEKITA) +
                          SRCFILE(&DEVLIB/QMSG_ITA) SRCMBR(*PGM) TGTRLS(&TGTRLS)
             CALL       PGM(&DEVLIB/PEEKITA) PARM(&DEVLIB 'PEEKITA')

             CHKOBJ     OBJ(&DEVLIB/PEEKSPA) OBJTYPE(*MSGF)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTMSGF    MSGF(&DEVLIB/PEEKSPA) +
                            TEXT('Peek/400 - Spanische übersetzung') CCSID(*HEX)
             ENDDO
             CRTCLPGM   PGM(&DEVLIB/PEEKSPA) +
                          SRCFILE(&DEVLIB/QMSG_SPA) SRCMBR(*PGM) TGTRLS(&TGTRLS)
             CALL       PGM(&DEVLIB/PEEKSPA) PARM(&DEVLIB 'PEEKSPA')

             /* ---------------------------------------------------- */
             /*  Create command: PEEK                                */
             /* ---------------------------------------------------- */
CRTOBJ:

             CHGVAR     VAR(&SRCFILE) VALUE('QCMDSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QCMDSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKENG')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QCMDSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKFRA')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QCMDSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKGER')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QCMDSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKITA')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QCMDSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKSPA')
             CALLSUBR   SUBR(CMPOBJ)

             /* ---------------------------------------------------- */
             /*  Create command: TREE                                */
             /* ---------------------------------------------------- */

             CHGVAR     VAR(&SRCFILE) VALUE('QCMDSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('TREE')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QCMDSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('TREEENG')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QCMDSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('TREEFRA')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QCMDSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('TREEGER')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QCMDSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('TREEITA')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QCMDSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('TREESPA')
             CALLSUBR   SUBR(CMPOBJ)

             /* ---------------------------------------------------- */
             /*  Create command: PEEKCLONE                           */
             /* ---------------------------------------------------- */

             CHGVAR     VAR(&SRCFILE) VALUE('QCMDSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKCLONE')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKCLONE2')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKCLONE1')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKCLONE')
             CALLSUBR   SUBR(CMPOBJ)

             /* ---------------------------------------------------- */
             /*  Create command: PEEKINIT                            */
             /* ---------------------------------------------------- */

             CHGVAR     VAR(&SRCFILE) VALUE('QCMDSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKINIT')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKINIT3')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKINIT2')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKINIT1')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKINIT')
             CALLSUBR   SUBR(CMPOBJ)

             /* ---------------------------------------------------- */
             /*  Create command: PEEKDST                             */
             /* ---------------------------------------------------- */

             CHGVAR     VAR(&SRCFILE) VALUE('QCMDSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKDST')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKDST')
             CALLSUBR   SUBR(CMPOBJ)

             /* ---------------------------------------------------- */
             /*  Create service programs                             */
             /* ---------------------------------------------------- */

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK61') /* Progress Meter */
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK58') /* Allgemeine Routinen */
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK53') /* Zugriff auf Benutzerdaten */
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK63C') /* Dateizugriffsroutinen */
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK63') /* Dateizugriffsroutinen */
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK51') /* SQL-Komponente */
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK71') /* Character Translation Services */
             CALLSUBR   SUBR(CMPOBJ)

             /* ---------------------------------------------------- */
             /*  Compile PEEK application display & printer files    */
             /* ---------------------------------------------------- */

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK05FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK12FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK14FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK17FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK24FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK25FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK26FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK30FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK34FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK37FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK40FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK45FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK47FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK48FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK49FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK50FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK52FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK56FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK57FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK59FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK64FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK68FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK69FM')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QDDSSRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK65P')
             CALLSUBR   SUBR(CMPOBJ)

             /* ---------------------------------------------------- */
             /*  Compile PEEK application program                    */
             /* ---------------------------------------------------- */

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('EXIT01')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('EXIT02')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('EXIT03')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('EXIT04')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('EXIT05')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKUPD2')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKUPD1')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEKUPDATE')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK00')
             CALLSUBR   SUBR(CMPOBJ)

             CHGVAR     VAR(&SRCFILE) VALUE('QRPGLESRC')
             CHGVAR     VAR(&SRCMBR) VALUE('PEEK01')
