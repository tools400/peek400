     /* ============================================================ */
     /*                                                              */
     /*  (c) Thomas Raddatz                                          */
     /*                                                              */
     /*  Bereich  : PEEK, Version 2.2.0                              */
     /*  Programm : PEEK96                                           */
     /*  Typ      : CLP                                              */
     /*                                                              */
     /*  erstellt : 23.01.1998  Raddatz                              */
     /*  geändert : 22.07.1999  für Version 2.2.0                    */
     /*  geändert : 20.04.2007  für Version 3.0.0                    */
     /*                                                              */
     /* ============================================================ */
     /*                                                              */
     /*  Dokumentation:                                              */
     /*                                                              */
     /*  Erstellen PEEK Distributions-Bibliothek                     */
     /*                                                              */
     /* ============================================================ */
     /*                                                              */
     /*  Aufrufen Programm:                                          */
     /*                                                              */
     /*     CALL PGM(PEEK96) PARM('PEEK326P' '*ALL')                 */
     /*                                                              */
     /*  Mögliche Werte für Parameter &DbgViewX (siehe PEEK99):      */
     /*     *NONE      Programme ohne Debug View erstellen           */
     /*     *ALL       Programme mit allen Debug Views erstellen     */
     /* ============================================================ */
     /* >>PRE-COMPILER<<                                             */
     /*   >>CRTCMD<< &LI/CRTPEEKOBJ SRCFILE(&SL/&SF) SRCMBR(&SM) +   */
     /*                           OBJLIB(&LI) DEVLIB(&LI) +          */
     /*                           SBMJOB(*NO) BNDDIR(PEEK) +         */
     /*                           INSTALL(*NO);                      */
     /*   >>EXECUTE<<                                                */
     /* >>END-PRE-COMPILER<<                                         */
     /* ============================================================ */

          PGM        PARM(&DevLib     +
                          &DbgViewX   +
                          )

             DCLF       FILE(*LIBL/QAFDMBRL) RCDFMT(*ALL)

             DCL        VAR(&DEVLIB    ) TYPE(*CHAR) LEN(10)
             DCL        VAR(&DBGVIEWX  ) TYPE(*CHAR) LEN(10)

             DCL        VAR(&V         ) TYPE(*CHAR) LEN( 1)
             DCL        VAR(&R         ) TYPE(*CHAR) LEN( 1)
             DCL        VAR(&M         ) TYPE(*CHAR) LEN( 1)
             DCL        VAR(&VERSION   ) TYPE(*CHAR) LEN(10)
             DCL        VAR(&TEXT      ) TYPE(*CHAR) LEN(50)
             DCL        VAR(&IS_ADDED  ) TYPE(*CHAR) LEN( 1) VALUE('0')
             DCL        VAR(&TRUE      ) TYPE(*CHAR) LEN( 1) VALUE('1')
             DCL        VAR(&FALSE     ) TYPE(*CHAR) LEN( 1) VALUE('0')

             DCL        VAR(&NEWLIB    ) TYPE(*CHAR) LEN(10) VALUE('PEEK')
             DCL        VAR(&DBGVIEW   ) TYPE(*CHAR) LEN(10) VALUE('*NONE')
             DCL        VAR(&TGTRLS    ) TYPE(*CHAR) LEN(10) VALUE('V7R3M0')

             DCL        VAR(&DATE_DMY  ) TYPE(*CHAR) LEN( 6)
             DCL        VAR(&DATE_ISO  ) TYPE(*CHAR) LEN(10)
             DCL        VAR(&YEAR      ) TYPE(*CHAR) LEN( 4)

/* Fehlerbehandlung     */
             DCL        VAR(&ERROR)      TYPE(*LGL) +
                          VALUE('0')
             DCL        VAR(&ERRMSGKEY)  TYPE(*CHAR) LEN(4)

             DCL        VAR(&ERRMSGTYP)  TYPE(*CHAR) LEN(10) +
                          VALUE('*DIAG')
             DCL        VAR(&ERRNBRTYP)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRPGMMSGQ) TYPE(*CHAR) LEN(10) +
                          VALUE('*')
             DCL        VAR(&ERRSTKCTR)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRCODE  )  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000000')

/* Sende alle Fehler zur Error Handling Routine */
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CHGVAR     VAR(&ERROR    ) VALUE('0')

 /* -------------------------------------------------------------- */
 /*  Los geht's                                                    */
 /* -------------------------------------------------------------- */

             CHGVAR     VAR(&DBGVIEW) VALUE(&DBGVIEWX)
             MONMSG     MSGID(MCH3601) EXEC(DO)
                RMVMSG     PGMQ(*SAME (*)) CLEAR(*ALL)
             ENDDO

 /* Version    */
             CHGVAR     VAR(&V) VALUE(%SST(&DEVLIB  5 1))
             CHGVAR     VAR(&R) VALUE(%SST(&DEVLIB  6 1))
             CHGVAR     VAR(&M) VALUE(%SST(&DEVLIB  7 1))

             CHGVAR     VAR(&VERSION) VALUE(      &V *tcat '.'  +
                                            *tcat &R *tcat '.'  +
                                            *tcat &M            )

 /* Bibliothek */
             CRTLIB     LIB(&NEWLIB) +
                        TYPE(*TEST) +
                        TEXT('Peek/400 - PEEK, Version' *bcat &version      +
                                                        *tcat ' - ('        +
                                                        *tcat &tgtrls       +
                                                        *tcat ')')          +
                        CRTAUT(*ALL)
         /*  CALL       PGM(&DevLib/PEEK96B) PARM(&NEWLIB '*N' '*LIB')          */

 /* Binderverzeichnis */
             CRTBNDDIR  BNDDIR(&NEWLIB/PEEK) +
                        TEXT('Peek/400 - Binderverzeichnis')
             ADDBNDDIRE BNDDIR(&NEWLIB/PEEK) +
                        OBJ((&NEWLIB/PEEK51 *SRVPGM) +
                            (&NEWLIB/PEEK53 *SRVPGM) +
                            (&NEWLIB/PEEK58 *SRVPGM) +
                            (&NEWLIB/PEEK61 *SRVPGM) +
                            (&NEWLIB/PEEK63 *SRVPGM) +
                            (&NEWLIB/PEEK71 *SRVPGM))

 /* Bibl.-Liste */
             CHGVAR     VAR(&IS_ADDED) VALUE(&TRUE)

             ADDLIBLE   LIB(&NEWLIB) POSITION(*FIRST)
             MONMSG     MSGID(CPF2103) EXEC(DO)
               CHGVAR     VAR(&IS_ADDED) VALUE(&FALSE)
             ENDDO

 /* PEEKPGM    */
             RTVSYSVAL  SYSVAL(QDATE) RTNVAR(&DATE_DMY)
             CVTDAT     DATE(&DATE_DMY) TOVAR(&DATE_ISO) +
                          FROMFMT(*DMY) TOFMT(*ISO)
             CHGVAR     VAR(&YEAR) VALUE(%SST(&DATE_ISO 1 4))

             CRTDTAARA  DTAARA(&NEWLIB/PEEKPGM) TYPE(*CHAR) LEN(400) +
                          TEXT('Peek/400 - Generierungsangaben')
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (  1  10)) VALUE(&DBGVIEW)
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM ( 11  10)) VALUE(&TGTRLS)
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (101  11)) +
                          VALUE('DEBUG(*NO )')
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (113  13)) +
                          VALUE('DECEDIT(''0,'')')
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (127  14)) +
                          VALUE('DATEDIT(*DMY.)')
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (151  12)) +
                          VALUE('DATFMT(*ISO)')
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (164  12)) +
                          VALUE('TIMFMT(*ISO)')
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (201  15)) +
                          VALUE('EXTBININT(*YES)')
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (217  29)) +
                          VALUE(' ')  /* OPTION(*SRCSTMT : *NODEBUGIO) */
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (251  16)) +
                          VALUE('ALWNULL(*USRCTL)')
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (301 100)) +
                          VALUE('COPYRIGHT(''(c) 1997-' *CAT &YEAR *CAT +
                                 ' by Thomas Raddatz'')')

 /* -------------------------------------------------------------- */
 /* QEXAMPLE   */
             CRTSRCPF   FILE(&NEWLIB/QEXAMPLE) +
                          RCDLEN(112)          +
                          TEXT('Peek/400 - Beispiel- und Exit-Programme')
             CPYF       FROMFILE(&DEVLIB/QRPGLESRC) +
                          TOFILE(&NEWLIB/QEXAMPLE) FROMMBR(EXIT01)   +
                          TOMBR(*FROMMBR) MBROPT(*REPLACE) +
                          FMTOPT(*MAP)
             CPYF       FROMFILE(&DEVLIB/QRPGLESRC) +
                          TOFILE(&NEWLIB/QEXAMPLE) FROMMBR(EXIT02)   +
                          TOMBR(*FROMMBR) MBROPT(*REPLACE) +
                          FMTOPT(*MAP)
             CPYF       FROMFILE(&DEVLIB/QRPGLESRC) +
                          TOFILE(&NEWLIB/QEXAMPLE) FROMMBR(EXIT03)   +
                          TOMBR(*FROMMBR) MBROPT(*REPLACE) +
                          FMTOPT(*MAP)
             CPYF       FROMFILE(&DEVLIB/QRPGLESRC) +
                          TOFILE(&NEWLIB/QEXAMPLE) FROMMBR(EXIT04)   +
                          TOMBR(*FROMMBR) MBROPT(*REPLACE) +
                          FMTOPT(*MAP)
             CPYF       FROMFILE(&DEVLIB/QRPGLESRC) +
                          TOFILE(&NEWLIB/QEXAMPLE) FROMMBR(EXIT05)   +
                          TOMBR(*FROMMBR) MBROPT(*REPLACE) +
                          FMTOPT(*MAP)
             CPYF       FROMFILE(&DEVLIB/QRPGLESRC) +
                          TOFILE(&NEWLIB/QEXAMPLE) FROMMBR(EXIT06)   +
                          TOMBR(*FROMMBR) MBROPT(*REPLACE) +
                          FMTOPT(*MAP)
             CPYF       FROMFILE(&DEVLIB/QDDSSRC  ) +
                          TOFILE(&NEWLIB/QEXAMPLE) FROMMBR(EXIT01PF) +
                          TOMBR(*FROMMBR) MBROPT(*REPLACE) +
                          FMTOPT(*MAP)
             CPYF       FROMFILE(&DEVLIB/QDDSSRC  ) +
                          TOFILE(&NEWLIB/QEXAMPLE) FROMMBR(EXIT04LOG) +
                          TOMBR(*FROMMBR) MBROPT(*REPLACE) +
                          FMTOPT(*MAP)
             CRTMSGDS   RANGE(USR1000 USR1999) +
                          MSGF(&DEVLIB/PEEKGER) +
                          FILE(&NEWLIB/QEXAMPLE) MBR(*GEN) +
                          REPLACE(*YES) TYPE(*ILERPG) DEFINE(*NO)

 /* -------------------------------------------------------------- */
 /* PEEKSRC    */
             CRTSRCPF   FILE(&NEWLIB/PEEKSRC) RCDLEN(112) +
                          TEXT('Peek/400 - Template für Programme')
             CPYF       FROMFILE(&DEVLIB/PEEKSRC) +
                          TOFILE(&NEWLIB/PEEKSRC) FROMMBR(PGM) +
                          TOMBR(PGM) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/PEEKSRC) +
                          TOFILE(&NEWLIB/PEEKSRC) FROMMBR(DSPF) +
                          TOMBR(DSPF) MBROPT(*REPLACE) CRTFILE(*NO)

 /* -------------------------------------------------------------- */
 /* QCOPYLE    */
             CRTSRCPF   FILE(&NEWLIB/QCOPYLE) RCDLEN(112) +
