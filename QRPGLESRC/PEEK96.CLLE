 /* QCMDSRC    */
             CRTSRCPF   FILE(&NEWLIB/QCMDSRC ) +
                          RCDLEN(92)           +
                          TEXT('Peek/400 - Befehle')

             CPYF       FROMFILE(&DEVLIB/QCMDSRC) +
                          TOFILE(&NEWLIB/QCMDSRC) FROMMBR(PEEK    ) +
                          TOMBR(PEEK    ) MBROPT(*REPLACE) CRTFILE(*NO)

             CPYF       FROMFILE(&DEVLIB/QCMDSRC) +
                          TOFILE(&NEWLIB/QCMDSRC) FROMMBR(TREE    ) +
