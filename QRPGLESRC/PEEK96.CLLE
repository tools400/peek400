             CPYF       FROMFILE(&DEVLIB/QMSG_GER) +
                          TOFILE(&NEWLIB/QMSG_GER) FROMMBR(PEEKGERMG ) +
                          TOMBR(PEEKGERMG ) MBROPT(*REPLACE) CRTFILE(*NO)

             CPYF       FROMFILE(&DEVLIB/QMSG_GER) +
