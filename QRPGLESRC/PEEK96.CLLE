             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(COPYRIGHT ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(D_VARDEF  ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(FLDL0100  ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(H_SPEC    ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(PEXIT01   ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(PEXIT02   ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(PEXIT03   ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(PEXIT04   ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(PEXIT05   ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(PEXIT06   ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(PPEEK21   ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(PPEEK23   ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(PPEEK32   ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(PPEEK45   ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(PPEEK53   ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(PPEEK58   ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(PPEEK59   ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(PPEEK64   ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(PUPDPGM   ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(QCMDEXC   ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(QTNRCMTI  ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(SDS       ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(USR1000   ) +
                          TOMBR(*FROMMBR ) MBROPT(*REPLACE) CRTFILE(*NO)

 /* -------------------------------------------------------------- */
 /* QMSG_ENG   */
             CRTSRCPF   FILE(&NEWLIB/QMSG_ENG) +
                          RCDLEN(112)          +
                          CCSID(1140)          +
                          TEXT('Peek/400 - English (1140)')

             CPYF       FROMFILE(&DEVLIB/QMSG_ENG) +
                          TOFILE(&NEWLIB/QMSG_ENG) FROMMBR(PEEKENGMG ) +
                          TOMBR(PEEKENGMG ) MBROPT(*REPLACE) CRTFILE(*NO)

             CPYF       FROMFILE(&DEVLIB/QMSG_ENG) +
                          TOFILE(&NEWLIB/QMSG_ENG) FROMMBR(PEEKENGPG ) +
                          TOMBR(PEEKENGPG ) MBROPT(*REPLACE) CRTFILE(*NO)

             CPYF       FROMFILE(&DEVLIB/QMSG_ENG) +
