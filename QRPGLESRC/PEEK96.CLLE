     /* ============================================================ */
     /*                                                              */
     /*  (c) Thomas Raddatz                                          */
     /*                                                              */
     /*  Bereich  : PEEK, Version 2.2.0                              */
     /*  Programm : PEEK96                                           */
     /*  Typ      : CLP                                              */
     /*                                                              */
     /*  erstellt : 23.01.1998  Raddatz                              */
     /*  geändert : 22.07.1999  für Version 2.2.0                    */
     /*  geändert : 20.04.2007  für Version 3.0.0                    */
     /*                                                              */
     /* ============================================================ */
     /*                                                              */
     /*  Dokumentation:                                              */
     /*                                                              */
     /*  Erstellen PEEK Distributions-Bibliothek                     */
     /*                                                              */
     /* ============================================================ */
     /*                                                              */
     /*  Aufrufen Programm:                                          */
     /*                                                              */
     /*     CALL PGM(PEEK96) PARM('PEEK326P' '*ALL')                 */
     /*                                                              */
     /*  Mögliche Werte für Parameter &DbgViewX (siehe PEEK99):      */
     /*     *NONE      Programme ohne Debug View erstellen           */
     /*     *ALL       Programme mit allen Debug Views erstellen     */
     /* ============================================================ */

          PGM        PARM(&DevLib     +
                          &DbgViewX   +
                          )

             DCLF       FILE(*LIBL/QAFDMBRL) RCDFMT(*ALL)

             DCL        VAR(&DEVLIB    ) TYPE(*CHAR) LEN(10)
             DCL        VAR(&DBGVIEWX  ) TYPE(*CHAR) LEN(10)

             DCL        VAR(&V         ) TYPE(*CHAR) LEN( 1)
             DCL        VAR(&R         ) TYPE(*CHAR) LEN( 1)
             DCL        VAR(&M         ) TYPE(*CHAR) LEN( 1)
             DCL        VAR(&VERSION   ) TYPE(*CHAR) LEN(10)
             DCL        VAR(&TEXT      ) TYPE(*CHAR) LEN(50)
             DCL        VAR(&IS_ADDED  ) TYPE(*CHAR) LEN( 1) VALUE('0')
             DCL        VAR(&TRUE      ) TYPE(*CHAR) LEN( 1) VALUE('1')
             DCL        VAR(&FALSE     ) TYPE(*CHAR) LEN( 1) VALUE('0')

             DCL        VAR(&NEWLIB    ) TYPE(*CHAR) LEN(10) VALUE('PEEK')
             DCL        VAR(&DBGVIEW   ) TYPE(*CHAR) LEN(10) VALUE('*NONE')
             DCL        VAR(&TGTRLS    ) TYPE(*CHAR) LEN(10) VALUE('V7R1M0')

             DCL        VAR(&DATE_DMY  ) TYPE(*CHAR) LEN( 6)
             DCL        VAR(&DATE_ISO  ) TYPE(*CHAR) LEN(10)
             DCL        VAR(&YEAR      ) TYPE(*CHAR) LEN( 4)

/* Fehlerbehandlung     */
             DCL        VAR(&ERROR)      TYPE(*LGL) +
                          VALUE('0')
             DCL        VAR(&ERRMSGKEY)  TYPE(*CHAR) LEN(4)

             DCL        VAR(&ERRMSGTYP)  TYPE(*CHAR) LEN(10) +
                          VALUE('*DIAG')
             DCL        VAR(&ERRNBRTYP)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRPGMMSGQ) TYPE(*CHAR) LEN(10) +
                          VALUE('*')
             DCL        VAR(&ERRSTKCTR)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRCODE  )  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000000')

/* Sende alle Fehler zur Error Handling Routine */
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CHGVAR     VAR(&ERROR    ) VALUE('0')

 /* -------------------------------------------------------------- */
 /*  Los geht's                                                    */
 /* -------------------------------------------------------------- */

             CHGVAR     VAR(&DBGVIEW) VALUE(&DBGVIEWX)
             MONMSG     MSGID(MCH3601) EXEC(DO)
                RMVMSG     PGMQ(*SAME (*)) CLEAR(*ALL)
             ENDDO

 /* Version    */
             CHGVAR     VAR(&V) VALUE(%SST(&DEVLIB  5 1))
             CHGVAR     VAR(&R) VALUE(%SST(&DEVLIB  6 1))
             CHGVAR     VAR(&M) VALUE(%SST(&DEVLIB  7 1))

             CHGVAR     VAR(&VERSION) VALUE(      &V *tcat '.'  +
                                            *tcat &R *tcat '.'  +
                                            *tcat &M            )

 /* Bibliothek */
             CRTLIB     LIB(&NEWLIB) +
                        TYPE(*TEST) +
                        TEXT('Peek/400 - PEEK, Version' *bcat &version      +
                                                        *tcat ' - ('        +
                                                        *tcat &tgtrls       +
                                                        *tcat ')')          +
                        CRTAUT(*ALL)
         /*  CALL       PGM(&DevLib/PEEK96B) PARM(&NEWLIB '*N' '*LIB')          */

 /* Binderverzeichnis */
             CRTBNDDIR  BNDDIR(&NEWLIB/PEEK) +
                        TEXT('Peek/400 - Binderverzeichnis')
             ADDBNDDIRE BNDDIR(&NEWLIB/PEEK) +
                        OBJ((&NEWLIB/PEEK51 *SRVPGM) +
                            (&NEWLIB/PEEK53 *SRVPGM) +
                            (&NEWLIB/PEEK58 *SRVPGM) +
                            (&NEWLIB/PEEK61 *SRVPGM) +
                            (&NEWLIB/PEEK63 *SRVPGM) +
                            (&NEWLIB/PEEK71 *SRVPGM))

 /* Bibl.-Liste */
             CHGVAR     VAR(&IS_ADDED) VALUE(&TRUE)

             ADDLIBLE   LIB(&NEWLIB) POSITION(*FIRST)
             MONMSG     MSGID(CPF2103) EXEC(DO)                           /* B01 */
               CHGVAR     VAR(&IS_ADDED) VALUE(&FALSE)
             ENDDO                                                        /* E01 */

 /* PEEKPGM    */
             RTVSYSVAL  SYSVAL(QDATE) RTNVAR(&DATE_DMY)
             CVTDAT     DATE(&DATE_DMY) TOVAR(&DATE_ISO) +
                          FROMFMT(*DMY) TOFMT(*ISO)
             CHGVAR     VAR(&YEAR) VALUE(%SST(&DATE_ISO 1 4))

             CRTDTAARA  DTAARA(&NEWLIB/PEEKPGM) TYPE(*CHAR) LEN(400) +
                          TEXT('Peek/400 - Generierungsangaben')
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (  1  10)) VALUE(&DBGVIEW)
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM ( 11  10)) VALUE(&TGTRLS)
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (101  11)) +
                          VALUE('DEBUG(*NO )')
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (113  13)) +
                          VALUE('DECEDIT(''0,'')')
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (127  14)) +
                          VALUE('DATEDIT(*DMY.)')
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (151  12)) +
                          VALUE('DATFMT(*ISO)')
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (164  12)) +
                          VALUE('TIMFMT(*ISO)')
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (201  15)) +
                          VALUE('EXTBININT(*YES)')
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (217  29)) +
                          VALUE(' ')  /* OPTION(*SRCSTMT : *NODEBUGIO) */
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (251  16)) +
                          VALUE('ALWNULL(*USRCTL)')
             CHGDTAARA  DTAARA(&NEWLIB/PEEKPGM (301 100)) +
                          VALUE('COPYRIGHT(''(c) 1997-' *CAT &YEAR *CAT +
                                 ' by Thomas Raddatz'')')

 /* -------------------------------------------------------------- */
 /* QEXAMPLE   */
             CRTSRCPF   FILE(&NEWLIB/QEXAMPLE) +
                          RCDLEN(112)          +
                          TEXT('Peek/400 - Beispiel- und Exit-Programme')
             CPYF       FROMFILE(&DEVLIB/QRPGLESRC) +
                          TOFILE(&NEWLIB/QEXAMPLE) FROMMBR(EXIT01)   +
                          TOMBR(*FROMMBR) MBROPT(*ADD) +
                          FMTOPT(*MAP)
             CPYF       FROMFILE(&DEVLIB/QRPGLESRC) +
                          TOFILE(&NEWLIB/QEXAMPLE) FROMMBR(EXIT02)   +
                          TOMBR(*FROMMBR) MBROPT(*ADD) +
                          FMTOPT(*MAP)
             CPYF       FROMFILE(&DEVLIB/QRPGLESRC) +
                          TOFILE(&NEWLIB/QEXAMPLE) FROMMBR(EXIT03)   +
                          TOMBR(*FROMMBR) MBROPT(*ADD) +
                          FMTOPT(*MAP)
             CPYF       FROMFILE(&DEVLIB/QRPGLESRC) +
                          TOFILE(&NEWLIB/QEXAMPLE) FROMMBR(EXIT04)   +
                          TOMBR(*FROMMBR) MBROPT(*ADD) +
                          FMTOPT(*MAP)
             CPYF       FROMFILE(&DEVLIB/QRPGLESRC) +
                          TOFILE(&NEWLIB/QEXAMPLE) FROMMBR(EXIT05)   +
                          TOMBR(*FROMMBR) MBROPT(*ADD) +
                          FMTOPT(*MAP)
             CPYF       FROMFILE(&DEVLIB/QDDSSRC  ) +
                          TOFILE(&NEWLIB/QEXAMPLE) FROMMBR(EXIT01PF) +
                          TOMBR(*FROMMBR) MBROPT(*ADD) +
                          FMTOPT(*MAP)
             CRTMSGDS   RANGE(USR1000 USR1999) +
                          MSGF(&DEVLIB/PEEKGER) +
                          FILE(&NEWLIB/QEXAMPLE) MBR(*GEN) +
                          REPLACE(*YES) TYPE(*ILERPG) DEFINE(*NO)

 /* -------------------------------------------------------------- */
 /* PEEKSRC    */
             CRTSRCPF   FILE(&NEWLIB/PEEKSRC) RCDLEN(112) +
                          TEXT('Peek/400 - Template für Programme')
             CPYF       FROMFILE(&DEVLIB/PEEKSRC) +
                          TOFILE(&NEWLIB/PEEKSRC) FROMMBR(PGM) +
                          TOMBR(PGM) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/PEEKSRC) +
                          TOFILE(&NEWLIB/PEEKSRC) FROMMBR(DSPF) +
                          TOMBR(DSPF) MBROPT(*ADD) CRTFILE(*NO)

 /* -------------------------------------------------------------- */
 /* QCOPYLE    */
             CRTSRCPF   FILE(&NEWLIB/QCOPYLE) RCDLEN(112) +
                          TEXT('Peek/400 - ILE Copy-Books')
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(FLDL0100) +
                          TOMBR(FLDL0100) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(D_VARDEF) +
                          TOMBR(D_VARDEF) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(F_PEEK58) +
                          TOMBR(F_PEEK58) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(F_PEEK61) +
                          TOMBR(F_PEEK61) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(F_PEEK63) +
                          TOMBR(F_PEEK63) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(F_PEEK71) +
                          TOMBR(F_PEEK71) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(OVRDBF  ) +
                          TOMBR(OVRDBF  ) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(DLTOVR  ) +
                          TOMBR(DLTOVR  ) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(OVRDSPF ) +
                          TOMBR(OVRDSPF ) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(H_SPEC  ) +
                          TOMBR(OVRDSPF ) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(COPYRIGHT) +
                          TOMBR(OVRDSPF ) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCOPYLE) +
                          TOFILE(&NEWLIB/QCOPYLE) FROMMBR(D_VARDEF) +
                          TOMBR(*FROMMBR) MBROPT(*ADD) +
                          FMTOPT(*MAP)

 /* -------------------------------------------------------------- */
 /* QCMDSRC    */
             CRTSRCPF   FILE(&NEWLIB/QCMDSRC ) +
                          RCDLEN( 92)          +
                          TEXT('Peek/400 - Befehle')

             CPYF       FROMFILE(&DEVLIB/QCMDSRC) +
                          TOFILE(&NEWLIB/QCMDSRC) FROMMBR(PEEK    ) +
                          TOMBR(PEEK    ) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCMDSRC) +
                          TOFILE(&NEWLIB/QCMDSRC) FROMMBR(TREE    ) +
                          TOMBR(TREE    ) MBROPT(*ADD) CRTFILE(*NO)

             CPYF       FROMFILE(&DEVLIB/QCMDSRC) +
                          TOFILE(&NEWLIB/QCMDSRC) FROMMBR(PEEKENG ) +
                          TOMBR(PEEKENG ) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCMDSRC) +
                          TOFILE(&NEWLIB/QCMDSRC) FROMMBR(PEEKFRA ) +
                          TOMBR(PEEKFRA ) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCMDSRC) +
                          TOFILE(&NEWLIB/QCMDSRC) FROMMBR(PEEKGER ) +
                          TOMBR(PEEKGER ) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCMDSRC) +
                          TOFILE(&NEWLIB/QCMDSRC) FROMMBR(PEEKITA ) +
                          TOMBR(PEEKITA ) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCMDSRC) +
                          TOFILE(&NEWLIB/QCMDSRC) FROMMBR(PEEKSPA ) +
                          TOMBR(PEEKSPA ) MBROPT(*ADD) CRTFILE(*NO)

             CPYF       FROMFILE(&DEVLIB/QCMDSRC) +
                          TOFILE(&NEWLIB/QCMDSRC) FROMMBR(TREEENG ) +
                          TOMBR(TREEENG ) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCMDSRC) +
                          TOFILE(&NEWLIB/QCMDSRC) FROMMBR(TREEGER ) +
                          TOMBR(TREEGER ) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCMDSRC) +
                          TOFILE(&NEWLIB/QCMDSRC) FROMMBR(TREEITA ) +
                          TOMBR(TREEITA ) MBROPT(*ADD) CRTFILE(*NO)
             CPYF       FROMFILE(&DEVLIB/QCMDSRC) +
                          TOFILE(&NEWLIB/QCMDSRC) FROMMBR(TREESPA ) +
                          TOMBR(TREESPA ) MBROPT(*ADD) CRTFILE(*NO)

 /* -------------------------------------------------------------- */
 /* PEEKENV    */
             CRTPF      FILE(&NEWLIB/PEEKENV) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*NONE) TEXT(*SRCMBRTXT) +
                          MAXMBRS(*NOMAX)
             DLTSPLF    FILE(PEEKENV) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

         /*  CALL       PGM(&DevLib/PEEK96B) PARM('PEEKENV'   &NEWLIB '*FILE')  */

 /* PEEKFLD    */
             CRTPF      FILE(&NEWLIB/PEEKFLD) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*FILE) TEXT(*SRCMBRTXT) +
                          MAXMBRS(1)
             DLTSPLF    FILE(PEEKFLD) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

             RTVOBJD    OBJ(&NEWLIB/PEEKFLD) OBJTYPE(*FILE) TEXT(&TEXT)
             CHGVAR     VAR(%SST(&TEXT 25 10)) VALUE(&VERSION)
             CHGOBJD    OBJ(&NEWLIB/PEEKFLD) OBJTYPE(*FILE) TEXT(&TEXT)

             CRTLF      FILE(&NEWLIB/PEEKFLDL0) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*FILE)
             DLTSPLF    FILE(PEEKFLDL0) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

             CRTLF      FILE(&NEWLIB/PEEKFLDL1) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*FILE)
             DLTSPLF    FILE(PEEKFLDL1) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

             CRTLF      FILE(&NEWLIB/PEEKFLDL2) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*FILE)
             DLTSPLF    FILE(PEEKFLDL2) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

         /*  CALL       PGM(&DevLib/PEEK96B) PARM('PEEKFLD'   &NEWLIB '*FILE')  */
         /*  CALL       PGM(&DevLib/PEEK96B) PARM('PEEKFLDL0' &NEWLIB '*FILE')  */
         /*  CALL       PGM(&DevLib/PEEK96B) PARM('PEEKFLDL1' &NEWLIB '*FILE')  */
         /*  CALL       PGM(&DevLib/PEEK96B) PARM('PEEKFLDL2' &NEWLIB '*FILE')  */

 /* PEEKFMT    */
             CRTPF      FILE(&NEWLIB/PEEKFMT) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*FILE) TEXT(*SRCMBRTXT) +
                          MAXMBRS(1)
             DLTSPLF    FILE(PEEKFMT) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

             RTVOBJD    OBJ(&NEWLIB/PEEKFMT) OBJTYPE(*FILE) TEXT(&TEXT)
             CHGVAR     VAR(%SST(&TEXT 25 10)) VALUE(&VERSION)
             CHGOBJD    OBJ(&NEWLIB/PEEKFMT) OBJTYPE(*FILE) TEXT(&TEXT)

         /*  CALL       PGM(&DevLib/PEEK96B) PARM('PEEKFMT'   &NEWLIB '*FILE')  */

 /* PEEKUSR    */
             CRTPF      FILE(&NEWLIB/PEEKUSR) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*FILE) TEXT(*SRCMBRTXT) +
                          MAXMBRS(1)
             DLTSPLF    FILE(PEEKUSR) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

             CPYF       FROMFILE(&DEVLIB/PEEKUSR) +
                          TOFILE(&NEWLIB/PEEKUSR) FROMMBR(*FIRST) +
                          TOMBR(*FIRST) MBROPT(*ADD) CRTFILE(*NO)

         /*  CALL       PGM(&DevLib/PEEK96B) PARM('PEEKUSR'   &NEWLIB '*FILE')  */

 /* PEEKWRK    */
             CRTPF      FILE(&NEWLIB/PEEKWRK) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*FILE) TEXT(*SRCMBRTXT) +
                          MAXMBRS(1)
             DLTSPLF    FILE(PEEKWRK) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

             RTVOBJD    OBJ(&NEWLIB/PEEKWRK) OBJTYPE(*FILE) TEXT(&TEXT)
             CHGVAR     VAR(%SST(&TEXT 25 10)) VALUE(&VERSION)
             CHGOBJD    OBJ(&NEWLIB/PEEKWRK) OBJTYPE(*FILE) TEXT(&TEXT)

         /*  CALL       PGM(&DevLib/PEEK96B) PARM('PEEKWRK'   &NEWLIB '*FILE')  */

 /* -------------------------------------------------------------- */
 /* EXIT01PF   */
             CRTPF      FILE(&NEWLIB/EXIT01PF) +
                          SRCFILE(&NEWLIB/QEXAMPLE) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*FILE) TEXT(*SRCMBRTXT)
             DLTSPLF    FILE(EXIT01PF) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

             CPYF       FROMFILE(&DEVLIB/EXIT01PF) +
                          TOFILE(&NEWLIB/EXIT01PF) MBROPT(*ADD) +
                          INCREL((*IF   USER *EQ '*ALLUSRrmv') +
                                  (*AND FILE *EQ '*SECATRrmv') +
                                  (*AND LIB  *EQ '*ALLLIBrmv'))

 /* EXIT01     */
             CALL       PGM(&DevLib/PEEK99) PARM('QEXAMPLE'  +
                                                 &NEWLIB     +
                                                 'EXIT01'    +
                                                 &NEWLIB     +
                                                 '*NO'       +
                                                 'PEEK'      +
                                                 &DEVLIB     +
                                                 &TRUE       +
                                                 )

 /* -------------------------------------------------------------- */
 /* PEEKENG    */
             CRTDUPOBJ  OBJ(PEEKENG) FROMLIB(&DEVLIB) +
                          OBJTYPE(*MSGF) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
             CRTDUPOBJ  OBJ(PEEKENG) FROMLIB(&DEVLIB) +
                          OBJTYPE(*PNLGRP) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
 /* PEEKFRA    */
             CRTDUPOBJ  OBJ(PEEKFRA) FROMLIB(&DEVLIB) +
                          OBJTYPE(*MSGF) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
             CRTDUPOBJ  OBJ(PEEKFRA) FROMLIB(&DEVLIB) +
                          OBJTYPE(*PNLGRP) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
 /* PEEKGER    */
             CRTDUPOBJ  OBJ(PEEKGER) FROMLIB(&DEVLIB) +
                          OBJTYPE(*MSGF) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
             CRTDUPOBJ  OBJ(PEEKGER) FROMLIB(&DEVLIB) +
                          OBJTYPE(*PNLGRP) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
 /* PEEKSPA    */
             CRTDUPOBJ  OBJ(PEEKSPA) FROMLIB(&DEVLIB) +
                          OBJTYPE(*MSGF) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
             CRTDUPOBJ  OBJ(PEEKSPA) FROMLIB(&DEVLIB) +
                          OBJTYPE(*PNLGRP) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
 /* PEEKITA    */
             CRTDUPOBJ  OBJ(PEEKITA) FROMLIB(&DEVLIB) +
                          OBJTYPE(*MSGF) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
             CRTDUPOBJ  OBJ(PEEKITA) FROMLIB(&DEVLIB) +
                          OBJTYPE(*PNLGRP) TOLIB(&NEWLIB) NEWOBJ(*OBJ)

 /* -------------------------------------------------------------- */
 /* PEEK       */
             CRTCMD     CMD(&NEWLIB/PEEK) PGM(*LIBL/PEEK) +
                          SRCFILE(&DEVLIB/QCMDSRC) SRCMBR(*CMD) +
                          ALLOW(*IMOD *IREXX *IPGM *EXEC *INTERACT) +
                          PRDLIB(&NEWLIB) PMTFILE(PEEKGER) +
                          HLPPNLGRP(PEEKGER) HLPID(PEEK)
             DLTSPLF    FILE(PEEK) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

 /* TREE       */
             CRTCMD     CMD(&NEWLIB/TREE) PGM(*LIBL/TREE) +
                          SRCFILE(&DEVLIB/QCMDSRC) SRCMBR(*CMD) +
                          ALLOW(*IMOD *IREXX *IPGM *EXEC *INTERACT) +
                          PRDLIB(&NEWLIB) PMTFILE(PEEKGER) +
                          HLPPNLGRP(TREEGER) HLPID(TREE)
             DLTSPLF    FILE(TREE) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

 /* PEEKINIT   */
             CRTCMD     CMD(&NEWLIB/PEEKINIT) PGM(&NEWLIB/PEEKINIT) +
                          SRCFILE(&DEVLIB/QCMDSRC) SRCMBR(*CMD) +
                          ALLOW(*ALL) +
                          PRDLIB(*NONE)
             DLTSPLF    FILE(PEEKINIT) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

 /* PEEKCLONE  */
             CRTCMD     CMD(&NEWLIB/PEEKCLONE) PGM(&NEWLIB/PEEKCLONE) +
                          SRCFILE(&DEVLIB/QCMDSRC) SRCMBR(*CMD) +
                          ALLOW(*ALL) +
                          PRDLIB(*NONE)
             DLTSPLF    FILE(PEEKCLONE) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

 /* -------------------------------------------------------------- */
 /* DDS + RPG  */
             CALL       PGM(&DevLib/PEEK99) PARM('QRPGLESRC' +
                                         &DEVLIB     +
                                         'PEEK61'    +
                                         &NEWLIB     +
                                         '*NO'       +
                                         'PEEK'      +
                                         &DEVLIB     +
                                         &TRUE       +
                                        )

             CALL       PGM(&DevLib/PEEK99) PARM('QRPGLESRC' +
                                         &DEVLIB     +
                                         'PEEK58'    +
                                         &NEWLIB     +
                                         '*NO'       +
                                         'PEEK'      +
                                         &DEVLIB     +
                                         &TRUE       +
                                        )

             CALL       PGM(&DevLib/PEEK99) PARM('QRPGLESRC' +
                                         &DEVLIB     +
                                         'PEEK53'    +
                                         &NEWLIB     +
                                         '*NO'       +
                                         'PEEK'      +
                                         &DEVLIB     +
                                         &TRUE       +
                                        )

             CALL       PGM(&DevLib/PEEK99) PARM('QRPGLESRC' +
                                         &DEVLIB     +
                                         'PEEK63'    +
                                         &NEWLIB     +
                                         '*NO'       +
                                         'PEEK'      +
                                         &DEVLIB     +
                                         &TRUE       +
                                        )

             CALL       PGM(&DevLib/PEEK99) PARM('QRPGLESRC' +
                                         &DEVLIB     +
                                         'PEEK51'    +
                                         &NEWLIB     +
                                         '*NO'       +
                                         'PEEK'      +
                                         &DEVLIB     +
                                         &TRUE       +
                                        )

             CALL       PGM(&DevLib/PEEK99) PARM('QRPGLESRC' +
                                         &DEVLIB     +
                                         'PEEK71'    +
                                         &NEWLIB     +
                                         '*NO'       +
                                         'PEEK'      +
                                         &DEVLIB     +
                                         &TRUE       +
                                        )

             CALL       PGM(&DevLib/PEEK99) PARM('QRPGLESRC' +
                                         &DEVLIB     +
                                         'PEEKINIT3' +
                                         &NEWLIB     +
                                         '*NO'       +
                                         'PEEK'      +
                                         &DEVLIB     +
                                         &TRUE       +
                                        )

             CALL       PGM(&DevLib/PEEK99) PARM('QRPGLESRC' +
                                         &DEVLIB     +
                                         'PEEKINIT2' +
                                         &NEWLIB     +
                                         '*NO'       +
                                         'PEEK'      +
                                         &DEVLIB     +
                                         &TRUE       +
                                        )

             CALL       PGM(&DevLib/PEEK99) PARM('QRPGLESRC' +
                                         &DEVLIB     +
                                         'PEEKINIT1' +
                                         &NEWLIB     +
                                         '*NO'       +
                                         'PEEK'      +
                                         &DEVLIB     +
                                         &TRUE       +
                                        )

             CALL       PGM(&DevLib/PEEK99) PARM('QRPGLESRC' +
                                         &DEVLIB     +
                                         'PEEKINIT'  +
                                         &NEWLIB     +
                                         '*NO'       +
                                         'PEEK'      +
                                         &DEVLIB     +
                                         &TRUE       +
                                        )

             DSPFD      FILE(&DEVLIB/QDDSSRC) TYPE(*MBRLIST) +
                          OUTPUT(*OUTFILE) OUTFILE(QTEMP/PEEKMBR) +
                          OUTMBR(*FIRST *REPLACE)
             DSPFD      FILE(&DEVLIB/QRPGLESRC) TYPE(*MBRLIST) +
                          OUTPUT(*OUTFILE) OUTFILE(QTEMP/PEEKMBR) +
                          OUTMBR(*FIRST *ADD)

             OVRDBF     FILE(QAFDMBRL) TOFILE(QTEMP/PEEKMBR)

Loop:
             RCVF       RCDFMT(QWHFDML)
             MONMSG     MSGID(CPF0864) EXEC(GOTO CMDLBL(EndLoop))

             IF         COND(&MLSEU2  *NE 'CMD'      +
                        *AND &MLSEU2  *NE 'DSPF'     +
                        *AND &MLSEU2  *NE 'PRTF'     +
                        *AND &MLSEU2  *NE 'RPGLE'    +
                        *AND &MLSEU2  *NE 'SQLRPGLE' +
                        *AND &MLSEU2  *NE 'CLLE'     +
                        *AND &MLSEU2  *NE 'CLP'  ) THEN(DO)               /* B01 */
               GOTO       CMDLBL(Loop)
             ENDDO                                                        /* E01 */

             IF         COND(%sst(&MLNAME 1 1)  *EQ '#') THEN(DO)
               GOTO       CMDLBL(Loop)
             ENDDO

             IF         COND(&MLNAME  *GE 'PEEKCLONE1'  +
                        *AND &MLNAME  *LE 'PEEKCLONE9') THEN(DO)
               GOTO       CMDLBL(Loop)
             ENDDO

             IF         COND(&MLNAME  *GE 'PEEKUPD001'  +
                        *AND &MLNAME  *LE 'PEEKUPD999') THEN(DO)
               GOTO       CMDLBL(Loop)
             ENDDO

             IF         COND(&MLNAME  *GE 'PEEK90'  +
                        *AND &MLNAME  *LE 'PEEK99') THEN(DO)              /* B01 */
               GOTO       CMDLBL(Loop)
             ENDDO                                                        /* E01 */

             IF         COND(&MLNAME  *GE 'EXIT00'  +
                        *AND &MLNAME  *LE 'EXIT99') THEN(DO)              /* B01 */
               GOTO       CMDLBL(Loop)
             ENDDO                                                        /* E01 */

             IF         COND(&MLNAME  *GE 'TEST000'  +
                        *AND &MLNAME  *LE 'TEST999') THEN(DO)
               GOTO       CMDLBL(Loop)
             ENDDO

             IF         COND(&MLNAME  *EQ 'PEEK00') THEN(DO)              /* B01 */
               GOTO       CMDLBL(Loop)
             ENDDO                                                        /* E01 */

             IF         COND(&MLNAME  *EQ 'TESTPEEK_P') THEN(DO)          /* B01 */
               GOTO       CMDLBL(Loop)
             ENDDO                                                        /* E01 */

             CALL       PGM(&DevLib/PEEK99) PARM(&MLFILE     +
                                         &MLLIB      +
                                         &MLNAME     +
                                         &NEWLIB     +
                                         '*YES'      +
                                         'PEEK'      +
                                         &DEVLIB     +
                                         &TRUE       +
                                        )

             GOTO       CMDLBL(Loop)
 EndLoop:

 /* PEEK00     */
             CALL       PGM(&DevLib/PEEK99) PARM('QRPGLESRC' +
                                         &DEVLIB     +
                                         'PEEK00'    +
                                         &NEWLIB     +
                                         '*YES'      +
                                         'PEEK'      +
                                         &DEVLIB     +
                                         &TRUE       +
                                        )

 /* Initialisieren: GER   */
             SBMJOB     CMD(PEEKINIT LANGUAGE(GER)) +
                          JOBQ(RADDATZ) JOB(PEEKINIT) +
                          JOBPTY(6)

 /* -------------------------------------------------------------- */

 ENDE:

/* Verschiebe alle *INFO Nachrichten zur             */
/* vorangegangenen Programmwarteschlange             */
             CHGVAR     VAR(&ERRMSGTYP) VALUE('*INFO')
             CALL       PGM(QMHMOVPM) PARM(&ERRMSGKEY &ERRMSGTYP +
                          &ERRNBRTYP &ERRPGMMSGQ &ERRSTKCTR &ERRCODE)

             DLTOVR     FILE(*ALL)
             MONMSG     MSGID(CPF0000)

             RCLRSC     LVL(*)
             MONMSG     MSGID(CPF0000)

             RCLACTGRP  ACTGRP(PEEK) OPTION(*NORMAL)
             MONMSG     MSGID(CPF0000)

             IF         COND(&IS_ADDED *EQ &TRUE) THEN(DO)                /* B01 */
               RMVLIBLE   LIB(&NEWLIB)
               MONMSG     MSGID(CPF0000)
             ENDDO                                                        /* E01 */

             IF         COND(&ERROR) THEN(DO)
                /* Sende letzte *ESCAPE nochmals   */
                CALL       PGM(QMHRSNEM) PARM(&ERRMSGKEY &ERRCODE)
                MONMSG     MSGID(CPF0000)
             ENDDO                                                        /* E01 */

             RETURN

/* ---------------- */
/* Error            */
/* Handling         */
/* ---------------- */
 ERROR:
             IF         COND(&ERROR) THEN(GOTO CMDLBL(ENDE))
             ELSE       CHGVAR     VAR(&ERROR) VALUE('1')

/* Verschiebe alle *DIAG Nachrichten zur             */
/* vorangegangenen Programmwarteschlange             */
             CHGVAR     VAR(&ERRMSGTYP) VALUE('*DIAG')
             CALL       PGM(QMHMOVPM) PARM(&ERRMSGKEY &ERRMSGTYP +
                          &ERRNBRTYP &ERRPGMMSGQ &ERRSTKCTR &ERRCODE)

             GOTO       CMDLBL(ENDE)

             ENDPGM

