 /* -------------------------------------------------------------- */
 /* PEEKENV    */
             CRTPF      FILE(&NEWLIB/PEEKENV) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*NONE) TEXT(*SRCMBRTXT) +
                          MAXMBRS(*NOMAX)
             DLTSPLF    FILE(PEEKENV) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

         /*  CALL       PGM(&DevLib/PEEK96B) PARM('PEEKENV'   &NEWLIB '*FILE')  */

 /* PEEKFLD    */
             CRTPF      FILE(&NEWLIB/PEEKFLD) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*FILE) TEXT(*SRCMBRTXT) +
                          MAXMBRS(1)
             DLTSPLF    FILE(PEEKFLD) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

             RTVOBJD    OBJ(&NEWLIB/PEEKFLD) OBJTYPE(*FILE) TEXT(&TEXT)
             CHGVAR     VAR(%SST(&TEXT 25 10)) VALUE(&VERSION)
             CHGOBJD    OBJ(&NEWLIB/PEEKFLD) OBJTYPE(*FILE) TEXT(&TEXT)

             CRTLF      FILE(&NEWLIB/PEEKFLDL0) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*FILE)
             DLTSPLF    FILE(PEEKFLDL0) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

             CRTLF      FILE(&NEWLIB/PEEKFLDL1) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*FILE)
             DLTSPLF    FILE(PEEKFLDL1) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

             CRTLF      FILE(&NEWLIB/PEEKFLDL2) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*FILE)
             DLTSPLF    FILE(PEEKFLDL2) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

         /*  CALL       PGM(&DevLib/PEEK96B) PARM('PEEKFLD'   &NEWLIB '*FILE')  */
         /*  CALL       PGM(&DevLib/PEEK96B) PARM('PEEKFLDL0' &NEWLIB '*FILE')  */
         /*  CALL       PGM(&DevLib/PEEK96B) PARM('PEEKFLDL1' &NEWLIB '*FILE')  */
         /*  CALL       PGM(&DevLib/PEEK96B) PARM('PEEKFLDL2' &NEWLIB '*FILE')  */

 /* PEEKFMT    */
             CRTPF      FILE(&NEWLIB/PEEKFMT) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*FILE) TEXT(*SRCMBRTXT) +
                          MAXMBRS(1)
             DLTSPLF    FILE(PEEKFMT) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

             RTVOBJD    OBJ(&NEWLIB/PEEKFMT) OBJTYPE(*FILE) TEXT(&TEXT)
             CHGVAR     VAR(%SST(&TEXT 25 10)) VALUE(&VERSION)
             CHGOBJD    OBJ(&NEWLIB/PEEKFMT) OBJTYPE(*FILE) TEXT(&TEXT)

         /*  CALL       PGM(&DevLib/PEEK96B) PARM('PEEKFMT'   &NEWLIB '*FILE')  */

 /* PEEKUSR    */
             CRTPF      FILE(&NEWLIB/PEEKUSR) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*FILE) TEXT(*SRCMBRTXT) +
                          MAXMBRS(1)
             DLTSPLF    FILE(PEEKUSR) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

             CPYF       FROMFILE(&DEVLIB/PEEKUSR) +
                          TOFILE(&NEWLIB/PEEKUSR) FROMMBR(*FIRST) +
                          TOMBR(*FIRST) MBROPT(*REPLACE) CRTFILE(*NO)

         /*  CALL       PGM(&DevLib/PEEK96B) PARM('PEEKUSR'   &NEWLIB '*FILE')  */

 /* PEEKWRK    */
             CRTPF      FILE(&NEWLIB/PEEKWRK) +
                          SRCFILE(&DEVLIB/QDDSSRC) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*FILE) TEXT(*SRCMBRTXT) +
                          MAXMBRS(1)
             DLTSPLF    FILE(PEEKWRK) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

             RTVOBJD    OBJ(&NEWLIB/PEEKWRK) OBJTYPE(*FILE) TEXT(&TEXT)
             CHGVAR     VAR(%SST(&TEXT 25 10)) VALUE(&VERSION)
             CHGOBJD    OBJ(&NEWLIB/PEEKWRK) OBJTYPE(*FILE) TEXT(&TEXT)

         /*  CALL       PGM(&DevLib/PEEK96B) PARM('PEEKWRK'   &NEWLIB '*FILE')  */

 /* -------------------------------------------------------------- */
 /* EXIT01PF   */
             CRTPF      FILE(&NEWLIB/EXIT01PF) +
                          SRCFILE(&NEWLIB/QEXAMPLE) SRCMBR(*FILE) +
                          FILETYPE(*DATA) MBR(*FILE) TEXT(*SRCMBRTXT)
             DLTSPLF    FILE(EXIT01PF) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

             CPYF       FROMFILE(&DEVLIB/EXIT01PF) +
                          TOFILE(&NEWLIB/EXIT01PF) MBROPT(*ADD) +
                          INCREL((*IF   USER *EQ '*ALLUSRrmv') +
                                  (*AND FILE *EQ '*SECATRrmv') +
                                  (*AND LIB  *EQ '*ALLLIBrmv'))

 /* EXIT01     */
             CRTPEEKOBJ SRCFILE(&NEWLIB/QEXAMPLE) SRCMBR(EXIT01) +
                          OBJLIB(&NEWLIB) DEVLIB(&DEVLIB) +
                          SBMJOB(*NO) BNDDIR(PEEK) INSTALL(&TRUE)

 /* -------------------------------------------------------------- */
 /* PEEKENG    */
             CRTDUPOBJ  OBJ(PEEKENG) FROMLIB(&DEVLIB) +
                          OBJTYPE(*MSGF) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
             CRTDUPOBJ  OBJ(PEEKENG) FROMLIB(&DEVLIB) +
                          OBJTYPE(*PNLGRP) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
 /* PEEKFRA    */
             CRTDUPOBJ  OBJ(PEEKFRA) FROMLIB(&DEVLIB) +
                          OBJTYPE(*MSGF) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
             CRTDUPOBJ  OBJ(PEEKFRA) FROMLIB(&DEVLIB) +
                          OBJTYPE(*PNLGRP) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
 /* PEEKGER    */
             CRTDUPOBJ  OBJ(PEEKGER) FROMLIB(&DEVLIB) +
                          OBJTYPE(*MSGF) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
             CRTDUPOBJ  OBJ(PEEKGER) FROMLIB(&DEVLIB) +
                          OBJTYPE(*PNLGRP) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
 /* PEEKSPA    */
             CRTDUPOBJ  OBJ(PEEKSPA) FROMLIB(&DEVLIB) +
                          OBJTYPE(*MSGF) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
             CRTDUPOBJ  OBJ(PEEKSPA) FROMLIB(&DEVLIB) +
                          OBJTYPE(*PNLGRP) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
 /* PEEKITA    */
             CRTDUPOBJ  OBJ(PEEKITA) FROMLIB(&DEVLIB) +
                          OBJTYPE(*MSGF) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
             CRTDUPOBJ  OBJ(PEEKITA) FROMLIB(&DEVLIB) +
                          OBJTYPE(*PNLGRP) TOLIB(&NEWLIB) NEWOBJ(*OBJ)

 /* -------------------------------------------------------------- */
 /* TREEENG    */
             CRTDUPOBJ  OBJ(TREEENG) FROMLIB(&DEVLIB) +
                          OBJTYPE(*PNLGRP) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
 /* TREEFRA    */
             CRTDUPOBJ  OBJ(TREEFRA) FROMLIB(&DEVLIB) +
                          OBJTYPE(*PNLGRP) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
 /* TREEGER    */
             CRTDUPOBJ  OBJ(TREEGER) FROMLIB(&DEVLIB) +
                          OBJTYPE(*PNLGRP) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
 /* TREESPA    */
             CRTDUPOBJ  OBJ(TREESPA) FROMLIB(&DEVLIB) +
                          OBJTYPE(*PNLGRP) TOLIB(&NEWLIB) NEWOBJ(*OBJ)
 /* TREEITA    */
             CRTDUPOBJ  OBJ(TREEITA) FROMLIB(&DEVLIB) +
                          OBJTYPE(*PNLGRP) TOLIB(&NEWLIB) NEWOBJ(*OBJ)

 /* -------------------------------------------------------------- */
 /* PEEK       */
             CRTCMD     CMD(&NEWLIB/PEEK) PGM(*LIBL/PEEK) +
                          SRCFILE(&DEVLIB/QCMDSRC) SRCMBR(*CMD) +
                          ALLOW(*IMOD *IREXX *IPGM *EXEC *INTERACT) +
                          PRDLIB(&NEWLIB) PMTFILE(PEEKGER) +
                          HLPPNLGRP(PEEKGER) HLPID(PEEK)
             DLTSPLF    FILE(PEEK) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

 /* TREE       */
             CRTCMD     CMD(&NEWLIB/TREE) PGM(*LIBL/TREE) +
                          SRCFILE(&DEVLIB/QCMDSRC) SRCMBR(*CMD) +
                          ALLOW(*IMOD *IREXX *IPGM *EXEC *INTERACT) +
                          PRDLIB(&NEWLIB) PMTFILE(PEEKGER) +
                          HLPPNLGRP(TREEGER) HLPID(TREE)
             DLTSPLF    FILE(TREE) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

 /* PEEKINIT   */
             CRTCMD     CMD(&NEWLIB/PEEKINIT) PGM(&NEWLIB/PEEKINIT) +
                          SRCFILE(&DEVLIB/QCMDSRC) SRCMBR(*CMD) +
                          ALLOW(*ALL) +
                          PRDLIB(*NONE)
             DLTSPLF    FILE(PEEKINIT) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

 /* PEEKCLONE  */
             CRTCMD     CMD(&NEWLIB/PEEKCLONE) PGM(&NEWLIB/PEEKCLONE) +
                          SRCFILE(&DEVLIB/QCMDSRC) SRCMBR(*CMD) +
                          ALLOW(*ALL) +
                          PRDLIB(*NONE)
             DLTSPLF    FILE(PEEKCLONE) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF3303)

 /* -------------------------------------------------------------- */
 /* DDS + RPG  */
             CRTPEEKOBJ SRCFILE(&DEVLIB/QRPGLESRC) SRCMBR(PEEK61) +
                          OBJLIB(&NEWLIB) DEVLIB(&DEVLIB) +
                          SBMJOB(*NO) BNDDIR(PEEK) INSTALL(&TRUE)

             CRTPEEKOBJ SRCFILE(&DEVLIB/QRPGLESRC) SRCMBR(PEEK58) +
                          OBJLIB(&NEWLIB) DEVLIB(&DEVLIB) +
                          SBMJOB(*NO) BNDDIR(PEEK) INSTALL(&TRUE)

             CRTPEEKOBJ SRCFILE(&DEVLIB/QRPGLESRC) SRCMBR(PEEK53) +
                          OBJLIB(&NEWLIB) DEVLIB(&DEVLIB) +
                          SBMJOB(*NO) BNDDIR(PEEK) INSTALL(&TRUE)

             CRTPEEKOBJ SRCFILE(&DEVLIB/QRPGLESRC) SRCMBR(PEEK63) +
                          OBJLIB(&NEWLIB) DEVLIB(&DEVLIB) +
                          SBMJOB(*NO) BNDDIR(PEEK) INSTALL(&TRUE)

             CRTPEEKOBJ SRCFILE(&DEVLIB/QRPGLESRC) SRCMBR(PEEK51) +
                          OBJLIB(&NEWLIB) DEVLIB(&DEVLIB) +
                          SBMJOB(*NO) BNDDIR(PEEK) INSTALL(&TRUE)

             CRTPEEKOBJ SRCFILE(&DEVLIB/QRPGLESRC) SRCMBR(PEEK71) +
                          OBJLIB(&NEWLIB) DEVLIB(&DEVLIB) +
                          SBMJOB(*NO) BNDDIR(PEEK) INSTALL(&TRUE)

             CRTPEEKOBJ SRCFILE(&DEVLIB/QRPGLESRC) SRCMBR(PEEKINIT3) +
                          OBJLIB(&NEWLIB) DEVLIB(&DEVLIB) +
                          SBMJOB(*NO) BNDDIR(PEEK) INSTALL(&TRUE)

             CRTPEEKOBJ SRCFILE(&DEVLIB/QRPGLESRC) SRCMBR(PEEKINIT2) +
                          OBJLIB(&NEWLIB) DEVLIB(&DEVLIB) +
                          SBMJOB(*NO) BNDDIR(PEEK) INSTALL(&TRUE)

             CRTPEEKOBJ SRCFILE(&DEVLIB/QRPGLESRC) SRCMBR(PEEKINIT1) +
                          OBJLIB(&NEWLIB) DEVLIB(&DEVLIB) +
                          SBMJOB(*NO) BNDDIR(PEEK) INSTALL(&TRUE)

             CRTPEEKOBJ SRCFILE(&DEVLIB/QRPGLESRC) SRCMBR(PEEKINIT ) +
                          OBJLIB(&NEWLIB) DEVLIB(&DEVLIB) +
                          SBMJOB(*NO) BNDDIR(PEEK) INSTALL(&TRUE)

             DSPFD      FILE(&DEVLIB/QDDSSRC) TYPE(*MBRLIST) +
                          OUTPUT(*OUTFILE) OUTFILE(QTEMP/PEEKMBR) +
                          OUTMBR(*FIRST *REPLACE)
             DSPFD      FILE(&DEVLIB/QRPGLESRC) TYPE(*MBRLIST) +
                          OUTPUT(*OUTFILE) OUTFILE(QTEMP/PEEKMBR) +
                          OUTMBR(*FIRST *ADD)

             OVRDBF     FILE(QAFDMBRL) TOFILE(QTEMP/PEEKMBR)

Loop:
             RCVF       RCDFMT(QWHFDML)
             MONMSG     MSGID(CPF0864) EXEC(GOTO CMDLBL(EndLoop))

             IF         COND(&MLSEU2  *NE 'CMD'      +
                        *AND &MLSEU2  *NE 'DSPF'     +
                        *AND &MLSEU2  *NE 'PRTF'     +
                        *AND &MLSEU2  *NE 'RPGLE'    +
                        *AND &MLSEU2  *NE 'SQLRPGLE' +
                        *AND &MLSEU2  *NE 'CLLE'     +
                        *AND &MLSEU2  *NE 'CLP'  ) THEN(DO)
               GOTO       CMDLBL(Loop)
             ENDDO

             IF         COND(%sst(&MLNAME 1 1)  *EQ '#') THEN(DO)
               GOTO       CMDLBL(Loop)
             ENDDO

             IF         COND(&MLNAME  *GE 'PEEKCLONE1'  +
                        *AND &MLNAME  *LE 'PEEKCLONE9') THEN(DO)
               GOTO       CMDLBL(Loop)
             ENDDO

             IF         COND(&MLNAME  *GE 'PEEKUPD001'  +
                        *AND &MLNAME  *LE 'PEEKUPD999') THEN(DO)
               GOTO       CMDLBL(Loop)
             ENDDO

             IF         COND(&MLNAME  *GE 'PEEK90'  +
                        *AND &MLNAME  *LE 'PEEK99') THEN(DO)
               GOTO       CMDLBL(Loop)
             ENDDO

             IF         COND(&MLNAME  *GE 'EXIT00'  +
                        *AND &MLNAME  *LE 'EXIT99') THEN(DO)
               GOTO       CMDLBL(Loop)
             ENDDO

             IF         COND(&MLNAME  *GE 'TEST000'  +
                        *AND &MLNAME  *LE 'TEST999') THEN(DO)
               GOTO       CMDLBL(Loop)
             ENDDO

             IF         COND(&MLNAME  *EQ 'PEEK00') THEN(DO)
               GOTO       CMDLBL(Loop)
             ENDDO

             IF         COND(&MLNAME  *EQ 'TESTPEEK_P') THEN(DO)
               GOTO       CMDLBL(Loop)
             ENDDO

             CRTPEEKOBJ SRCFILE(&MLLIB/&MLFILE) SRCMBR(&MLNAME) +
                          OBJLIB(&NEWLIB) DEVLIB(&DEVLIB) +
                          SBMJOB(*YES) BNDDIR(PEEK) INSTALL(&TRUE)

             GOTO       CMDLBL(Loop)
 EndLoop:

 /* PEEK00     */
             CRTPEEKOBJ SRCFILE(&DEVLIB/QRPGLESRC) SRCMBR(PEEK00) +
                          OBJLIB(&NEWLIB) DEVLIB(&DEVLIB) +
                          SBMJOB(*YES) BNDDIR(PEEK) INSTALL(&TRUE)

 /* Initialisieren: GER   */
             SBMJOB     CMD(PEEKINIT LANGUAGE(GER)) +
                          JOBQ(RADDATZ) JOB(PEEKINIT) +
                          JOBPTY(6)

 /* -------------------------------------------------------------- */

 ENDE:

/* Verschiebe alle *INFO Nachrichten zur             */
/* vorangegangenen Programmwarteschlange             */
             CHGVAR     VAR(&ERRMSGTYP) VALUE('*INFO')
             CALL       PGM(QMHMOVPM) PARM(&ERRMSGKEY &ERRMSGTYP +
                          &ERRNBRTYP &ERRPGMMSGQ &ERRSTKCTR &ERRCODE)

             DLTOVR     FILE(*ALL)
             MONMSG     MSGID(CPF0000)

             RCLRSC     LVL(*)
             MONMSG     MSGID(CPF0000)

             RCLACTGRP  ACTGRP(PEEK) OPTION(*NORMAL)
             MONMSG     MSGID(CPF0000)

             IF         COND(&IS_ADDED *EQ &TRUE) THEN(DO)
               RMVLIBLE   LIB(&NEWLIB)
               MONMSG     MSGID(CPF0000)
             ENDDO

             IF         COND(&ERROR) THEN(DO)
                /* Sende letzte *ESCAPE nochmals   */
                CALL       PGM(QMHRSNEM) PARM(&ERRMSGKEY &ERRCODE)
                MONMSG     MSGID(CPF0000)
             ENDDO

             RETURN

/* ---------------- */
/* Error            */
/* Handling         */
/* ---------------- */
 ERROR:
             IF         COND(&ERROR) THEN(GOTO CMDLBL(ENDE))
             ELSE       CHGVAR     VAR(&ERROR) VALUE('1')

/* Verschiebe alle *DIAG Nachrichten zur             */
/* vorangegangenen Programmwarteschlange             */
             CHGVAR     VAR(&ERRMSGTYP) VALUE('*DIAG')
             CALL       PGM(QMHMOVPM) PARM(&ERRMSGKEY &ERRMSGTYP +
                          &ERRNBRTYP &ERRPGMMSGQ &ERRSTKCTR &ERRCODE)

             GOTO       CMDLBL(ENDE)

             ENDPGM

