**free
      //%METADATA                                                      *
      // %TEXT Konstanten für Farbattribute                            *
      //%EMETADATA                                                     *
//===============================================================*
//                                                               *
//  Definition von Konstanten für                                *
//  Farbattribute.                                               *
//                                                               *
//===============================================================*

//------------------------------------------------------*
// Green
dcl-c COLOR_green x'20';
// Green/Reverse
dcl-c COLOR_green_r x'21';
// Green/Underscore
dcl-c COLOR_green_u x'24';
// Green/Underscore/Reverse
dcl-c COLOR_green_ru x'25';
//------------------------------------------------------*
// White
dcl-c COLOR_white x'22';
// White/Reverse
dcl-c COLOR_White_R x'23';
// White/Underscore
dcl-c COLOR_white_u x'26';
//------------------------------------------------------*
// Red
dcl-c COLOR_red x'28';
// Red/Reverse
dcl-c COLOR_red_r x'29';
// Red/Underscore
dcl-c COLOR_red_u x'2C';
// Red/Underscore/Reverse
dcl-c COLOR_red_ru x'2D';
// Red/Blink
dcl-c COLOR_red_b x'2A';
// Red/Reverse/Blink
dcl-c COLOR_red_rb x'2B';
// Red/Underscore/Blink
dcl-c COLOR_red_ub x'2E';
//------------------------------------------------------*
// Turquoise/Column Separators
dcl-c COLOR_turkis x'30';
// Turquoise/Column Separators/Reverse
dcl-c COLOR_turkis_r x'31';
// Turquoise/Underscore
dcl-c COLOR_turkis_u x'34';
// Turquoise/Underscore/Reverse
dcl-c COLOR_turkis_ru x'35';
//------------------------------------------------------*
// Yellow/Column Separators
dcl-c COLOR_yellow x'32';
// Yellow/Column Separators/Reverse
dcl-c COLOR_yellow_r x'33';
// Yellow/Underscore
dcl-c COLOR_yellow_u x'36';
//------------------------------------------------------*
// Pink
dcl-c COLOR_pink x'38';
// Pink/Reverse
dcl-c COLOR_pink_r x'39';
// Pink/Underscore
dcl-c COLOR_pink_u x'3C';
// Pink/Underscore/Reverse
dcl-c COLOR_pink_ru x'3D';
//------------------------------------------------------*
// Blue
dcl-c COLOR_blue x'3A';
// Blue/Reverse
dcl-c COLOR_blue_r x'3B';
// Blue/Underscore
dcl-c COLOR_blue_u x'3E';
//------------------------------------------------------*
// Nondisplay
dcl-c COLOR_NoneDsp1 x'27';
// Nondisplay
dcl-c COLOR_NoneDsp2 x'2F';
// Nondisplay
dcl-c COLOR_NoneDsp3 x'37';
// Nondisplay
dcl-c COLOR_NoneDsp4 x'3F';

