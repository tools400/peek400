**free
// ---------------------------------------------------------------
//  Data structure for message ID: USR8227
//  Die Zeichenkette '&1' konnte nicht in einen numerischen Wer
dcl-ds USR8227 qualified;
  var1 char(256) inz;
  var2 char(1) inz;
  var3 packed(5: 0) inz;
  var4 packed(5: 0) inz;
end-ds;
