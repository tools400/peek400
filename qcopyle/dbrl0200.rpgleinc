  b2LNmeUsed   char(10);
  b2MNmeUsed   char(10);
  b2DepFile    char(10);
  b2DepLib     char(10);
  b2DepMbr     char(10);
  b2DepType    char(1);
  b2Res_01     char(3);
  b2JoinRNbr   int(10);
  b2JoinFNbr   int(10);
  b2CnstNmeLib char(10);
  b2CnstNmeLen int(10);
  b2CnstNme    char(258);
end-ds;

