  i_pOldPath pointer options(*string) value;
  i_pNewPath pointer options(*string) value;
end-pr;

//  0/-1 = close()--Close File or Socket Descriptor    // include <unistd.h>
dcl-pr close int(10) extproc('close');
  i_fd int(10) value;
end-pr;

