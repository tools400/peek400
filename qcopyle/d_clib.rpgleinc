//  value/-1 = read()--Write from Descriptor           // include <unistd.h>
dcl-pr read extproc('read') like(ssize_t);
  i_fd      int(10) value;
  i_pBuffer pointer value;
  i_bufLen  like(size_t) value;
end-pr;

//  value/-1 = write()--Write to Descriptor            // include <unistd.h>
dcl-pr write extproc('write') like(ssize_t);
  i_fd      int(10) value;
  i_pBuffer pointer value;
  i_bufLen  like(size_t) value;
end-pr;

//  0/-1 = ftruncate()--Truncate File                  // include <unistd.h>
dcl-pr ftruncate int(10) extproc('ftruncate');
  i_fd     int(10) value;
  i_length like(off_t) value;
end-pr;

//  off_t = lseek()--Set File Read/Write Offset        // include <unistd.h>
