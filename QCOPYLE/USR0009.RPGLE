      // ---------------------------------------------------------------
      //  Data structure for message ID: USR0009

      //  Fehler beim Abrufen der Objektbeschreibung für Datei &2/&1.

     d USR0009         ds
     d  USR00091                     10A   inz(*BLANKS)
     d  USR00092                     10A   inz(*BLANKS)
     d USR0009_SIZE    s             10I 0 inz(20)

