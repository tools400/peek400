//  API format RCDL0200
//  (data structure can be used within the calling program
//  to splitt XValue into its units.)
dcl-ds rcdl0200_t qualified template;
  r2FmtName  char(10);
  r2FmtID    char(13);
  r2Res_01   char(1);
  r2RcdLen   int(10);
  r2NbrFlds  int(10);
  r2Text     char(50);
  r2Res_02   char(2);
  r2TxtCCSID int(10);
end-ds;

