?     *===============================================================*
?     *                                                               *
?     *  Definition von Konstanten für                                *
?     *  Farbattribute.                                               *
?     *                                                               *                       RADDAT
?     *===============================================================*
?     *
?     *------------------------------------------------------*
?     * Green
     D §Green          C                   CONST(X'20')                                       RADDAT
?     * Green/Reverse
     D §Green_R        C                   CONST(X'21')                                       RADDAT
?     * Green/Underscore
     D §Green_U        C                   CONST(X'24')                                       RADDAT
?     * Green/Underscore/Reverse
     D §Green_RU       C                   CONST(X'25')                                       RADDAT
?     *------------------------------------------------------*
?     * White
     D §White          C                   CONST(X'22')                                       RADDAT
?     * White/Reverse
     D §White_R        C                   CONST(X'23')                                       RADDAT
?     * White/Underscore
     D §White_U        C                   CONST(X'26')                                       RADDAT
?     *------------------------------------------------------*
?     * Red
     D §Red            C                   CONST(X'28')                                       RADDAT
?     * Red/Reverse
     D §Red_R          C                   CONST(X'29')                                       RADDAT
?     * Red/Underscore                                                                        RADDAT
     D §Red_U          C                   CONST(X'2C')                                       RADDAT
?     * Red/Underscore/Reverse                                                                RADDAT
     D §Red_RU         C                   CONST(X'2D')                                       RADDAT
?     * Red/Blink
     D §Red_B          C                   CONST(X'2A')                                       RADDAT
?     * Red/Reverse/Blink
     D §Red_RB         C                   CONST(X'2B')                                       RADDAT
?     * Red/Underscore/Blink
     D §Red_UB         C                   CONST(X'2E')                                       RADDAT
?     *------------------------------------------------------*
?     * Turquoise/Column Separators
     D §Turkis         C                   CONST(X'30')                                       RADDAT
?     * Turquoise/Column Separators/Reverse
     D §Turkis_R       C                   CONST(X'31')                                       RADDAT
?     * Turquoise/Underscore
     D §Turkis_U       C                   CONST(X'34')                                       RADDAT
?     * Turquoise/Underscore/Reverse
     D §Turkis_RU      C                   CONST(X'35')                                       RADDAT
?     *------------------------------------------------------*
?     * Yellow/Column Separators
     D §Yellow         C                   CONST(X'32')                                       RADDAT
?     * Yellow/Column Separators/Reverse
     D §Yellow_R       C                   CONST(X'33')                                       RADDAT
?     * Yellow/Underscore
     D §Yellow_U       C                   CONST(X'36')                                       RADDAT
?     *------------------------------------------------------*
?     * Pink
     D §Pink           C                   CONST(X'38')                                       RADDAT
?     * Pink/Reverse
     D §Pink_R         C                   CONST(X'39')                                       RADDAT
?     * Pink/Underscore
     D §Pink_U         C                   CONST(X'3C')                                       RADDAT
?     * Pink/Underscore/Reverse
     D §Pink_RU        C                   CONST(X'3D')                                       RADDAT
?     *------------------------------------------------------*
?     * Blue
     D §Blue           C                   CONST(X'3A')                                       RADDAT
?     * Blue/Reverse
     D §Blue_R         C                   CONST(X'3B')                                       RADDAT
?     * Blue/Underscore
     D §Blue_U         C                   CONST(X'3E')                                       RADDAT
?     *------------------------------------------------------*
?     * Nondisplay
     D §NoneDsp1       C                   CONST(X'27')                                       RADDAT
?     * Nondisplay
     D §NoneDsp2       C                   CONST(X'2F')                                       RADDAT
?     * Nondisplay
     D §NoneDsp3       C                   CONST(X'37')                                       RADDAT
?     * Nondisplay
     D §NoneDsp4       C                   CONST(X'3F')                                       RADDAT
?     *                                                                                       RADDAT
