      // ---------------------------------------------------------------
      //  Data structure for message ID: USR0002

      //  Liste der Satzformate für Datei &2/&1 konnte nicht abgerufe

     d USR0002         ds
     d  USR00021                     10A   inz(*BLANKS)
     d  USR00022                     10A   inz(*BLANKS)
     d USR0002_SIZE    s             10I 0 inz(20)

