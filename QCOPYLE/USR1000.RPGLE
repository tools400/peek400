      // ---------------------------------------------------------------
      //  Data structure for message ID: USR1000

      //  Keine Berechtigung für Datei &2/&1, Teildatei &3.

     d USR1000         ds
     d  USR10001                     10A   inz(*BLANKS)
     d  USR10002                     10A   inz(*BLANKS)
     d  USR10003                     10A   inz(*BLANKS)
     d USR1000_SIZE    s             10I 0 inz(30)

