      // ---------------------------------------------------------------
      //  Data structure for message ID: USR8123

      //  Felder mit mehr als 512-Zeichen können&1nicht&2geändert wer

     d USR8123         ds
     d  USR81231                      1A   inz(*BLANKS)
     d  USR81232                      1A   inz(*BLANKS)
     d USR8123_SIZE    s             10I 0 inz(2)

