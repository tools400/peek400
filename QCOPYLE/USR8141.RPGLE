      // ---------------------------------------------------------------
      //  Data structure for message ID: USR8141

      //  Nur '&1' für positive und '&2' für negative Zahlen als Vorz

     d USR8141         ds
     d  USR81411                     10A   inz(*BLANKS)
     d  USR81412                     10A   inz(*BLANKS)
     d USR8141_SIZE    s             10I 0 inz(20)

