      // ---------------------------------------------------------------
      //  Data structure for message ID: USR0001

      //  Satzformat &3 für Datei &2/&1 konnte nicht abgerufen werden

     d USR0001         ds
     d  USR00011                     10A   inz(*BLANKS)
     d  USR00012                     10A   inz(*BLANKS)
     d  USR00013                     10A   inz(*BLANKS)
     d USR0001_SIZE    s             10I 0 inz(30)

