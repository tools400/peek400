     /* ============================================================ */
     /*                                                              */
     /*  (c) Thomas Raddatz                                          */
     /*                                                              */
     /*  Bereich  : PEEK, Version 3.1.5                              */
     /*  Programm : PEEK94                                           */
     /*  Typ      : CLLE                                             */
     /*                                                              */
     /*  erstellt : 17.10.2008  Thomas Raddatz                       */
     /*                                                              */
     /* ============================================================ */
     /*                                                              */
     /*  Dokumentation:                                              */
     /*                                                              */
     /*  Peek/400 - Neu Linken der Programme und SrvPgme             */
     /*                                                              */
     /* ============================================================ */

          PGM        PARM(&NEWLIB     +
                          &OLDLIB     +
                          &TMPLIB     +
                          )

             DCL        VAR(&NEWLIB    ) TYPE(*CHAR) LEN(10)
             DCL        VAR(&OLDLIB    ) TYPE(*CHAR) LEN(10)
             DCL        VAR(&TMPLIB    ) TYPE(*CHAR) LEN(10)

             DCLF       FILE(*LIBL/QADSPOBJ) RCDFMT(QLIDOBJD)

             DCL        VAR(&TMPFILE2  ) TYPE(*CHAR) LEN(10) VALUE('TOOLS400.2')
             DCL        VAR(&NUMRCD2   ) TYPE(*DEC ) LEN(10 0)

/* Fehlerbehandlung     */
             DCL        VAR(&ERROR)      TYPE(*LGL) +
                          VALUE('0')
             DCL        VAR(&ERRMSGKEY)  TYPE(*CHAR) LEN(4)

             DCL        VAR(&ERRMSGTYP)  TYPE(*CHAR) LEN(10) +
                          VALUE('*DIAG')
             DCL        VAR(&ERRNBRTYP)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRPGMMSGQ) TYPE(*CHAR) LEN(10) +
                          VALUE('*')
             DCL        VAR(&ERRSTKCTR)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRCODE  )  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000000')

/* Sende alle Fehler zur Error Handling Routine */
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CHGVAR     VAR(&ERROR    ) VALUE('0')

 /* -------------------------------------------------------------- */
 /*  Aktualisieren Programme, Serviceprogramme und Befehle         */
 /* -------------------------------------------------------------- */

             OVRDBF     FILE(QADSPOBJ) TOFILE(&TMPLIB/&TMPFILE2) +
                          OVRSCOPE(*CALLLVL)

             DSPOBJD    OBJ(&NEWLIB/PEEK*) OBJTYPE(*CMD *PGM *SRVPGM) +
                          DETAIL(*BASIC) OUTPUT(*OUTFILE) +
                          OUTFILE(&TMPLIB/&TMPFILE2) +
                          OUTMBR(*FIRST *REPLACE)
             RTVMBRD    FILE(&TMPLIB/&TMPFILE2) MBR(*FIRST) +
                          NBRCURRCD(&NUMRCD2)

             OPNDBF     FILE(*LIBL/QADSPOBJ) OPTION(*INP) OPNID(F2)
 LOOP2:
             RCVF       RCDFMT(QLIDOBJD)
             MONMSG     MSGID(CPF0864) EXEC(DO)   /* End-Of-File */
                GOTO EOF2
             ENDDO

                /* Linken der SrvPgm          */
                IF         COND(&ODOBTP = '*SRVPGM') THEN(DO)
                   UPDSRVPGM  SRVPGM(&NEWLIB/&ODOBNM) MODULE(*NONE) +
                                BNDSRVPGM(&OLDLIB/PEEK*) SRVPGMLIB(&NEWLIB)
                ENDDO

                /* Linken der Programm        */
                IF         COND(&ODOBTP = '*PGM') THEN(DO)
                   UPDPGM     PGM(&NEWLIB/&ODOBNM) MODULE(*NONE) +
                                BNDSRVPGM(&OLDLIB/PEEK*) SRVPGMLIB(&NEWLIB)
                ENDDO

                /* Ändern Befehl              */
                IF         COND(&ODOBTP = '*CMD') THEN(DO)
                   CHGCMD     CMD(&NEWLIB/&ODOBNM) PRDLIB(&NEWLIB)
                ENDDO

             CHGVAR     VAR(&NUMRCD2) VALUE(&NUMRCD2 - 1)
             IF         COND(&NUMRCD2 *NE 0) THEN(GOTO CMDLBL(LOOP2))
 EOF2:
             CLOF       OPNID(F2)
             DLTOVR     FILE(QADSPOBJ) LVL(*)

 /* -------------------------------------------------------------- */

 ENDE:
             DLTOVR     FILE(*ALL) LVL(*)
             MONMSG     MSGID(CPF0000)

             DLTF       FILE(&TMPLIB/&TMPFILE2)
             MONMSG     MSGID(CPF0000)

/* Verschiebe alle *INFO Nachrichten zur             */
/* vorangegangenen Programmwarteschlange             */
             CHGVAR     VAR(&ERRMSGTYP) VALUE('*INFO')
             CALL       PGM(QMHMOVPM) PARM(&ERRMSGKEY &ERRMSGTYP +
                          &ERRNBRTYP &ERRPGMMSGQ &ERRSTKCTR &ERRCODE)

             RCLRSC     LVL(*)
             MONMSG     MSGID(CPF0000)

             IF         COND(&ERROR) THEN(DO)
                /* Sende letzte *ESCAPE nochmals   */
                CALL       PGM(QMHRSNEM) PARM(&ERRMSGKEY &ERRCODE)
                MONMSG     MSGID(CPF0000)
             ENDDO

             RETURN

/* ---------------- */
/* Error            */
/* Handling         */
/* ---------------- */
 ERROR:
             IF         COND(&ERROR) THEN(GOTO CMDLBL(ENDE))
             ELSE       CHGVAR     VAR(&ERROR) VALUE('1')

/* Verschiebe alle *DIAG Nachrichten zur             */
/* vorangegangenen Programmwarteschlange             */
             CHGVAR     VAR(&ERRMSGTYP) VALUE('*DIAG')
             CALL       PGM(QMHMOVPM) PARM(&ERRMSGKEY &ERRMSGTYP +
                          &ERRNBRTYP &ERRPGMMSGQ &ERRSTKCTR &ERRCODE)

             GOTO       CMDLBL(ENDE)

             ENDPGM

