      /*%METADATA                                                     */
      /* %TEXT Peek/400 - Löschen *UPDPGM Objekte                     */
      /*%EMETADATA                                                    */
     /* ============================================================ */
     /*                                                              */
     /*  (c) Thomas Raddatz                                          */
     /*                                                              */
     /*  Bereich  : PEEK, Version 3.0.0                              */
     /*  Programm : PEEK94                                           */
     /*  Typ      : CLLE                                             */
     /*                                                              */
     /*  erstellt : 06.08.2008  Raddatz                              */
     /*                                                              */
     /* ============================================================ */
     /*                                                              */
     /*  Dokumentation:                                              */
     /*                                                              */
     /*  Peek/400 - Löschen *UPDPGM Objekte                          */
     /*                                                              */
     /* ============================================================ */
     /* >>PRE-COMPILER<<                                             */
     /*   >>CRTCMD<< &LI/CRTPEEKOBJ SRCFILE(&SL/&SF) SRCMBR(&SM) +   */
     /*                           OBJLIB(&LI) DEVLIB(&LI) +          */
     /*                           SBMJOB(*NO) BNDDIR(PEEK) +         */
     /*                           INSTALL(*NO);                      */
     /*   >>EXECUTE<<                                                */
     /* >>END-PRE-COMPILER<<                                         */
     /* ============================================================ */

             PGM        PARM(&LIB)

             DCL        VAR(&Lib       ) TYPE(*CHAR) LEN(10)

             DCL        VAR(&UPDPGM    ) TYPE(*CHAR) LEN( 7)

             DCLF       FILE(QADSPOBJ)

/* Fehlerbehandlung     */
             DCL        VAR(&ERROR)      TYPE(*LGL) +
                          VALUE('0')
             DCL        VAR(&ERRMSGKEY)  TYPE(*CHAR) LEN(4)

             DCL        VAR(&ERRMSGTYP)  TYPE(*CHAR) LEN(10) +
                          VALUE('*DIAG')
             DCL        VAR(&ERRNBRTYP)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRPGMMSGQ) TYPE(*CHAR) LEN(10) +
                          VALUE('*')
             DCL        VAR(&ERRSTKCTR)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRCODE  )  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000000')

/* Sende alle Fehler zur Error Handling Routine */

             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CHGVAR     VAR(&ERROR    ) VALUE('0')

/* -------------------------------------------------------------- */
/*  Los geht's                                                    */
/* -------------------------------------------------------------- */
             DSPOBJD    OBJ(&LIB/*ALL) OBJTYPE(*ALL) DETAIL(*BASIC) +
                          OUTPUT(*OUTFILE) OUTFILE(QTEMP/PEEK94)

             OVRDBF     FILE(QADSPOBJ) TOFILE(QTEMP/PEEK94) +
                          OVRSCOPE(*CALLLVL)

 LOOP:       RCVF       RCDFMT(QLIDOBJD)
             MONMSG   CPF0864  EXEC(GOTO EOF)

             CHGVAR     VAR(&UPDPGM) VALUE(%SST(&ODOBTX 44 7))
             IF         COND(&UPDPGM *EQ '*UPDPGM') THEN(DO)
             IF         COND(&ODOBTP *EQ '*PGM') THEN(DO)
                DLTPGM     PGM(&ODLBNM/&ODOBNM)
             ENDDO
             IF         COND(&ODOBTP *EQ '*FILE') THEN(DO)
                DLTF       FILE(&ODLBNM/&ODOBNM)
             ENDDO
             ENDDO

             GOTO       CMDLBL(LOOP)
 EOF:

/* -------------------------------------------------------------- */

ENDE:
/* Verschiebe alle *INFO Nachrichten zur             */
/* vorangegangenen Programmwarteschlange             */
             CHGVAR     VAR(&ERRMSGTYP) VALUE('*INFO')
             CALL       PGM(QMHMOVPM) PARM(&ERRMSGKEY &ERRMSGTYP +
                          &ERRNBRTYP &ERRPGMMSGQ &ERRSTKCTR &ERRCODE)

             IF         COND(&ERROR) THEN(DO)
                /* Sende letzte *ESCAPE nochmals   */
                CALL       PGM(QMHRSNEM) PARM(&ERRMSGKEY &ERRCODE)
                MONMSG     MSGID(CPF0000)
             ENDDO

             RETURN

/* ---------------- */
/* Error            */
/* Handling         */
/* ---------------- */
 ERROR:
             IF         COND(&ERROR) THEN(GOTO CMDLBL(ENDE))
             ELSE       CHGVAR     VAR(&ERROR) VALUE('1')

/* Verschiebe alle *DIAG Nachrichten zur             */
/* vorangegangenen Programmwarteschlange             */
             CHGVAR     VAR(&ERRMSGTYP) VALUE('*DIAG')
             CALL       PGM(QMHMOVPM) PARM(&ERRMSGKEY &ERRMSGTYP +
                          &ERRNBRTYP &ERRPGMMSGQ &ERRSTKCTR &ERRCODE)

             GOTO       CMDLBL(ENDE)

             ENDPGM
