      /*%METADATA                                                     */
      /* %TEXT Peek/400 - Change object authority of Peek/400         */
      /*%EMETADATA                                                    */
     /* ============================================================ */
     /*  (c) Thomas Raddatz                                          */
     /*                                                              */
     /*  Appl.    : PEEK, Version 3.4.2                              */
     /*  Program  : PEEK96A                                          */
     /*  Type     : CLLE                                             */
     /*                                                              */
     /*  Created  : 06.08.2008  Raddatz                              */
     /* ============================================================ */
     /*  Title:                                                      */
     /*    Peek/400 - Change object authority of Peek/400            */
     /*  Documentation:                                              */
     /*    Changes the owner of a given object to a given owner.     */
     /* ============================================================ */
     /* >>PRE-COMPILER<<                                             */
     /*   >>CRTCMD<< &LI/CRTPEEKOBJ SRCFILE(&SL/&SF) SRCMBR(&SM) +   */
     /*                           OBJLIB(&LI) DEVLIB(&LI) +          */
     /*                           SBMJOB(*NO) BNDDIR(PEEK) +         */
     /*                           INSTALL(*NO);                      */
     /*   >>EXECUTE<<                                                */
     /* >>END-PRE-COMPILER<<                                         */
     /* ============================================================ */
             PGM        PARM(&OBJECT &LIB &TYPE &NEWOWN)

             DCL        VAR(&OBJECT    ) TYPE(*CHAR) LEN(10)
             DCL        VAR(&LIB       ) TYPE(*CHAR) LEN(10)
             DCL        VAR(&TYPE      ) TYPE(*CHAR) LEN(10)
             DCL        VAR(&AUT       ) TYPE(*CHAR) LEN(10)
             DCL        VAR(&NEWOWN    ) TYPE(*CHAR) LEN(10)

             DCL        VAR(&NEWOWN2   ) TYPE(*CHAR) LEN(10) VALUE('RADDATZ')

/* Error handler        */
             DCL        VAR(&ERROR)      TYPE(*LGL) +
                          VALUE('0')
             DCL        VAR(&ERRMSGKEY)  TYPE(*CHAR) LEN(4)

             DCL        VAR(&ERRMSGTYP)  TYPE(*CHAR) LEN(10) +
                          VALUE('*DIAG')
             DCL        VAR(&ERRNBRTYP)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRPGMMSGQ) TYPE(*CHAR) LEN(10) +
                          VALUE('*')
             DCL        VAR(&ERRSTKCTR)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRCODE  )  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000000')

/* Send all errors to the error handler */

             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CHGVAR     VAR(&ERROR    ) VALUE('0')

/* -------------------------------------------------------------- */
/*  Let's start                                                   */
/* -------------------------------------------------------------- */
             CHGVAR     VAR(&NEWOWN2) VALUE(&NEWOWN)
             MONMSG     MSGID(MCH3601) EXEC(DO)
                RMVMSG     PGMQ(*SAME (*)) CLEAR(*ALL)
             ENDDO

             CHGVAR     VAR(&AUT) VALUE('*CHANGE')
             IF         COND(&TYPE *EQ '*FILE') THEN(DO)
               IF         COND(&OBJECT *EQ 'PEEKENV'   *OR        +
                               &OBJECT *EQ 'PEEKFLD'   *OR        +
                               &OBJECT *EQ 'PEEKFLDL0' *OR        +
                               &OBJECT *EQ 'PEEKFLDL1' *OR        +
                               &OBJECT *EQ 'PEEKFLDL2' *OR        +
                               &OBJECT *EQ 'PEEKFMT'   *OR        +
                               &OBJECT *EQ 'PEEKUSR'   *OR        +
                               &OBJECT *EQ 'PEEKWRK'   ) THEN(DO)
                 CHGVAR     VAR(&AUT) VALUE('*ALL')
               ENDDO
             ENDDO

             CHGOBJOWN  OBJ(&LIB/&OBJECT) OBJTYPE(&TYPE) +
                          NEWOWN(&NEWOWN2) CUROWNAUT(*REVOKE)

             RVKOBJAUT  OBJ(&LIB/&OBJECT) OBJTYPE(&TYPE) USER(*ALL) +
                          AUT(*ALL)

             GRTOBJAUT  OBJ(&LIB/&OBJECT) OBJTYPE(&TYPE) +
                          USER(*PUBLIC) AUT(&AUT)

             IF         COND(&TYPE *EQ '*PGM') THEN(DO)
               CHGPGM     PGM(&LIB/&OBJECT) USEADPAUT(*NO)
             ENDDO

             IF         COND(&TYPE *EQ '*SRVPGM') THEN(DO)
               CHGSRVPGM  SRVPGM(&LIB/&OBJECT) USEADPAUT(*NO)
             ENDDO

/* -------------------------------------------------------------- */

ENDE:
/* Move all *INFO messages to the caller's           */
/* message queue.                                    */
             CHGVAR     VAR(&ERRMSGTYP) VALUE('*INFO')
             CALL       PGM(QMHMOVPM) PARM(&ERRMSGKEY &ERRMSGTYP +
                          &ERRNBRTYP &ERRPGMMSGQ &ERRSTKCTR &ERRCODE)

             IF         COND(&ERROR) THEN(DO)
                /* Resend last *ESCAPE message */
                CALL       PGM(QMHRSNEM) PARM(&ERRMSGKEY &ERRCODE)
                MONMSG     MSGID(CPF0000)
             ENDDO

             RETURN

/* ---------------- */
/* Error            */
/* handler          */
/* ---------------- */
 ERROR:
             IF         COND(&ERROR) THEN(GOTO CMDLBL(ENDE))
             ELSE       CHGVAR     VAR(&ERROR) VALUE('1')

/* Move all *DIAG messages to the caller's           */
/* message queue.                                    */
             CHGVAR     VAR(&ERRMSGTYP) VALUE('*DIAG')
             CALL       PGM(QMHMOVPM) PARM(&ERRMSGKEY &ERRMSGTYP +
                          &ERRNBRTYP &ERRPGMMSGQ &ERRSTKCTR &ERRCODE)

             GOTO       CMDLBL(ENDE)

             ENDPGM
