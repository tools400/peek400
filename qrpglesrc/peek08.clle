      /*%METADATA                                                     */
      /* %TEXT Peek/400 - Generieren RPG-LE Programm                  */
      /*%EMETADATA                                                    */
     /* ============================================================ */
     /*                                                              */
     /*  (c) Thomas Raddatz                                          */
     /*                                                              */
     /*  Bereich  : PEEK, Version 2.2.0                              */
     /*  Programm : PEEK08                                           */
     /*  Typ      : CLP                                              */
     /*                                                              */
     /*  erstellt : 13.10.1997  Raddatz                              */
     /*  geändert : 22.07.1999  Raddatz für Version 2.2              */
     /*                                                              */
     /* ============================================================ */
     /*                                                              */
     /*  Dokumentation:                                              */
     /*                                                              */
     /*  Generieren RPG-Programm                                     */
     /*                                                              */
     /* ============================================================ */
     /* >>PRE-COMPILER<<                                             */
     /*   >>CRTCMD<< &LI/CRTPEEKOBJ SRCFILE(&SL/&SF) SRCMBR(&SM) +   */
     /*                           OBJLIB(&LI) DEVLIB(&LI) +          */
     /*                           SBMJOB(*NO) BNDDIR(PEEK) +         */
     /*                           INSTALL(*NO);                      */
     /*   >>EXECUTE<<                                                */
     /* >>END-PRE-COMPILER<<                                         */
     /* ============================================================ */

          PGM        PARM(&QFILE      +
                          &PGM        +
                          &FORMATNAME +
                          &FORMATID   +
                          &ALWLC      +
                          &CASE       +
                          &RCDLOCK    +
                          &NULLDFT    +
                          &KEEPCRS    +
                          &PRODLIB    +
                          &RTNCODE    )

          DCL        VAR(&QFILE     ) TYPE(*CHAR)  LEN(20)
          DCL        VAR(&PGM       ) TYPE(*CHAR)  LEN(10)
          DCL        VAR(&FORMATNAME) TYPE(*CHAR)  LEN(10)
          DCL        VAR(&FORMATID  ) TYPE(*CHAR)  LEN(13)
          DCL        VAR(&ALWLC     ) TYPE(*LGL )
          DCL        VAR(&CASE      ) TYPE(*LGL )
          DCL        VAR(&RCDLOCK   ) TYPE(*LGL )
          DCL        VAR(&NULLDFT   ) TYPE(*LGL )
          DCL        VAR(&KEEPCRS   ) TYPE(*LGL )
          DCL        VAR(&PRODLIB   ) TYPE(*CHAR)  LEN(10)
          DCL        VAR(&RTNCODE   ) TYPE(*LGL )

/* Anzahl Bildschirme, 2-Byte-Binärzahl wie int2_t in PEEK15/PEEK16 */
          DCL        VAR(&SCNNBRS   ) TYPE(*INT )  LEN(2)
          DCL        VAR(&LOWERCASE ) TYPE(*LGL )
          DCL        VAR(&DSPF      ) TYPE(*CHAR)  LEN(10)
          DCL        VAR(&COPY1     ) TYPE(*CHAR)  LEN(10)
          DCL        VAR(&COPY2     ) TYPE(*CHAR)  LEN(10)
          DCL        VAR(&COPY3     ) TYPE(*CHAR)  LEN(10)
          DCL        VAR(&COPY4     ) TYPE(*CHAR)  LEN(10)
          DCL        VAR(&COPY5     ) TYPE(*CHAR)  LEN(10)
          DCL        VAR(&COPY6     ) TYPE(*CHAR)  LEN(10)
/* Eingabebestimmungen (Fixed-Form), /include im RPG-Programm */
          DCL        VAR(&COPY7     ) TYPE(*CHAR)  LEN(10)
          DCL        VAR(&FILE      ) TYPE(*CHAR)  LEN(10)
          DCL        VAR(&LIB       ) TYPE(*CHAR)  LEN(10)
          DCL        VAR(&UPDPGM    ) TYPE(*CHAR)  LEN( 7)  VALUE('*UPDPGM')
          DCL        VAR(&TEXT      ) TYPE(*CHAR)  LEN(50)
          DCL        VAR(&DBGVIEW   ) TYPE(*CHAR)  LEN(10) VALUE(*SOURCE)

/* Parameter der Subroutinen PRPSRCMBR und OVRGEN */
          DCL        VAR(&SRCMBR    ) TYPE(*CHAR)  LEN(10)
          DCL        VAR(&SRCTYPE   ) TYPE(*CHAR)  LEN(10)
          DCL        VAR(&TMPLMBR   ) TYPE(*CHAR)  LEN(10)

          DCL        VAR(&NUMVAL    ) TYPE(*DEC )  LEN(10 0)
          DCL        VAR(&STAGE     ) TYPE(*CHAR)  LEN( 4)
          DCL        VAR(&NUMSTAGES ) TYPE(*INT )  LEN( 4)

          DCL        VAR(&STSMSG    ) TYPE(*CHAR)  LEN( 7)

          DCL        VAR(&PGRMTR_TXT) TYPE(*CHAR)  LEN(20)
          DCL        VAR(&PGRMTR_MAX) TYPE(*int )  LEN( 4)
          DCL        VAR(&PGRMTR_BLU) TYPE(*CHAR)  LEN( 1)
          DCL        VAR(&PGRMTR_SEC) TYPE(*CHAR)  LEN( 4)
          DCL        VAR(&PGRMTR_JOB) TYPE(*CHAR)  LEN(10)
          DCL        VAR(&PGRMTR_COL) TYPE(*CHAR)  LEN( 4)

          DCL        VAR(&TRUE      ) TYPE(*LGL )  LEN( 1 ) +
                                      VALUE('1')
          DCL        VAR(&FALSE     ) TYPE(*LGL )  LEN( 1 ) +
                                      VALUE('0')

/* Fehlerbehandlung     */
             DCL        VAR(&ERROR)      TYPE(*LGL) +
                          VALUE('0')
             DCL        VAR(&ERRMSGKEY)  TYPE(*CHAR) LEN(4)

             DCL        VAR(&ERRMSGTYP)  TYPE(*CHAR) LEN(10) +
                          VALUE('*DIAG')
             DCL        VAR(&ERRNBRTYP)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRPGMMSGQ) TYPE(*CHAR) LEN(10) +
                          VALUE('*')
             DCL        VAR(&ERRSTKCTR)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRCODE  )  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000000')

/* Sende alle Fehler zur Error Handling Routine */
             MONMSG     MSGID(CPF0000 RNS9309) EXEC(GOTO CMDLBL(ERROR))

             CHGVAR     VAR(&ERROR    ) VALUE('0')

 /* -------------------------------------------------------------- */
 /*  Los geht's                                                    */
 /* -------------------------------------------------------------- */

             CHGVAR     VAR(&RTNCODE) VALUE(&TRUE)

    /*       SNDPGMMSG  MSGID(USR8114) MSGF(&PRODLIB/PEEKGER) +      */
    /*                  TOPGMQ(*EXT) MSGTYPE(*STATUS)                */

             RTVJOBA    STSMSG(&STSMSG)

 /*  Ermitteln Debug View           */
             RTVDTAARA  DTAARA(*LIBL/PEEKPGM (107 4)) RTNVAR(&DBGVIEW)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                RMVMSG     PGMQ(*SAME (*)) CLEAR(*ALL)
                CHGVAR     VAR(&DBGVIEW) VALUE(*NO)
             ENDDO

             IF         COND(&DBGVIEW *EQ '*YES') THEN(DO)
                CHGVAR     VAR(&DBGVIEW) VALUE(*LIST)
             ENDDO
             ELSE DO
                CHGVAR     VAR(&DBGVIEW) VALUE(*SOURCE)
             ENDDO


 /*  Ermitteln Generierungsaufwand  */
             CALL       PGM(&PRODLIB/PEEK60) PARM(       +
                                             &ALWLC      +
                                             &NUMSTAGES  +
                                             )

             CHGVAR     VAR(%BIN(&STAGE  1 4)) VALUE(0)

             CHGVAR     VAR(&PGRMTR_TXT)      VALUE(' ')
             CHGVAR     VAR(&PGRMTR_MAX)      VALUE(&NUMSTAGES)
             CHGVAR     VAR(&PGRMTR_BLU)      VALUE(X'3B')
             CHGVAR     VAR(%BIN(&PGRMTR_SEC 1 4)) VALUE(0)
             CHGVAR     VAR(&PGRMTR_JOB)      VALUE('*ALL')
             CHGVAR     VAR(%BIN(&PGRMTR_COL 1 4)) VALUE(38)
             CALLPRC    PRC(P_INZPROGRESSMETER) +
                          PARM((&PGRMTR_TXT )   +
                               (&PGRMTR_MAX )   +
                               (&PGRMTR_BLU )   +
                               (&PGRMTR_SEC )   +
                               (&PGRMTR_JOB )   +
                               (&PGRMTR_COL ))

             CALLPRC    PRC(P_SHOWPROGRESSMETER) +
                          PARM((&STAGE      ))

 /*  OBJ-NAMEN */
             CHGVAR     VAR(&DSPF)            VALUE(&PGM)
             CHGVAR     VAR(%SST(&DSPF 1 1))  VALUE('F')
             CHGVAR     VAR(&COPY1)           VALUE(&PGM)
             CHGVAR     VAR(%SST(&COPY1 1 1)) VALUE('A')
             CHGVAR     VAR(&COPY2)           VALUE(&PGM)
             CHGVAR     VAR(%SST(&COPY2 1 1)) VALUE('B')
             CHGVAR     VAR(&COPY3)           VALUE(&PGM)
             CHGVAR     VAR(%SST(&COPY3 1 1)) VALUE('C')
             CHGVAR     VAR(&COPY4)           VALUE(&PGM)
             CHGVAR     VAR(%SST(&COPY4 1 1)) VALUE('D')
             CHGVAR     VAR(&COPY5)           VALUE(&PGM)
             CHGVAR     VAR(%SST(&COPY5 1 1)) VALUE('E')
             CHGVAR     VAR(&COPY6)           VALUE(&PGM)
             CHGVAR     VAR(%SST(&COPY6 1 1)) VALUE('G')
             CHGVAR     VAR(&COPY7)           VALUE(&PGM)
             CHGVAR     VAR(%SST(&COPY7 1 1)) VALUE('I')

             CHGVAR     VAR(&FILE) VALUE(%SST(&QFILE  1 10))
             CHGVAR     VAR(&LIB)  VALUE(%SST(&QFILE 11 10))

 /*  QPEEKGEN  */
             CHKOBJ     OBJ(QTEMP/QPEEKGEN ) OBJTYPE(*FILE) MBR(*NONE) +
                          AUT(*NONE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
               CRTSRCPF   FILE(QTEMP/QPEEKGEN ) RCDLEN(112) MBR(*NONE) +
                          IGCDTA(*NO) TEXT('PEEK - Arbeitsbereich')
             ENDDO

 /*  SRC-MBR   */
             CHGVAR     VAR(&TEXT) VALUE(&QFile *CAT &FormatID *CAT +
                          &FormatName *CAT &UpdPgm)

 /*  DSP-FILE  */
             CHGVAR     VAR(&SRCMBR ) VALUE(&DSPF)
             CHGVAR     VAR(&SRCTYPE) VALUE('DSPF')
             CALLSUBR   SUBR(PRPSRCMBR)

 /*  COPY1 - COPY7  */
             CHGVAR     VAR(&SRCTYPE) VALUE('RPGLE')
             CHGVAR     VAR(&SRCMBR ) VALUE(&COPY1)
             CALLSUBR   SUBR(PRPSRCMBR)
             CHGVAR     VAR(&SRCMBR ) VALUE(&COPY2)
             CALLSUBR   SUBR(PRPSRCMBR)
             CHGVAR     VAR(&SRCMBR ) VALUE(&COPY3)
             CALLSUBR   SUBR(PRPSRCMBR)
             CHGVAR     VAR(&SRCMBR ) VALUE(&COPY4)
             CALLSUBR   SUBR(PRPSRCMBR)
             CHGVAR     VAR(&SRCMBR ) VALUE(&COPY5)
             CALLSUBR   SUBR(PRPSRCMBR)
             CHGVAR     VAR(&SRCMBR ) VALUE(&COPY6)
             CALLSUBR   SUBR(PRPSRCMBR)
             CHGVAR     VAR(&SRCMBR ) VALUE(&COPY7)
             CALLSUBR   SUBR(PRPSRCMBR)

 /*  OVRDBF'S  */
             CHGVAR     VAR(&SRCMBR ) VALUE(&DSPF)
             CHGVAR     VAR(&TMPLMBR) VALUE('DSPF')
             CALLSUBR   SUBR(OVRGEN)

 /*  PROGRAMM STARTEN  */
             RMVMSG     PGMQ(*SAME (*)) CLEAR(*ALL)

 /*  DISPLAY-FILE      */
             CHGVAR     VAR(&LOWERCASE) VALUE(&FALSE)
             CALL       PGM(&PRODLIB/PEEK15) PARM(       +
                                             &QFILE      +
                                             &SCNNBRS    +
                                             &LOWERCASE  +
                                             &STAGE      +
                                             &NUMSTAGES  +
                                             )

             IF         COND(&ALWLC *EQ &TRUE) THEN(DO)
                CHGVAR     VAR(&LOWERCASE) VALUE(&TRUE)
                CALL       PGM(&PRODLIB/PEEK15) PARM(       +
                                                &QFILE      +
                                                &SCNNBRS    +
                                                &LOWERCASE  +
                                                &STAGE      +
                                                &NUMSTAGES  +
                                                )
             ENDDO

             CALLSUBR   SUBR(DLTOVRGEN)

 /*  SRC-MBR   */
 /*  PROGRAMM  */
             CHGVAR     VAR(&SRCMBR ) VALUE(&PGM)
             CHGVAR     VAR(&SRCTYPE) VALUE('RPGLE')
             CALLSUBR   SUBR(PRPSRCMBR)

 /*  OVRDBF'S  */
             CHGVAR     VAR(&SRCMBR ) VALUE(&PGM)
             CHGVAR     VAR(&TMPLMBR) VALUE('PGM')
             CALLSUBR   SUBR(OVRGEN)

 /*  PROGRAMM STARTEN  */
             RMVMSG     PGMQ(*SAME (*)) CLEAR(*ALL)

 /*  RPG-PROGRAMM      */
             CALL       PGM(&PRODLIB/PEEK16) PARM(       +
                                             &PRODLIB    +
                                             &QFILE      +
                                             &FORMATNAME +
                                             &SCNNBRS    +
                                             &ALWLC      +
                                             &CASE       +
                                             &RCDLOCK    +
                                             &NULLDFT    +
                                             &KEEPCRS    +
                                             &STAGE      +
                                             &NUMSTAGES  +
                                             )

             CALLSUBR   SUBR(DLTOVRGEN)

 /*  CRTDSPF           */
             CHGVAR     VAR(&NUMVAL) VALUE(%BIN(&STAGE 1 4) + 1)
             CHGVAR     VAR(%BIN(&STAGE 1 4)) VALUE(&NUMVAL)
             CALLPRC    PRC(P_SHOWPROGRESSMETER) +
                          PARM((&STAGE      ))

             CHGJOB     STSMSG(*NONE)
             CRTDSPF    FILE(&PRODLIB/&DSPF) +
                          SRCFILE(QTEMP/QPEEKGEN ) SRCMBR(&DSPF) +
                          REPLACE(*YES) RSTDSP(*YES)
             CHGJOB     STSMSG(&STSMSG)

             DLTSPLF    FILE(&DSPF) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF0000)

 /*  CRTRPGMOD         */
             CHGVAR     VAR(&NUMVAL) VALUE(%BIN(&STAGE 1 4) + 1)
             CHGVAR     VAR(%BIN(&STAGE 1 4)) VALUE(&NUMVAL)
             CALLPRC    PRC(P_SHOWPROGRESSMETER) +
                          PARM((&STAGE      ))

             OVRDSPF    FILE(DSPF)    TOFILE(&PRODLIB/&DSPF) +
                          OVRSCOPE(*CALLLVL)
             OVRDBF     FILE(FILE00)  TOFILE(&LIB/&FILE)     +
                          OVRSCOPE(*CALLLVL)
             OVRDBF     FILE(PEEKFLD) TOFILE(QTEMP/PEEKFLD)  +
                          OVRSCOPE(*CALLLVL)

             CHGJOB     STSMSG(*NONE)
             CRTRPGMOD  MODULE(QTEMP/&PGM) +
                          SRCFILE(QTEMP/QPEEKGEN ) +
                          SRCMBR(&PGM) +
                          CVTOPT(*DATETIME) +
                     /*          *VARCHAR   +     */  +
                     /*          *VARGRAPHIC) +   */  +
                          REPLACE(*YES) +
                          TRUNCNBR(*NO) +
                          TGTRLS(*CURRENT) +
                          DBGVIEW(&DBGVIEW)
             CHGJOB     STSMSG(&STSMSG)

             CHGVAR     VAR(&NUMVAL) VALUE(%BIN(&STAGE 1 4) + 1)
             CHGVAR     VAR(%BIN(&STAGE 1 4)) VALUE(&NUMVAL)
             CALLPRC    PRC(P_SHOWPROGRESSMETER) +
                          PARM((&STAGE      ))

             CHGJOB     STSMSG(*NONE)
             CRTPGM     PGM(&PRODLIB/&PGM) +
                          MODULE(QTEMP/&PGM) +
                          ACTGRP(PEEKUPD) +
                          REPLACE(*YES) +
                          BNDSRVPGM(&PRODLIB/PEEK58) +
                          TGTRLS(*CURRENT)
             CHGJOB     STSMSG(&STSMSG)

             DLTMOD     MODULE(QTEMP/&PGM)

             DLTSPLF    FILE(&PGM ) JOB(*) SPLNBR(*LAST)
             MONMSG     MSGID(CPF0000)

             DLTOVR     FILE(DSPF  ) LVL(*)
             DLTOVR     FILE(FILE00) LVL(*)

             CHGVAR     VAR(&RTNCODE) VALUE(&FALSE)

             CHGVAR     VAR(&NUMVAL) VALUE(%BIN(&STAGE 1 4) + 1)
             CHGVAR     VAR(%BIN(&STAGE 1 4)) VALUE(&NUMVAL)
             CALLPRC    PRC(P_SHOWPROGRESSMETER) +
                          PARM((&STAGE      ))

 ENDE:
             CHGJOB     STSMSG(&STSMSG)
             MONMSG     MSGID(CPF0000)

             SNDPGMMSG  MSGID(CPF9897) MSGF(*LIBL/QCPFMSG) +
                          TOPGMQ(*EXT) MSGTYPE(*STATUS)
             MONMSG     MSGID(CPF0000)

             RCLRSC     LVL(*)
             MONMSG     MSGID(CPF0000)

             DLTOVR     FILE(*ALL) LVL(*)
             MONMSG     MSGID(CPF0000)

             IF         COND(&ERROR) THEN(DO)
                /* Sende letzte *ESCAPE nochmals   */
                CALL       PGM(QMHRSNEM) PARM(&ERRMSGKEY &ERRCODE)
             ENDDO

             RETURN

/* ---------------- */
/* Error            */
/* Handling         */
/* ---------------- */
 ERROR:

             IF         COND(&ERROR) THEN(GOTO CMDLBL(ENDE))
             ELSE       CHGVAR     VAR(&ERROR) VALUE(&TRUE)

/* Verschiebe alle *DIAG Nachrichten zur             */
/* vorangegangenen Programmwarteschlange             */
             CALL       PGM(QMHMOVPM) PARM(&ERRMSGKEY &ERRMSGTYP +
                          &ERRNBRTYP &ERRPGMMSGQ &ERRSTKCTR &ERRCODE)

             GOTO       CMDLBL(ENDE)

/* ---------------------------------------------------------------- */
/* Quellteildatei &SRCMBR in QTEMP/QPEEKGEN anlegen und leeren      */
/* (Teildatei-Art &SRCTYPE)                                         */
/* ---------------------------------------------------------------- */
             SUBR       SUBR(PRPSRCMBR)

               CHKOBJ     OBJ(QTEMP/QPEEKGEN ) OBJTYPE(*FILE) +
                            MBR(&SRCMBR) AUT(*NONE)
               MONMSG     MSGID(CPF9815) EXEC(DO)
                 ADDPFM     FILE(QTEMP/QPEEKGEN ) MBR(&SRCMBR)
               ENDDO

               CLRPFM     FILE(QTEMP/QPEEKGEN ) MBR(&SRCMBR)
               CHGPFM     FILE(QTEMP/QPEEKGEN ) MBR(&SRCMBR) +
                            SRCTYPE(&SRCTYPE) TEXT(&TEXT)

             ENDSUBR

/* ---------------------------------------------------------------- */
/* Overrides für die Generierung: QPEEKGEN auf &SRCMBR, QCOPYLE1 -  */
/* QCOPYLE7 auf &COPY1 - &COPY7 und PEEKSRC auf die Vorlage         */
/* &TMPLMBR                                                         */
/* ---------------------------------------------------------------- */
             SUBR       SUBR(OVRGEN)

               OVRDBF     FILE(QPEEKGEN ) TOFILE(QTEMP/QPEEKGEN ) +
                            MBR(&SRCMBR) SECURE(*YES) +
                            OVRSCOPE(*CALLLVL) SHARE(*NO)

               OVRDBF     FILE(QCOPYLE1 ) TOFILE(QTEMP/QPEEKGEN ) +
                            MBR(&COPY1) SECURE(*YES) +
                            OVRSCOPE(*CALLLVL) SHARE(*NO)

               OVRDBF     FILE(QCOPYLE2 ) TOFILE(QTEMP/QPEEKGEN ) +
                            MBR(&COPY2) SECURE(*YES) +
                            OVRSCOPE(*CALLLVL) SHARE(*NO)

               OVRDBF     FILE(QCOPYLE3 ) TOFILE(QTEMP/QPEEKGEN ) +
                            MBR(&COPY3) SECURE(*YES) +
                            OVRSCOPE(*CALLLVL) SHARE(*NO)

               OVRDBF     FILE(QCOPYLE4 ) TOFILE(QTEMP/QPEEKGEN ) +
                            MBR(&COPY4) SECURE(*YES) +
                            OVRSCOPE(*CALLLVL) SHARE(*NO)

               OVRDBF     FILE(QCOPYLE5 ) TOFILE(QTEMP/QPEEKGEN ) +
                            MBR(&COPY5) SECURE(*YES) +
                            OVRSCOPE(*CALLLVL) SHARE(*NO)

               OVRDBF     FILE(QCOPYLE6 ) TOFILE(QTEMP/QPEEKGEN ) +
                            MBR(&COPY6) SECURE(*YES) +
                            OVRSCOPE(*CALLLVL) SHARE(*NO)

               OVRDBF     FILE(QCOPYLE7 ) TOFILE(QTEMP/QPEEKGEN ) +
                            MBR(&COPY7) SECURE(*YES) +
                            OVRSCOPE(*CALLLVL) SHARE(*NO)

               OVRDBF     FILE(PEEKSRC  ) TOFILE(&PRODLIB/PEEKSRC) +
                            MBR(&TMPLMBR) SECURE(*YES) +
                            OVRSCOPE(*CALLLVL) SHARE(*NO)

             ENDSUBR

/* ---------------------------------------------------------------- */
/* Overrides für die Generierung entfernen                          */
/* ---------------------------------------------------------------- */
             SUBR       SUBR(DLTOVRGEN)

               DLTOVR     FILE(QCOPYLE1 ) LVL(*)
               DLTOVR     FILE(QCOPYLE2 ) LVL(*)
               DLTOVR     FILE(QCOPYLE3 ) LVL(*)
               DLTOVR     FILE(QCOPYLE4 ) LVL(*)
               DLTOVR     FILE(QCOPYLE5 ) LVL(*)
               DLTOVR     FILE(QCOPYLE6 ) LVL(*)
               DLTOVR     FILE(QCOPYLE7 ) LVL(*)
               DLTOVR     FILE(QPEEKGEN ) LVL(*)
               DLTOVR     FILE(PEEKSRC  ) LVL(*)

             ENDSUBR

             ENDPGM

