      /*%METADATA                                                     */
      /* %TEXT Peek/400 - Befehlsausführungsprogramm ACTGRP: *CAL     */
      /*%EMETADATA                                                    */
     /* ============================================================ */
     /*                                                              */
     /*  (c) Thomas Raddatz                                          */
     /*                                                              */
     /*  Bereich  : PEEK, Version 2.1.0                              */
     /*  Programm : PEEK                                             */
     /*  Typ      : RPG                                              */
     /*                                                              */
     /*  erstellt : 16.10.97                                         */
     /*  geändert : 27.04.99  für Version 2.1.0                      */
     /*                                                              */
     /* ============================================================ */
     /*                                                              */
     /*  Dokumentation:                                              */
     /*                                                              */
     /*  Befehlsausführungsprogramm für PEEK/400                     */
     /*                                                              */
     /* ============================================================ */

          PGM        PARM(&QFILE     +
                          &MEMBER    +
                          &ACCESS    +
                          &LANG4     +
                          &CHGLIB    +
                          &CHGFILE   +
                          &CHGMBR    +
                          &UPDMOD    +
                          &CHGSQLW   +
                          &CHGSQLO   +
                          &QENVFILE  +
                          &ENVMBR    +
                          &ENVSAVE   +
                          &ENVLAYOUT +
                          &SETTINGS  +
                          &WHERE     +
                          &ORDERBY   )

          DCL        VAR(&QFILE    )   TYPE(*CHAR)  LEN(20)
          DCL        VAR(&MEMBER   )   TYPE(*CHAR)  LEN(10)
          DCL        VAR(&ACCESS   )   TYPE(*CHAR)  LEN( 1)
          DCL        VAR(&LANG4    )   TYPE(*CHAR)  LEN( 4)
          DCL        VAR(&CHGLIB   )   TYPE(*CHAR)  LEN( 1)
          DCL        VAR(&CHGFILE  )   TYPE(*CHAR)  LEN( 1)
          DCL        VAR(&CHGMBR   )   TYPE(*CHAR)  LEN( 1)
          DCL        VAR(&UPDMOD   )   TYPE(*CHAR)  LEN( 1)
          DCL        VAR(&CHGSQLW  )   TYPE(*CHAR)  LEN( 1)
          DCL        VAR(&CHGSQLO  )   TYPE(*CHAR)  LEN( 1)
          DCL        VAR(&QENVFILE )   TYPE(*CHAR)  LEN(20)
          DCL        VAR(&ENVMBR   )   TYPE(*CHAR)  LEN(10)
          DCL        VAR(&ENVSAVE  )   TYPE(*CHAR)  LEN( 1)
          DCL        VAR(&ENVLAYOUT)   TYPE(*CHAR)  LEN( 1)
          DCL        VAR(&WHERE    )   TYPE(*CHAR)  LEN(514)
          DCL        VAR(&SETTINGS )   TYPE(*CHAR)  LEN(20)
          DCL        VAR(&ORDERBY  )   TYPE(*CHAR)  LEN(514)

          DCL        VAR(&PRODLIB  )   TYPE(*CHAR)  LEN(10)
          DCL        VAR(&PROGRAM  )   TYPE(*CHAR)  LEN(10)
          DCL        VAR(&LANGUAGE )   TYPE(*CHAR)  LEN(10)

/* Fehlerbehandlung     */
             DCL        VAR(&ERROR)      TYPE(*LGL) +
                          VALUE('0')
             DCL        VAR(&ERRMSGKEY)  TYPE(*CHAR) LEN(4)

             DCL        VAR(&ERRMSGTYP)  TYPE(*CHAR) LEN(10) +
                          VALUE('*DIAG')
             DCL        VAR(&ERRNBRTYP)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRPGMMSGQ) TYPE(*CHAR) LEN(10) +
                          VALUE('*')
             DCL        VAR(&ERRSTKCTR)  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000001')
             DCL        VAR(&ERRCODE  )  TYPE(*CHAR) LEN(4) +
                          VALUE(X'00000000')

/* Sende alle Fehler zur Error Handling Routine */
             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

             CHGVAR     VAR(&ERROR    ) VALUE('0')

 /* -------------------------------------------------------------- */
 /*  Los geht's                                                    */
 /* -------------------------------------------------------------- */

             CHGVAR     VAR(&LANGUAGE) VALUE(&LANG4)
             RTVOBJD    OBJ(*LIBL/PEEK) OBJTYPE(*CMD) RTNLIB(&PRODLIB)
             CHGVAR     VAR(&PROGRAM) VALUE('PEEK05')

             CALL       PGM(&PRODLIB/PEEK00) PARM(      +
                                             &QFILE     +
                                             &MEMBER    +
                                             &ACCESS    +
                                             &LANGUAGE  +
                                             &PRODLIB   +
                                             &PROGRAM   +
                                             &CHGLIB    +
                                             &CHGFILE   +
                                             &CHGMBR    +
                                             &UPDMOD    +
                                             &CHGSQLW   +
                                             &CHGSQLO   +
                                             &QENVFILE  +
                                             &ENVMBR    +
                                             &ENVSAVE   +
                                             &ENVLAYOUT +
                                             &SETTINGS  +
                                             &WHERE     +
                                             &ORDERBY   +
                                             )

/* Verschiebe alle *INFO Nachrichten zur             */
/* vorangegangenen Programmwarteschlange             */
             CHGVAR     VAR(&ERRMSGTYP) VALUE('*INFO')
             CHGVAR     VAR(&ERRSTKCTR) VALUE(X'00000002')
             CALL       PGM(QMHMOVPM) PARM(&ERRMSGKEY &ERRMSGTYP +
                          &ERRNBRTYP &ERRPGMMSGQ &ERRSTKCTR &ERRCODE)

 ENDE:
             RCLRSC     LVL(*)
             MONMSG     MSGID(CPF0000)

             RCLACTGRP  ACTGRP(PEEK) OPTION(*NORMAL)
             MONMSG     MSGID(CPF0000)

             RCLACTGRP  ACTGRP(PEEKUPD) OPTION(*NORMAL)
             MONMSG     MSGID(CPF0000)

             IF         COND(&ERROR) THEN(DO)
                /* Sende letzte *ESCAPE nochmals   */
                CALL       PGM(QMHRSNEM) PARM(&ERRMSGKEY &ERRCODE)
             ENDDO

             RETURN

/* ---------------- */
/* Error            */
/* Handling         */
/* ---------------- */
 ERROR:
             IF         COND(&ERROR) THEN(GOTO CMDLBL(ENDE))
             ELSE       CHGVAR     VAR(&ERROR) VALUE('1')

/* Verschiebe alle *DIAG Nachrichten zur             */
/* vorangegangenen Programmwarteschlange             */
             CHGVAR     VAR(&ERRMSGTYP) VALUE('*DIAG')
             CALL       PGM(QMHMOVPM) PARM(&ERRMSGKEY &ERRMSGTYP +
                          &ERRNBRTYP &ERRPGMMSGQ &ERRSTKCTR &ERRCODE)

             GOTO       CMDLBL(ENDE)

             ENDPGM

